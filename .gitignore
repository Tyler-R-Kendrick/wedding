.secrets/
# Next.js / app data / test artifacts
.next/
.data/
coverage/
*.tsbuildinfo
next-env.d.ts

# Design-review reports and their screenshots are working notes for the change in hand, not source:
# they are regenerable, they go stale with the next commit, and they had grown to 50 MB of the tree.
.impeccable/critique/
.vercel
.env*

# The design pipeline's stages, assembled into the app by `npm run stages:assemble` (src/lib/stage-hosting.ts)
public/_stages/
