 "body": "<div hidden=\"\"><!--$--><!--/$--></div><p id=\"design-announcer\" class=\"sr-only\" aria-live=\"polite\" aria-atomic=\"true\"></p><div class=\"site cv\" data-theme=\"conservatory\" data-floating-menu=\"\" data-lifecycle=\"TEASER\" data-bl-s=\"\"><a class=\"skip-link\" href=\"#main\" data-bl-s=\"\" data-bl-dark=\"\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><div class=\"cv-sheet\"><header class=\"cv-header\" data-bl-k=\"header\" data-bl-label=\"Menu\"><nav class=\"cv-rail\" aria-label=\"Site\" data-bl-k=\"nav\" data-bl-label=\"Site\"><a class=\"cv-rail__home\" href=\"/\"><span class=\"cv-rail__names\"><span data-bl-t=\"label\">Sara + Tyler</span></span><span class=\"sr-only\"><span data-bl-t=\"label\">: </span><!-- --><span data-bl-t=\"label\">Home</span></span></a><ul class=\"cv-rail__list\" data-bl-b=\"\"><li><a class=\"cv-tag\" href=\"/our-story\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Our Story</span></span></a></li><li><a class=\"cv-tag\" href=\"/our-adventures\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Our Adventures</span></span></a></li><li><a class=\"cv-tag is-current\" href=\"/explore-caa\" aria-current=\"page\" data-bl-s=\"\" data-bl-dark=\"\"><span><span data-bl-t=\"label\">Explore CAA</span></span></a></li><li><a class=\"cv-tag\" href=\"/ask-us\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Ask Us</span></span></a></li><li><a class=\"cv-tag\" href=\"/photos\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Photos &amp; Video</span></span></a></li><li><a class=\"cv-tag\" href=\"/sign-in\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Sign in</span></span></a></li></ul></nav><div class=\"cv-menu\" data-bl-s=\"\"><button type=\"button\" class=\"cv-tag cv-tag--button\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-controls=\"site-menu\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Menu</span></span></button><dialog id=\"site-menu\" class=\"cv-dialog\" aria-labelledby=\"_R_9hbsnqbtb_\" data-bl-k=\"dialog\" data-bl-label=\"Menu\"><div class=\"cv-dialog__panel\" data-bl-s=\"\"><div class=\"cv-dialog__header\"><h2 id=\"_R_9hbsnqbtb_\" class=\"cv-dialog__title\"><span data-bl-t=\"heading\">Menu</span></h2><button type=\"button\" class=\"cv-btn cv-btn--ghost cv-dialog__close\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">Close</span></button></div><div class=\"cv-dialog__body\"><ul class=\"cv-menu__list\"><li><a class=\"cv-menu__link\" href=\"/\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Home</span></span></a></li><li><a class=\"cv-menu__link\" href=\"/our-story\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Our Story</span></span></a></li><li><a class=\"cv-menu__link\" href=\"/our-adventures\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Our Adventures</span></span></a></li><li><a class=\"cv-menu__link is-current\" href=\"/explore-caa\" aria-current=\"page\" data-bl-s=\"\" data-bl-dark=\"\"><span><span data-bl-t=\"label\">Explore CAA</span></span></a></li><li><a class=\"cv-menu__link\" href=\"/ask-us\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Ask Us</span></span></a></li><li><a class=\"cv-menu__link\" href=\"/photos\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Photos &amp; Video</span></span></a></li><li><a class=\"cv-menu__link\" href=\"/sign-in\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Sign in</span></span></a></li></ul></div></div></dialog></div></header><main id=\"main\" class=\"cv-main\" tabindex=\"-1\" data-bl-k=\"main\" data-bl-label=\"Chicago Athletic Association Hotel\"><header class=\"cv-pagehead\" data-bl-k=\"header\" data-bl-label=\"Chicago Athletic Association Hotel\"><p class=\"cv-pagehead__tag\"><span class=\"cv-specimen cv-specimen--static\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"copy\">Explore CAA</span></span></p><h1 class=\"cv-h cv-h--1 cv-pagehead__title\"><span data-bl-t=\"heading\">Chicago Athletic Association Hotel</span></h1><p class=\"cv-lede\"><span data-bl-t=\"copy\">Built in 1893 for the private Chicago Athletic Association.</span></p></header><section id=\"history\" class=\"cv-section cv-section--default\" aria-labelledby=\"history-title\" data-bl-k=\"section\" data-bl-label=\"The building\"><hr class=\"cv-fern\" data-bl-s=\"\"><div class=\"cv-section__grid\"><div class=\"cv-section__text\"><div class=\"cv-section__head\"><h2 id=\"history-title\" class=\"cv-h cv-h--2\"><span data-bl-t=\"heading\">The building</span></h2></div><ol class=\"cv-notes\" aria-label=\"The building, in order\"><li id=\"fact-built-1893\" class=\"cv-notes__item\" data-bl-b=\"\"><span class=\"cv-notes__cat\"><span data-bl-t=\"copy\">History</span></span><span class=\"cv-notes__text\"><span data-bl-t=\"copy\">Built in 1893 for the private Chicago Athletic Association.</span></span></li><li id=\"fact-architects\" class=\"cv-notes__item\" data-bl-b=\"\"><span class=\"cv-notes__cat\"><span data-bl-t=\"copy\">Architecture</span></span><span class=\"cv-notes__text\"><span data-bl-t=\"copy\">Designed by Henry Ives Cobb, with a facade by Louis Christian Mullgardt.</span></span></li><li id=\"fact-venetian-gothic\" class=\"cv-notes__item\" data-bl-b=\"\"><span class=\"cv-notes__cat\"><span data-bl-t=\"copy\">Architecture</span></span><span class=\"cv-notes__text\"><span data-bl-t=\"copy\">Venetian Gothic, after the Doge’s Palace in Venice.</span></span></li><li id=\"fact-opened-1893\" class=\"cv-notes__item\" data-bl-b=\"\"><span class=\"cv-notes__cat\"><span data-bl-t=\"copy\">History</span></span><span class=\"cv-notes__text\"><span data-bl-t=\"copy\">It opened amid the 1893 World’s Columbian Exposition.</span></span></li><li id=\"fact-men-only-until-1972\" class=\"cv-notes__item\" data-bl-b=\"\"><span class=\"cv-notes__cat\"><span data-bl-t=\"copy\">History</span></span><span class=\"cv-notes__text\"><span data-bl-t=\"copy\">A men-only club until 1972.</span></span></li><li id=\"fact-club-closed-2007\" class=\"cv-notes__item\" data-bl-b=\"\"><span class=\"cv-notes__cat\"><span data-bl-t=\"copy\">History</span></span><span class=\"cv-notes__text\"><span data-bl-t=\"copy\">The club closed in 2007.</span></span></li><li id=\"fact-restoration\" class=\"cv-notes__item\" data-bl-b=\"\"><span class=\"cv-notes__cat\"><span data-bl-t=\"copy\">Restoration</span></span><span class=\"cv-notes__text\"><span data-bl-t=\"copy\">Restored and reopened as a hotel: architecture by Hartshorne Plunkard Architecture, interiors by Roman &amp; Williams.</span></span></li><li id=\"fact-materials\" class=\"cv-notes__item\" data-bl-b=\"\"><span class=\"cv-notes__cat\"><span data-bl-t=\"copy\">Materials</span></span><span class=\"cv-notes__text\"><span data-bl-t=\"copy\">Patterned brick, carved limestone, arched windows, custom stained glass, ornate plaster, and mosaic and marble floors.</span></span></li><li id=\"fact-views\" class=\"cv-notes__item\" data-bl-b=\"\"><span class=\"cv-notes__cat\"><span data-bl-t=\"copy\">Setting</span></span><span class=\"cv-notes__text\"><span data-bl-t=\"copy\">Views over Millennium Park and Lake Michigan.</span></span></li><li id=\"fact-historic-district\" class=\"cv-notes__item\" data-bl-b=\"\"><span class=\"cv-notes__cat\"><span data-bl-t=\"copy\">History</span></span><span class=\"cv-notes__text\"><span data-bl-t=\"copy\">A contributing building in the Historic Michigan Boulevard District.</span><span class=\"cv-notes__note\"> <!-- --><span data-bl-t=\"copy\">The designation date is reported inconsistently and is deliberately not published.</span></span></span></li></ol><div class=\"cv-prov\"><p class=\"prov\"><span class=\"prov__source\"><span class=\"prov__badge prov__badge--muted\" data-bl-b=\"\"><span data-bl-t=\"copy\">From Sara + Tyler</span></span> <span><span data-bl-t=\"copy\">Tyler's brief 2026-09-04</span></span></span></p></div></div></div></section><section id=\"spaces\" class=\"cv-section cv-section--alt\" aria-labelledby=\"spaces-title\" data-bl-s=\"\" data-bl-k=\"section\" data-bl-label=\"The spaces\"><hr class=\"cv-fern\" data-bl-s=\"\"><div class=\"cv-section__grid\"><div class=\"cv-section__text\"><div class=\"cv-section__head\"><h2 id=\"spaces-title\" class=\"cv-h cv-h--2\"><span data-bl-t=\"heading\">The spaces</span></h2></div><div class=\"cv-prose\"><p><span data-bl-t=\"copy\">The spaces below are the rooms the venue offers for weddings.</span></p><div class=\"placeholder\" data-placeholder=\"true\" role=\"note\" data-bl-s=\"\" data-bl-b=\"\"><span class=\"placeholder__label\"><span data-bl-t=\"copy\">Sara + Tyler are still writing this:</span></span> <p class=\"placeholder__hint\"><span data-bl-t=\"copy\">which room hosts the ceremony, the cocktail hour, and the reception is not confirmed.</span></p></div></div></div><div class=\"cv-section__full\"><ul class=\"cv-mount cv-mount--rooms\" aria-label=\"Event spaces\"><li class=\"cv-mount__item\"><article class=\"cv-card cv-pressed cv-room\" data-space=\"white-city-ballroom\" data-flower=\"a\" style=\"--i:0\" data-bl-s=\"\" data-bl-k=\"article\" data-bl-label=\"White City Ballroom\"><span class=\"cv-specimen\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"copy\">Up to 300</span></span><h3 class=\"cv-card__title\"><a class=\"cv-link\" href=\"/explore-caa/example\"><span data-bl-t=\"heading\">White City Ballroom</span></a></h3><div class=\"cv-card__body\"><p><span data-bl-t=\"copy\">Floor-to-ceiling windows, vintage stained glass, an original Carrara marble floor, three 19th-century fireplaces, and 167 restored illuminated ceiling embellishments.</span></p><p class=\"cv-muted\"><span data-bl-t=\"copy\">These are the venue’s own kit figures; Sara and Tyler have not confirmed them with the planner yet.</span></p></div></article></li><li class=\"cv-mount__item\"><article class=\"cv-card cv-pressed cv-room\" data-space=\"madison-ballroom\" data-flower=\"b\" style=\"--i:1\" data-bl-s=\"\" data-bl-k=\"article\" data-bl-label=\"Madison Ballroom\"><span class=\"cv-specimen\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"copy\">Up to 250</span></span><h3 class=\"cv-card__title\"><a class=\"cv-link\" href=\"/explore-caa/example\"><span data-bl-t=\"heading\">Madison Ballroom</span></a></h3><div class=\"cv-card__body\"><p><span data-bl-t=\"copy\">Original walnut parquet, historic crystal chandeliers, millwork, stained glass, and city views.</span></p><p class=\"cv-muted\"><span data-bl-t=\"copy\">These are the venue’s own kit figures; Sara and Tyler have not confirmed them with the planner yet.</span></p></div></article></li><li class=\"cv-mount__item\"><article class=\"cv-card cv-pressed cv-room\" data-space=\"stagg-court\" data-flower=\"c\" style=\"--i:2\" data-bl-s=\"\" data-bl-k=\"article\" data-bl-label=\"Stagg Court\"><span class=\"cv-specimen\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"copy\">Up to 350</span></span><h3 class=\"cv-card__title\"><a class=\"cv-link\" href=\"/explore-caa/example\"><span data-bl-t=\"heading\">Stagg Court</span></a></h3><div class=\"cv-card__body\"><p><span data-bl-t=\"copy\">The club’s original basketball court and gymnasium: original flooring, hoops, and an elevated running track.</span></p><p class=\"cv-muted\"><span data-bl-t=\"copy\">These are the venue’s own kit figures; Sara and Tyler have not confirmed them with the planner yet.</span></p></div></article></li><li class=\"cv-mount__item\"><article class=\"cv-card cv-pressed cv-room\" data-space=\"the-tank\" data-flower=\"a\" style=\"--i:3\" data-bl-s=\"\" data-bl-k=\"article\" data-bl-label=\"The Tank\"><span class=\"cv-specimen\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"copy\">Up to 225</span></span><h3 class=\"cv-card__title\"><a class=\"cv-link\" href=\"/explore-caa/example\"><span data-bl-t=\"heading\">The Tank</span></a></h3><div class=\"cv-card__body\"><p><span data-bl-t=\"copy\">The club’s former swimming pool: original pool tile and marble pillars.</span></p><p class=\"cv-muted\"><span data-bl-t=\"copy\">These are the venue’s own kit figures; Sara and Tyler have not confirmed them with the planner yet.</span></p></div></article></li></ul></div></div></section><section id=\"look-for-this\" class=\"cv-section cv-section--default\" aria-labelledby=\"look-title\" data-bl-k=\"section\" data-bl-label=\"Look for this\"><hr class=\"cv-fern\" data-bl-s=\"\"><div class=\"cv-section__grid\"><div class=\"cv-section__text\"><div class=\"cv-section__head\"><h2 id=\"look-title\" class=\"cv-h cv-h--2\"><span data-bl-t=\"heading\">Look for this</span></h2><p class=\"cv-lede\"><span data-bl-t=\"copy\">A self-guided list for the hour before things start. The rooms have their own lists on their pages.</span></p></div></div><div class=\"cv-section__mount cv-section__mount--flat\"><ol class=\"cv-lookfor\" aria-label=\"Look for this\"><li class=\"cv-lookfor__item\" data-bl-b=\"\"><svg class=\"cv-leaf cv-lookfor__leaf\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M4 20C4 10 10 4 20 4c0 10-6 16-16 16z\" fill=\"var(--color-leaf)\" stroke=\"var(--color-leaf-deep)\" stroke-width=\"1.25\" stroke-linejoin=\"round\"></path><path d=\"M4 20 20 4\" fill=\"none\" stroke=\"var(--color-leaf-deep)\" stroke-width=\"1.25\" stroke-linecap=\"round\"></path></svg><span class=\"cv-lookfor__text\"><span data-bl-t=\"copy\">Patterned brick on the exterior.</span></span></li><li class=\"cv-lookfor__item\" data-bl-b=\"\"><svg class=\"cv-leaf cv-lookfor__leaf\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M4 20C4 10 10 4 20 4c0 10-6 16-16 16z\" fill=\"var(--color-leaf)\" stroke=\"var(--color-leaf-deep)\" stroke-width=\"1.25\" stroke-linejoin=\"round\"></path><path d=\"M4 20 20 4\" fill=\"none\" stroke=\"var(--color-leaf-deep)\" stroke-width=\"1.25\" stroke-linecap=\"round\"></path></svg><span class=\"cv-lookfor__text\"><span data-bl-t=\"copy\">Carved limestone.</span></span></li><li class=\"cv-lookfor__item\" data-bl-b=\"\"><svg class=\"cv-leaf cv-lookfor__leaf\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M4 20C4 10 10 4 20 4c0 10-6 16-16 16z\" fill=\"var(--color-leaf)\" stroke=\"var(--color-leaf-deep)\" stroke-width=\"1.25\" stroke-linejoin=\"round\"></path><path d=\"M4 20 20 4\" fill=\"none\" stroke=\"var(--color-leaf-deep)\" stroke-width=\"1.25\" stroke-linecap=\"round\"></path></svg><span class=\"cv-lookfor__text\"><span data-bl-t=\"copy\">Arched windows, the Venetian Gothic tell.</span></span></li><li class=\"cv-lookfor__item\" data-bl-b=\"\"><svg class=\"cv-leaf cv-lookfor__leaf\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M4 20C4 10 10 4 20 4c0 10-6 16-16 16z\" fill=\"var(--color-leaf)\" stroke=\"var(--color-leaf-deep)\" stroke-width=\"1.25\" stroke-linejoin=\"round\"></path><path d=\"M4 20 20 4\" fill=\"none\" stroke=\"var(--color-leaf-deep)\" stroke-width=\"1.25\" stroke-linecap=\"round\"></path></svg><span class=\"cv-lookfor__text\"><span data-bl-t=\"copy\">Custom stained glass.</span></span></li><li class=\"cv-lookfor__item\" data-bl-b=\"\"><svg class=\"cv-leaf cv-lookfor__leaf\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M4 20C4 10 10 4 20 4c0 10-6 16-16 16z\" fill=\"var(--color-leaf)\" stroke=\"var(--color-leaf-deep)\" stroke-width=\"1.25\" stroke-linejoin=\"round\"></path><path d=\"M4 20 20 4\" fill=\"none\" stroke=\"var(--color-leaf-deep)\" stroke-width=\"1.25\" stroke-linecap=\"round\"></path></svg><span class=\"cv-lookfor__text\"><span data-bl-t=\"copy\">Ornate plaster ceilings and cornices.</span></span></li><li class=\"cv-lookfor__item\"><svg class=\"cv-leaf cv-lookfor__leaf\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M4 20C4 10 10 4 20 4c0 10-6 16-16 16z\" fill=\"var(--color-leaf)\" strok