 "body": "<div hidden=\"\"><!--$--><!--/$--></div><p id=\"design-announcer\" class=\"sr-only\" aria-live=\"polite\" aria-atomic=\"true\"></p><div class=\"site gh\" data-theme=\"gilded-hour\" data-bottom-bar=\"\" data-lifecycle=\"TEASER\" data-bl-s=\"\" data-bl-b=\"\"><a class=\"skip-link\" href=\"#main\" data-bl-s=\"\" data-bl-dark=\"\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><header class=\"gh-header\" data-bl-b=\"\" data-bl-k=\"header\" data-bl-label=\"Menu\"><nav class=\"gh-frieze\" aria-label=\"Site\" data-bl-k=\"nav\" data-bl-label=\"Site\"><ul class=\"gh-frieze__side gh-frieze__side--left\"><li><a class=\"gh-nav__link\" href=\"/our-story\"><span><span data-bl-t=\"label\">Our Story</span></span></a></li><li><a class=\"gh-nav__link\" href=\"/our-adventures\"><span><span data-bl-t=\"label\">Our Adventures</span></span></a></li><li><a class=\"gh-nav__link\" href=\"/explore-caa\" aria-current=\"page\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Explore CAA</span></span></a></li></ul><a class=\"gh-plaque-link\" href=\"/\"><span class=\"gh-plaque gh-plaque--mono\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">S+T</span></span><span class=\"sr-only\"><span data-bl-t=\"label\">Sara + Tyler</span><!-- --><span data-bl-t=\"label\">: </span><!-- --><span data-bl-t=\"label\">Home</span></span></a><ul class=\"gh-frieze__side gh-frieze__side--right\"><li><a class=\"gh-nav__link\" href=\"/ask-us\"><span><span data-bl-t=\"label\">Ask Us</span></span></a></li><li><a class=\"gh-nav__link\" href=\"/photos\"><span><span data-bl-t=\"label\">Photos &amp; Video</span></span></a></li><li><a class=\"gh-nav__link\" href=\"/sign-in\"><span><span data-bl-t=\"label\">Sign in</span></span></a></li></ul><div class=\"gh-frieze__menu\"><button type=\"button\" class=\"gh-nav__menu\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-controls=\"site-menu\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg><span><span data-bl-t=\"label\">Menu</span></span></button><dialog id=\"site-menu\" class=\"gh-dialog\" aria-labelledby=\"_R_8lbsnqbtb_\" data-bl-k=\"dialog\" data-bl-label=\"Menu\"><div class=\"gh-dialog__panel\" data-bl-s=\"\"><div class=\"gh-dialog__header\" data-bl-b=\"\"><h2 id=\"_R_8lbsnqbtb_\" class=\"gh-dialog__title\"><span data-bl-t=\"heading\">Menu</span></h2><button type=\"button\" class=\"gh-btn gh-btn--ghost gh-dialog__close\" data-bl-s=\"\"><span data-bl-t=\"label\">Close</span></button></div><div class=\"gh-dialog__body\"><ul class=\"gh-menu\"><li><a class=\"gh-menu__link\" href=\"/\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Home</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/our-story\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Our Story</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/our-adventures\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Our Adventures</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/explore-caa\" aria-current=\"page\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Explore CAA</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/ask-us\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Ask Us</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/photos\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Photos &amp; Video</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/sign-in\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Sign in</span></span></a></li></ul></div></div></dialog></div></nav></header><main id=\"main\" class=\"gh-main\" tabindex=\"-1\" data-bl-k=\"main\" data-bl-label=\"Chicago Athletic Association Hotel\"><header class=\"gh-pagehead\" data-bl-k=\"header\" data-bl-label=\"Chicago Athletic Association Hotel\"><div class=\"gh-pagehead__inner\"><p class=\"gh-eyebrow\"><span data-bl-t=\"copy\">Explore CAA</span></p><hr class=\"gh-divider\" data-bl-s=\"\"><h1 class=\"gh-h gh-h--1 gh-pagehead__title\"><span data-bl-t=\"heading\">Chicago Athletic Association Hotel</span></h1><p class=\"gh-lede gh-pagehead__lede\"><span data-bl-t=\"copy\">Built in 1893 for the private Chicago Athletic Association.</span></p></div></header><section id=\"history\" class=\"gh-section gh-section--default\" aria-labelledby=\"history-title\" data-number=\"1\" data-bl-k=\"section\" data-bl-label=\"The building\"><div class=\"gh-section__inner\"><span class=\"gh-plaque gh-plaque--act\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">01</span></span><span class=\"sr-only\"><span data-bl-t=\"copy\">Part </span><!-- --><span data-bl-t=\"copy\">1</span><!-- --><span data-bl-t=\"copy\">.</span></span><div class=\"gh-section__head\"><hr class=\"gh-divider\" data-bl-s=\"\"><h2 id=\"history-title\" class=\"gh-h gh-h--2\"><span data-bl-t=\"heading\">The building</span></h2></div><ol class=\"gh-facts\" aria-label=\"The building, in order\"><li id=\"fact-built-1893\" class=\"gh-facts__item\" data-bl-b=\"\"><span class=\"gh-facts__num\" aria-hidden=\"true\"><span data-bl-t=\"label\">01</span></span><span class=\"gh-facts__text\"><span data-bl-t=\"copy\">Built in 1893 for the private Chicago Athletic Association.</span></span></li><li id=\"fact-architects\" class=\"gh-facts__item\" data-bl-b=\"\"><span class=\"gh-facts__num\" aria-hidden=\"true\"><span data-bl-t=\"label\">02</span></span><span class=\"gh-facts__text\"><span data-bl-t=\"copy\">Designed by Henry Ives Cobb, with a facade by Louis Christian Mullgardt.</span></span></li><li id=\"fact-venetian-gothic\" class=\"gh-facts__item\" data-bl-b=\"\"><span class=\"gh-facts__num\" aria-hidden=\"true\"><span data-bl-t=\"label\">03</span></span><span class=\"gh-facts__text\"><span data-bl-t=\"copy\">Venetian Gothic, after the Doge’s Palace in Venice.</span></span></li><li id=\"fact-opened-1893\" class=\"gh-facts__item\" data-bl-b=\"\"><span class=\"gh-facts__num\" aria-hidden=\"true\"><span data-bl-t=\"label\">04</span></span><span class=\"gh-facts__text\"><span data-bl-t=\"copy\">It opened amid the 1893 World’s Columbian Exposition.</span></span></li><li id=\"fact-men-only-until-1972\" class=\"gh-facts__item\" data-bl-b=\"\"><span class=\"gh-facts__num\" aria-hidden=\"true\"><span data-bl-t=\"label\">05</span></span><span class=\"gh-facts__text\"><span data-bl-t=\"copy\">A men-only club until 1972.</span></span></li><li id=\"fact-club-closed-2007\" class=\"gh-facts__item\" data-bl-b=\"\"><span class=\"gh-facts__num\" aria-hidden=\"true\"><span data-bl-t=\"label\">06</span></span><span class=\"gh-facts__text\"><span data-bl-t=\"copy\">The club closed in 2007.</span></span></li><li id=\"fact-restoration\" class=\"gh-facts__item\" data-bl-b=\"\"><span class=\"gh-facts__num\" aria-hidden=\"true\"><span data-bl-t=\"label\">07</span></span><span class=\"gh-facts__text\"><span data-bl-t=\"copy\">Restored and reopened as a hotel: architecture by Hartshorne Plunkard Architecture, interiors by Roman &amp; Williams.</span></span></li><li id=\"fact-materials\" class=\"gh-facts__item\" data-bl-b=\"\"><span class=\"gh-facts__num\" aria-hidden=\"true\"><span data-bl-t=\"label\">08</span></span><span class=\"gh-facts__text\"><span data-bl-t=\"copy\">Patterned brick, carved limestone, arched windows, custom stained glass, ornate plaster, and mosaic and marble floors.</span></span></li><li id=\"fact-views\" class=\"gh-facts__item\" data-bl-b=\"\"><span class=\"gh-facts__num\" aria-hidden=\"true\"><span data-bl-t=\"label\">09</span></span><span class=\"gh-facts__text\"><span data-bl-t=\"copy\">Views over Millennium Park and Lake Michigan.</span></span></li><li id=\"fact-historic-district\" class=\"gh-facts__item\" data-bl-b=\"\"><span class=\"gh-facts__num\" aria-hidden=\"true\"><span data-bl-t=\"label\">10</span></span><span class=\"gh-facts__text\"><span data-bl-t=\"copy\">A contributing building in the Historic Michigan Boulevard District.</span><span class=\"gh-facts__note\"> <!-- --><span data-bl-t=\"copy\">The designation date is reported inconsistently and is deliberately not published.</span></span></span></li></ol><div class=\"gh-prov\"><p class=\"prov\"><span class=\"prov__source\"><span class=\"prov__badge prov__badge--muted\" data-bl-b=\"\"><span data-bl-t=\"copy\">From Sara + Tyler</span></span> <span><span data-bl-t=\"copy\">Tyler's brief 2026-09-04</span></span></span></p></div></div></section><section id=\"spaces\" class=\"gh-section gh-section--alt\" aria-labelledby=\"spaces-title\" data-number=\"2\" data-bl-s=\"\" data-bl-k=\"section\" data-bl-label=\"The spaces\"><div class=\"gh-section__inner\"><span class=\"gh-plaque gh-plaque--act\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">02</span></span><span class=\"sr-only\"><span data-bl-t=\"copy\">Part </span><!-- --><span data-bl-t=\"copy\">2</span><!-- --><span data-bl-t=\"copy\">.</span></span><div class=\"gh-section__head\"><hr class=\"gh-divider\" data-bl-s=\"\"><h2 id=\"spaces-title\" class=\"gh-h gh-h--2\"><span data-bl-t=\"heading\">The spaces</span></h2></div><div class=\"gh-prose\"><p><span data-bl-t=\"copy\">The spaces below are the rooms the venue offers for weddings.</span></p><div class=\"placeholder\" data-placeholder=\"true\" role=\"note\" data-bl-s=\"\" data-bl-b=\"\"><span class=\"placeholder__label\"><span data-bl-t=\"copy\">Sara + Tyler are still writing this:</span></span> <p class=\"placeholder__hint\"><span data-bl-t=\"copy\">which room hosts the ceremony, the cocktail hour, and the reception is not confirmed.</span></p></div></div><ul class=\"gh-floorplan\" aria-label=\"Event spaces\"><li class=\"gh-floorplan__cell\"><article class=\"gh-room\" data-space=\"white-city-ballroom\" data-bl-s=\"\" data-bl-k=\"article\" data-bl-label=\"White City Ballroom\"><span class=\"gh-room__num\" aria-hidden=\"true\"><span data-bl-t=\"label\">01</span></span><h3 class=\"gh-room__name\"><a class=\"gh-link\" href=\"/explore-caa/example\"><span data-bl-t=\"heading\">White City Ballroom</span></a></h3><p class=\"gh-room__character\"><span data-bl-t=\"copy\">Floor-to-ceiling windows, vintage stained glass, an original Carrara marble floor, three 19th-century fireplaces, and 167 restored illuminated ceiling embellishments.</span></p><p class=\"gh-room__capacity\"><span data-bl-t=\"copy\">Ceremony 220</span><!-- --><span data-bl-t=\"copy\"> · Dinner 220</span><!-- --><span data-bl-t=\"copy\"> · Reception 300</span></p><p class=\"gh-room__note\"><span data-bl-t=\"copy\">These are the venue’s own kit figures; Sara and Tyler have not confirmed them with the planner yet.</span></p></article></li><li class=\"gh-floorplan__cell\"><article class=\"gh-room\" data-space=\"madison-ballroom\" data-bl-s=\"\" data-bl-k=\"article\" data-bl-label=\"Madison Ballroom\"><span class=\"gh-room__num\" aria-hidden=\"true\"><span data-bl-t=\"label\">02</span></span><h3 class=\"gh-room__name\"><a class=\"gh-link\" href=\"/explore-caa/example\"><span data-bl-t=\"heading\">Madison Ballroom</span></a></h3><p class=\"gh-room__character\"><span data-bl-t=\"copy\">Original walnut parquet, historic crystal chandeliers, millwork, stained glass, and city views.</span></p><p class=\"gh-room__capacity\"><span data-bl-t=\"copy\">Ceremony 220</span><!-- --><span data-bl-t=\"copy\"> · Dinner 120</span><!-- --><span data-bl-t=\"copy\"> · Reception 250</span></p><p class=\"gh-room__note\"><span data-bl-t=\"copy\">These are the venue’s own kit figures; Sara and Tyler have not confirmed them with the planner yet.</span></p></article></li><li class=\"gh-floorplan__cell\"><article class=\"gh-room\" data-space=\"stagg-court\" data-bl-s=\"\" data-bl-k=\"article\" data-bl-label=\"Stagg Court\"><span class=\"gh-room__num\" aria-hidden=\"true\"><span data-bl-t=\"label\">03</span></span><h3 class=\"gh-room__name\"><a class=\"gh-link\" href=\"/explore-caa/example\"><span data-bl-t=\"heading\">Stagg Court</span></a></h3><p class=\"gh-room__character\"><span data-bl-t=\"copy\">The club’s original basketball court and gymnasium: original flooring, hoops, and an elevated running track.</span></p><p class=\"gh-room__capacity\"><span data-bl-t=\"copy\">Ceremony 300</span><!-- --><span data-bl-t=\"copy\"> · Dinner 250</span><!-- --><span data-bl-t=\"copy\"> · Reception 350</span></p><p class=\"gh-room__note\"><span data-bl-t=\"copy\">These are the venue’s own kit figures; Sara and Tyler have not confirmed them with the planner yet.</span></p></article></li><li class=\"gh-floorplan__cell\"><article class=\"gh-room\" data-space=\"the-tank\" data-bl-s=\"\" data-bl-k=\"article\" data-bl-label=\"The Tank\"><span class=\"gh-room__num\" aria-hidden=\"true\"><span data-bl-t=\"label\">04</span></span><h3 class=\"gh-room__name\"><a class=\"gh-link\" href=\"/explore-caa/example\"><span data-bl-t=\"heading\">The Tank</span></a></h3><p class=\"gh-room__character\"><span data-bl-t=\"copy\">The club’s former swimming pool: original pool tile and marble pillars.</span></p><p class=\"gh-room__capacity\"><span data-bl-t=\"copy\">Ceremony 175</span><!-- --><span data-bl-t=\"copy\"> · Dinner 130</span><!-- --><span data-bl-t=\"copy\"> · Reception 225</span></p><p class=\"gh-room__note\"><span data-bl-t=\"copy\">These are the venue’s own kit figures; Sara and Tyler have not confirmed them with the planner yet.</span></p></article></li></ul></div></section><section id=\"look-for-this\" class=\"gh-section gh-section--default\" aria-labelledby=\"look-title\" data-number=\"3\" data-bl-k=\"section\" data-bl-label=\"Look for this\"><div class=\"gh-section__inner\"><span class=\"gh-plaque gh-plaque--act\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">03</span></span><span class=\"sr-only\"><span data-bl-t=\"copy\">Part </span><!-- --><span data-bl-t=\"copy\">3</span><!-- --><span data-bl-t=\"copy\">.</span></span><div class=\"gh-section__head\"><hr class=\"gh-divider\" data-bl-s=\"\"><h2 id=\"look-title\" class=\"gh-h gh-h--2\"><span data-bl-t=\"heading\">Look for this</span></h2><p class=\"gh-lede\"><span data-bl-t=\"copy\">A self-guided list for the hour before things start. The rooms have their own lists on their pages.</span></p></div><ol class=\"gh-docent\" aria-label=\"Look for this\"><li class=\"gh-docent__item\"><span class=\"gh-docent__num\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">01</span></span><span class=\"gh-docent__text\"><span data-bl-t=\"copy\">Patterned brick on the exterior.</span></span></li><li class=\"gh-docent__item\"><span class=\"gh-docent__num\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">02</span></span><span class=\"gh-docent__text\"><span data-bl-t=\"copy\">Carved limestone.</span></span></li><li class=\"gh-docent__item\"><span class=\"gh-docent__num\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">03</span></span><span class=\"gh-docent__text\"><span data-bl-t=\"copy\">Arched windows, the Venetian Gothic tell.</span></span></li><li class=\"gh-docent__item\"><span class=\"gh-docent__num\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">04</span></span><span class=\"gh-docent__text\"><span data-bl-t=\"copy\">Custom stained glass.</span></span></li><li class=\"gh-docent__item\"><span class=\"gh-docent__num\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">05</span></span><span class=\"gh-docent__text\"><span data-bl-t=\"copy\">Ornate plaster ceilings and cornices.</span></span></li><li class=\"gh-docent__item\"><span class=\"gh-docent__num\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">06</span></span><span class=\"gh-docent__text\"><span data-bl-t=\"copy\">Mosaic and marble floors.</span></span></li></ol></div></section><section id=\"outlets\" class=\"gh-section gh-section--wash\" aria-labelledby=\"outlets-title\" data-number=\"4\" data-bl-s=\"\" data-bl-k=\"section\" data-bl-label=