 "body": "<div hidden=\"\"><!--$--><!--/$--></div><div class=\"auth-root\" data-theme=\"botanical-deco\" data-bl-s=\"\"><div class=\"bd-authhead\"><img class=\"bd-bloom bd-bloom--auth\" src=\"/media/botanical-deco/botanical/corner-tl-138.webp\" width=\"138\" height=\"278\" alt=\"\" aria-hidden=\"true\" loading=\"lazy\" decoding=\"async\" data-media=\"botanical.corner-tl\" data-bl-m=\"art\"><a class=\"bd-masthead__home\" href=\"/\"><span class=\"bd-monogram\" aria-hidden=\"true\"><span class=\"bd-monogram__s\"><span data-bl-t=\"label\">S</span></span><span class=\"bd-monogram__stem\" data-bl-s=\"\"></span><span class=\"bd-monogram__t\"><span data-bl-t=\"label\">T</span></span></span><span class=\"sr-only\"><span data-bl-t=\"label\">Sara + Tyler: Home</span></span></a></div><main id=\"main\" class=\"auth-shell\" data-bl-k=\"main\" data-bl-label=\"Sign in with your email\"><article class=\"auth-card\" aria-labelledby=\"auth-title\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"article\" data-bl-label=\"Sign in with your email\"><p class=\"auth-eyebrow\"><span data-bl-t=\"copy\">Welcome back</span></p><h1 id=\"auth-title\" class=\"auth-title\"><span data-bl-t=\"heading\">Sign in with your email</span></h1><div class=\"auth-lede\"><p><span data-bl-t=\"copy\">Enter the email Sara and Tyler have for you and we’ll send a six-digit code. No password needed.</span></p></div><form enctype=\"multipart/form-data\" method=\"POST\" data-bl-k=\"form\" data-bl-form=\"\"><input type=\"hidden\" name=\"$ACTION_ID_401729141d7f93a8dd003cb0091546b1947b0eec30\"><div class=\"auth-field\"><label for=\"email\" class=\"auth-label\"><span data-bl-t=\"label\">Email address</span></label><p id=\"email-hint\" class=\"auth-hint\"><span data-bl-t=\"copy\">The one your invitation was sent to.</span></p><input id=\"email\" type=\"email\" class=\"auth-input\" autocomplete=\"email\" inputmode=\"email\" required=\"\" maxlength=\"254\" aria-describedby=\"email-hint\" name=\"email\" data-bl-s=\"\" data-bl-b=\"\"></div><div class=\"auth-actions\"><button type=\"submit\" class=\"auth-button auth-button-primary\" data-bl-s=\"\" data-bl-dark=\"\"><span data-bl-t=\"label\">Send me a code</span></button></div></form><p class=\"auth-hint\"><span data-bl-t=\"copy\">If you receive nothing within a minute, check spam — or open your invitation link again to start fresh.</span></p><section class=\"auth-other\" aria-labelledby=\"auth-other-heading\" data-bl-b=\"\" data-bl-k=\"section\" data-bl-label=\"Other ways to sign in\"><h2 id=\"auth-other-heading\" class=\"auth-other__heading\"><span data-bl-t=\"heading\">Other ways to sign in</span></h2><p class=\"auth-hint\"><span data-bl-t=\"copy\">Texting works better for you?</span><!-- --> <a class=\"auth-link\" href=\"/sign-in/phone\"><span data-bl-t=\"copy\">Sign in with your phone instead</span></a></p><ul class=\"auth-other__list\"></ul></section><p class=\"auth-hint\"><span data-bl-t=\"copy\">Sara or Tyler?</span><!-- --> <a class=\"auth-link\" href=\"/sign-in/admin\"><span data-bl-t=\"copy\">Sign in to manage the site</span></a></p></article></main><!--$--><!--/$--></div>"
