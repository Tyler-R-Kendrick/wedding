ata-bl-b=\"\"></div><div><label class=\"block\" for=\"_R_fiatpesnfknelb_-name\"><span data-bl-t=\"label\">Name</span></label><input id=\"_R_fiatpesnfknelb_-name\" type=\"text\" required=\"\" class=\"w-full border border-primary/40 bg-neutral px-3 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary\" autocomplete=\"off\" name=\"name\" data-bl-s=\"\" data-bl-b=\"\"></div><div><label class=\"block\" for=\"_R_fiatpesnfknelb_-resySlug\"><span data-bl-t=\"label\">Resy venue slug</span></label><input id=\"_R_fiatpesnfknelb_-resySlug\" type=\"text\" aria-describedby=\"_R_fiatpesnfknelb_-resySlug-help\" class=\"w-full border border-primary/40 bg-neutral px-3 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary\" autocomplete=\"off\" name=\"resySlug\" data-bl-s=\"\" data-bl-b=\"\"><p id=\"_R_fiatpesnfknelb_-resySlug-help\" class=\"mt-1 hint\"><span data-bl-t=\"copy\">resy.com/cities/chi/&lt;slug&gt;</span></p></div><div><label class=\"block\" for=\"_R_fiatpesnfknelb_-openTableId\"><span data-bl-t=\"label\">OpenTable restaurant id</span></label><input id=\"_R_fiatpesnfknelb_-openTableId\" type=\"text\" aria-describedby=\"_R_fiatpesnfknelb_-openTableId-help\" class=\"w-full border border-primary/40 bg-neutral px-3 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary\" autocomplete=\"off\" name=\"openTableId\" data-bl-s=\"\" data-bl-b=\"\"><p id=\"_R_fiatpesnfknelb_-openTableId-help\" class=\"mt-1 hint\"><span data-bl-t=\"copy\">opentable.com/r/&lt;id&gt;</span></p></div><div><label class=\"block\" for=\"_R_fiatpesnfknelb_-url\"><span data-bl-t=\"label\">Booking page URL (https, trusted partner)</span></label><input id=\"_R_fiatpesnfknelb_-url\" type=\"url\" class=\"w-full border border-primary/40 bg-neutral px-3 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary\" autocomplete=\"off\" name=\"url\" data-bl-s=\"\" data-bl-b=\"\"></div><div><label class=\"block\" for=\"_R_fiatpesnfknelb_-note\"><span data-bl-t=\"label\">Note for guests</span></label><input id=\"_R_fiatpesnfknelb_-note\" type=\"text\" class=\"w-full border border-primary/40 bg-neutral px-3 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary\" autocomplete=\"off\" name=\"note\" data-bl-s=\"\" data-bl-b=\"\"></div><div><label class=\"block\" for=\"_R_fiatpesnfknelb_-sortOrder\"><span data-bl-t=\"label\">Order</span></label><input id=\"_R_fiatpesnfknelb_-sortOrder\" type=\"number\" class=\"w-full border border-primary/40 bg-neutral px-3 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary\" autocomplete=\"off\" min=\"0\" max=\"1000\" step=\"1\" name=\"sortOrder\" value=\"0\" data-bl-s=\"\" data-bl-b=\"\"></div><div><label class=\"inline-flex min-h-11 items-center gap-2\" for=\"_R_fiatpesnfknelb_-placeholder\"><input id=\"_R_fiatpesnfknelb_-placeholder\" type=\"checkbox\" class=\"size-5\" name=\"placeholder\"><span data-bl-t=\"label\">Still a placeholder</span></label></div><div><label class=\"inline-flex min-h-11 items-center gap-2\" for=\"_R_fiatpesnfknelb_-active\"><input id=\"_R_fiatpesnfknelb_-active\" type=\"checkbox\" class=\"size-5\" name=\"active\" checked=\"\"><span data-bl-t=\"label\">Active</span></label></div></div><div class=\"mt-5 flex flex-wrap items-center gap-4\"><button type=\"submit\" class=\"inline-flex min-h-11 items-center rounded-[var(--radius-button,2px)] bg-primary px-7 py-3 text-base text-neutral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-60\" data-bl-s=\"\" data-bl-dark=\"\"><span data-bl-t=\"label\">Save</span></button></div></form></section></main><!--$--><!--/$--></div>"
