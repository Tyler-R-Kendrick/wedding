 "body": "<div hidden=\"\"><!--$--><!--/$--></div><p id=\"design-announcer\" class=\"sr-only\" aria-live=\"polite\" aria-atomic=\"true\"></p><div class=\"admin-root\"><a class=\"skip\" href=\"#main\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><nav aria-label=\"Admin\" class=\"con-nav\" data-bl-b=\"\" data-bl-k=\"nav\" data-bl-label=\"Admin\"><ul class=\"list list--plain con-nav__bar\"><li><a href=\"/admin\"><span data-bl-t=\"label\">Admin</span></a></li><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a></li><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit</span></a></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a></li></ul><details><summary><span data-bl-t=\"label\">All admin screens</span></summary><div class=\"con-index\"><section aria-labelledby=\"nav-site\" data-bl-k=\"section\" data-bl-label=\"The site\"><p id=\"nav-site\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The site</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What state guests see, what the calendar suggests, and previewing another state.</span></span></li><li><a href=\"/admin/flags\"><span data-bl-t=\"label\">Feature flags</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Both halves of every gate, and the two legal switches that stay shut.</span></span></li><li><a href=\"/admin/content\"><span data-bl-t=\"label\">Content</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Records with provenance, freshness and verification.</span></span></li><li><a href=\"/admin/events\"><span data-bl-t=\"label\">Events &amp; RSVP window</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Events, meal options, notices, and when RSVP opens.</span></span></li></ul></section><section aria-labelledby=\"nav-guests\" data-bl-k=\"section\" data-bl-label=\"Guests\"><p id=\"nav-guests\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Guests</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/guests\"><span data-bl-t=\"label\">Guests</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">People, households they belong to, identity resets.</span></span></li><li><a href=\"/admin/households\"><span data-bl-t=\"label\">Households</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Household records and mailing addresses.</span></span></li><li><a href=\"/admin/invitations\"><span data-bl-t=\"label\">Invitations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Issue, rotate and revoke invitation links.</span></span></li><li><a href=\"/admin/rsvp\"><span data-bl-t=\"label\">RSVPs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Who has replied, overrides and exports.</span></span></li><li><a href=\"/admin/seating\"><span data-bl-t=\"label\">Seating</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Tables, assignments and publishing the chart.</span></span></li></ul></section><section aria-labelledby=\"nav-weekend\" data-bl-k=\"section\" data-bl-label=\"The weekend\"><p id=\"nav-weekend\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The weekend</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/travel\"><span data-bl-t=\"label\">Travel &amp; stay</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Hotels, links and the room block.</span></span></li><li><a href=\"/admin/transport\"><span data-bl-t=\"label\">Transport</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Benefit entitlements and voucher codes.</span></span></li><li><a href=\"/admin/gifts\"><span data-bl-t=\"label\">Gifts</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Registry and gift links.</span></span></li><li><a href=\"/admin/reservations\"><span data-bl-t=\"label\">Reservations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Venues guests can book through.</span></span></li></ul></section><section aria-labelledby=\"nav-media\" data-bl-k=\"section\" data-bl-label=\"Media &amp; AI\"><p id=\"nav-media\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Media &amp; AI</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/media\"><span data-bl-t=\"label\">Media</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Moderation queue, imports and duplicates.</span></span></li><li><a href=\"/admin/ai\"><span data-bl-t=\"label\">Media AI</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Captions, indexing and what the model may touch.</span></span></li><li><a href=\"/admin/concierge\"><span data-bl-t=\"label\">Concierge</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Answer traces, grounding failures, security alerts.</span></span></li></ul></section><section aria-labelledby=\"nav-operations\" data-bl-k=\"section\" data-bl-label=\"Operations\"><p id=\"nav-operations\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Operations</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit trail</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Every action anyone took, searchable, redacted.</span></span></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Queue depth, failures and retries.</span></span></li><li><a href=\"/admin/metrics\"><span data-bl-t=\"label\">Metrics</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What this deployment recorded, and whether it is recording.</span></span></li><li><a href=\"/admin/providers\"><span data-bl-t=\"label\">Providers</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Which adapter each integration resolved to, and what it can do.</span></span></li></ul></section></div></details></nav><main id=\"main\" class=\"ops\" data-bl-k=\"main\" data-bl-label=\"Feature flags\"><div class=\"con-head\"><div><h1 class=\"ops-title\"><span data-bl-t=\"heading\">Feature flags</span></h1><p class=\"ops-lede\"><span data-bl-t=\"copy\">A feature is on only when every gate in front of it is open. Flags come from the server environment; readiness switches are rows in the database.</span></p></div></div><section id=\"legal\" class=\"ops-section\" aria-labelledby=\"legal-heading\" data-bl-k=\"section\" data-bl-label=\"Legal gates\"><h2 id=\"legal-heading\" class=\"ops-h2\"><span data-bl-t=\"heading\">Legal gates</span></h2><p class=\"con-note\"><span data-bl-t=\"copy\">Two features are held shut by something outside this application: a counsel review and a vendor's written permission. Both gates must be open — the environment flag and the persisted switch — before either feature does anything.</span></p><p class=\"ops-notice\" role=\"note\" data-bl-s=\"\" data-bl-b=\"\"><span class=\"con-pill con-pill--warn\" data-bl-b=\"\"><span data-bl-t=\"copy\">No switch-on here</span></span> <!-- --><span data-bl-t=\"copy\">Readiness switches cannot be turned on from this page, or from anywhere else in the application. PRO_MEDIA_AI_PROCESSING is a legal gate whose precondition is a document this application cannot see — written confirmation from both vendors — and it gets an enable path when backlog C-09 and V-03 close, not before.</span></p><ul class=\"con-gates\"><li class=\"con-gate\" data-bl-b=\"\"><div class=\"con-gate__head\"><h3 class=\"con-gate__name\"><span data-bl-t=\"heading\">PRO_MEDIA_AI_PROCESSING</span></h3><span class=\"con-pill con-pill--neutral\" data-bl-b=\"\"><span data-bl-t=\"copy\">not live</span></span></div><dl class=\"con-kv\"><div><dt><span data-bl-t=\"label\">Environment</span></dt><dd><span class=\"con-pill con-pill--neutral\" data-bl-b=\"\"><span data-bl-t=\"copy\">off</span></span></dd></div><div><dt><span data-bl-t=\"label\">Readiness</span></dt><dd><span class=\"con-pill con-pill--neutral\" data-bl-b=\"\"><span data-bl-t=\"copy\">off</span></span></dd></div><div><dt><span data-bl-t=\"label\">Last changed</span></dt><dd><span data-bl-t=\"copy\">2026-09-24T01:42:25.568Z</span></dd></div></dl><p class=\"con-note\"><strong><span data-bl-t=\"copy\">Blocked by:</span></strong> <!-- --><span data-bl-t=\"copy\">Written confirmation from Brooke Alaina Photography and Oakhouse Visuals that professionally delivered media may be processed by third-party AI.</span><!-- --> <span class=\"con-index__blurb\"><span data-bl-t=\"copy\">(backlog </span><!-- --><span data-bl-t=\"copy\">C-09, V-03</span><!-- --><span data-bl-t=\"copy\">)</span></span></p><form class=\"con-inline-form\" enctype=\"multipart/form-data\" method=\"POST\" data-bl-k=\"form\" data-bl-form=\"\"><input type=\"hidden\" name=\"$ACTION_ID_40622eaa39d6fce36669752c7dfab41b6d6c513c1a\"><input type=\"hidden\" name=\"flag\" value=\"PRO_MEDIA_AI_PROCESSING\"><input type=\"hidden\" name=\"idem\" value=\"01M38J17XXNRGW3MKNX9NYGF6M\"><button type=\"submit\" class=\"ops-button ops-button-danger\" aria-label=\"Switch PRO_MEDIA_AI_PROCESSING readiness off\" data-bl-b=\"\"><span data-bl-t=\"label\">Switch off</span></button></form></li></ul><p class=\"con-note\"><span data-bl-t=\"copy\">Switching off is unconditional and always available, on purpose: closing a legal gate must never be blocked by a missing precondition, and must not depend on holding the entitlement that owns the feature.</span></p></section><section id=\"flags\" class=\"ops-section\" aria-labelledby=\"flags-heading\" data-bl-k=\"section\" data-bl-label=\"Everything else\"><h2 id=\"flags-heading\" class=\"ops-h2\"><span data-bl-t=\"heading\">Everything else</span></h2><p class=\"con-note\"><span data-bl-t=\"copy\">These are read from the server environment at startup (FLAG_&lt;NAME&gt;=on|off). Changing one is a deploy, not a click — there is no control here, and that is not an omission.</span></p><div class=\"ops-table-wrap con-scroll\" tabindex=\"0\" data-bl-b=\"\"><table class=\"ops-table con-table\"><caption class=\"con-caption\" data-bl-b=\"\"><span data-bl-t=\"copy\">Feature flags from the environment</span></caption><thead><tr><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Flag</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Shipped default</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">This environment</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">In effect</span></th></tr></thead><tbody><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">DESIGN_SWITCHER</span></th><td data-bl-b=\"\"><span data-bl-t=\"copy\">off</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">off</span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--neutral\" data-bl-b=\"\"><span data-bl-t=\"copy\">off</span></span></td></tr><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">WEBMCP</span></th><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></span></td></tr><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">AI_CONCIERGE</span></th><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></span></td></tr><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">GUEST_UPLOADS</span></th><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></span></td></tr><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">MEDIA_SEMANTIC_SEARCH</span></th><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></span></td></tr><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">TRAVEL_LIVE_SEARCH</span></th><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></span></td></tr><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">TRANSPORT_BENEFITS</span></th><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></span></td></tr><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">RSVP_ATTENDANCE</span></th><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></span></td></tr><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">RSVP_PLUS_ONES</span></th><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></span></td></tr><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">RSVP_MEALS</span></th><td><span data-bl-t=\"copy\">off</span></td><td><span data-bl-t=\"copy\">on</span><span class=\"con-index__blurb\"><span data-bl-t=\"copy\"> overridden</span></span></td><td><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">on</span></span></td></tr></tbody></table></div></section></main><!--$--><!--/$--></div>"
