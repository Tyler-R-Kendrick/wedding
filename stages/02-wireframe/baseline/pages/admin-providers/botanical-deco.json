 data-bl-b=\"\"><span class=\"con-pill con-pill--neutral\" data-bl-b=\"\"><span data-bl-t=\"copy\">Mock</span></span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">Complete</span></span></td><td class=\"con-wrap ops-code\" data-bl-b=\"\"><span data-bl-t=\"copy\">—</span></td></tr><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">registry</span></th><td data-bl-b=\"\"><span data-bl-t=\"copy\">mock</span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--neutral\" data-bl-b=\"\"><span data-bl-t=\"copy\">Mock</span></span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">Complete</span></span></td><td class=\"con-wrap ops-code\" data-bl-b=\"\"><span data-bl-t=\"copy\">—</span></td></tr><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">cash-fund</span></th><td data-bl-b=\"\"><span data-bl-t=\"copy\">mock</span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--neutral\" data-bl-b=\"\"><span data-bl-t=\"copy\">Mock</span></span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">Complete</span></span></td><td class=\"con-wrap ops-code\" data-bl-b=\"\"><span data-bl-t=\"copy\">—</span></td></tr><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">reservations</span></th><td data-bl-b=\"\"><span data-bl-t=\"copy\">mock</span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--warn\" data-bl-b=\"\"><span data-bl-t=\"copy\">Deep-link</span></span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">Complete</span></span></td><td class=\"con-wrap ops-code\" data-bl-b=\"\"><span data-bl-t=\"copy\">—</span></td></tr><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">maps</span></th><td data-bl-b=\"\"><span data-bl-t=\"copy\">deep-link</span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--warn\" 