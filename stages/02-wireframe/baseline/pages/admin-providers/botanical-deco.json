 "body": "<div hidden=\"\"><!--$--><!--/$--></div><div class=\"admin-root\"><a class=\"skip\" href=\"#main\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><nav aria-label=\"Admin\" class=\"con-nav\" data-bl-b=\"\" data-bl-k=\"nav\" data-bl-label=\"Admin\"><ul class=\"list list--plain con-nav__bar\"><li><a href=\"/admin\"><span data-bl-t=\"label\">Admin</span></a></li><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a></li><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit</span></a></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a></li><li><a href=\"/admin#view-as\"><span data-bl-t=\"label\">View as role</span></a></li><li><a href=\"/admin/guests#inspect-guest\"><span data-bl-t=\"label\">Inspect a guest</span></a></li></ul><details><summary><span data-bl-t=\"label\">All admin screens</span></summary><div class=\"con-index\"><section aria-labelledby=\"nav-site\" data-bl-k=\"section\" data-bl-label=\"The site\"><p id=\"nav-site\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The site</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What state guests see, what the calendar suggests, and previewing another state.</span></span></li><li><a href=\"/admin/flags\"><span data-bl-t=\"label\">Feature flags</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Both halves of every gate, and the two legal switches that stay shut.</span></span></li><li><a href=\"/admin/content\"><span data-bl-t=\"label\">Content</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Records with provenance, freshness and verification.</span></span></li><li><a href=\"/admin/events\"><span data-bl-t=\"label\">Events &amp; RSVP window</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Events, meal options, notices, and when RSVP opens.</span></span></li><li><a href=\"/admin/sitemap\"><span data-bl-t=\"label\">Sitemap</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Every endpoint the app serves, and what each one should answer.</span></span></li></ul></section><section aria-labelledby=\"nav-guests\" data-bl-k=\"section\" data-bl-label=\"Guests\"><p id=\"nav-guests\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Guests</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/guests\"><span data-bl-t=\"label\">Guests</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">People, households they belong to, identity resets.</span></span></li><li><a href=\"/admin/households\"><span data-bl-t=\"label\">Households</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Household records and mailing addresses.</span></span></li><li><a href=\"/admin/invitations\"><span data-bl-t=\"label\">Invitations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Issue, rotate and revoke invitation links.</span></span></li><li><a href=\"/admin/rsvp\"><span data-bl-t=\"label\">RSVPs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Who has replied, overrides and exports.</span></span></li><li><a href=\"/admin/seating\"><span data-bl-t=\"label\">Seating</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Tables, assignments and publishing the chart.</span></span></li></ul></section><section aria-labelledby=\"nav-weekend\" data-bl-k=\"section\" data-bl-label=\"The weekend\"><p id=\"nav-weekend\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The weekend</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/travel\"><span data-bl-t=\"label\">Travel &amp; stay</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Hotels, links and the room block.</span></span></li><li><a href=\"/admin/transport\"><span data-bl-t=\"label\">Transport</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Benefit entitlements and voucher codes.</span></span></li><li><a href=\"/admin/gifts\"><span data-bl-t=\"label\">Gifts</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Registry and gift links.</span></span></li><li><a href=\"/admin/reservations\"><span data-bl-t=\"label\">Reservations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Venues guests can book through.</span></span></li></ul></section><section aria-labelledby=\"nav-media\" data-bl-k=\"section\" data-bl-label=\"Media &amp; AI\"><p id=\"nav-media\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Media &amp; AI</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/media\"><span data-bl-t=\"label\">Media</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Moderation queue, imports and duplicates.</span></span></li><li><a href=\"/admin/ai\"><span data-bl-t=\"label\">Media AI</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Captions, indexing and what the model may touch.</span></span></li><li><a href=\"/admin/concierge\"><span data-bl-t=\"label\">Concierge</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Answer traces, grounding failures, security alerts.</span></span></li></ul></section><section aria-labelledby=\"nav-operations\" data-bl-k=\"section\" data-bl-label=\"Operations\"><p id=\"nav-operations\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Operations</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit trail</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Every action anyone took, searchable, redacted.</span></span></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Queue depth, failures and retries.</span></span></li><li><a href=\"/admin/metrics\"><span data-bl-t=\"label\">Metrics</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What this deployment recorded, and whether it is recording.</span></span></li><li><a href=\"/admin/providers\"><span data-bl-t=\"label\">Providers</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Which adapter each integration resolved to, and what it can do.</span></span></li></ul></section></div></details></nav><main id=\"main\" class=\"ops\" data-bl-k=\"main\" data-bl-label=\"Providers\"><div class=\"con-head\"><div><h1 class=\"ops-title\"><span data-bl-t=\"heading\">Providers</span></h1><p class=\"ops-lede\"><span data-bl-t=\"copy\">Every external system sits behind a typed seam with a mock. Unconfigured always means the mock, never a crash.</span></p></div><div class=\"con-head__actions\"><form method=\"get\" data-bl-k=\"form\" data-bl-form=\"\"><input type=\"hidden\" name=\"probe\" value=\"1\"><button type=\"submit\" class=\"ops-button ops-button-ghost\" data-bl-b=\"\"><span data-bl-t=\"label\">Check health now</span></button></form></div></div><div class=\"con-stats\" data-bl-b=\"\"><div class=\"con-stat\"><span class=\"con-stat__value\"><span data-bl-t=\"copy\">3</span></span><span class=\"con-stat__label\"><span data-bl-t=\"copy\">Live or sandbox</span></span></div><div class=\"con-stat\"><span class=\"con-stat__value\"><span data-bl-t=\"copy\">12</span></span><span class=\"con-stat__label\"><span data-bl-t=\"copy\">Mock</span></span><span class=\"con-stat__hint\"><span data-bl-t=\"copy\">falls back safely</span></span></div><div class=\"con-stat\"><span class=\"con-stat__value\"><span data-bl-t=\"copy\">0</span></span><span class=\"con-stat__label\"><span data-bl-t=\"copy\">Misconfigured</span></span><span class=\"con-stat__hint\"><span data-bl-t=\"copy\">missing variables</span></span></div></div><dl class=\"con-kv\"><div><dt><span data-bl-t=\"label\">Database driver</span></dt><dd><span data-bl-t=\"copy\">pglite</span></dd></div><div><dt><span data-bl-t=\"label\">pgvector</span></dt><dd><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">Available</span></span></dd></div><div><dt><span data-bl-t=\"label\">Health probe</span></dt><dd><span data-bl-t=\"copy\">not run</span></dd></div></dl><section id=\"adapters\" class=\"ops-section\" aria-labelledby=\"adapters-heading\" data-bl-k=\"section\" data-bl-label=\"Adapters\"><h2 id=\"adapters-heading\" class=\"ops-h2\"><span data-bl-t=\"heading\">Adapters</span></h2><p class=\"con-note\"><span data-bl-t=\"copy\">A live adapter needs its variables set in the server environment. Only their names appear here — this page never reads a value, and there is no control on it that could.</span></p><div class=\"ops-table-wrap con-scroll\" tabindex=\"0\" data-bl-b=\"\"><table class=\"ops-table con-table\"><caption class=\"con-caption\" data-bl-b=\"\"><span data-bl-t=\"copy\">Provider adapters and their configuration</span></caption><thead><tr><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Kind</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Adapter</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Mode</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Config</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Missing variables</span></th></tr></thead><tbody><tr><th scope=\"row\" data-bl-b=\"\"><span data-bl-t=\"label\">auth-email</span></th><td data-bl-b=\"\"><span data-bl-t=\"copy\">mock</span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--neutral\" data-bl-b=\"\"><span data-bl-t=\"copy\">Mock</span></span></td><td data-bl-b=\"\"><span class=\"con-pill con-pill--good\" data-bl-b=\"\"><span data-bl-t=\"copy\">Complete</span></span></td><td class=\"con-wrap ops-code\" data-bl-b=\"\"><span data-bl-t=\"copy\">—</span></td></tr><tr><th scope=\"row\" data-bl-