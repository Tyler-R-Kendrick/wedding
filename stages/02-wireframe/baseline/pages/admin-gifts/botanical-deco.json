 "body": "<div hidden=\"\"><!--$--><!--/$--></div><p id=\"design-announcer\" class=\"sr-only\" aria-live=\"polite\" aria-atomic=\"true\"></p><div class=\"admin-root\"><a class=\"skip\" href=\"#main\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><nav aria-label=\"Admin\" class=\"con-nav\" data-bl-b=\"\" data-bl-k=\"nav\" data-bl-label=\"Admin\"><ul class=\"list list--plain con-nav__bar\"><li><a href=\"/admin\"><span data-bl-t=\"label\">Admin</span></a></li><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a></li><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit</span></a></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a></li></ul><details><summary><span data-bl-t=\"label\">All admin screens</span></summary><div class=\"con-index\"><section aria-labelledby=\"nav-site\" data-bl-k=\"section\" data-bl-label=\"The site\"><p id=\"nav-site\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The site</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What state guests see, what the calendar suggests, and previewing another state.</span></span></li><li><a href=\"/admin/flags\"><span data-bl-t=\"label\">Feature flags</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Both halves of every gate, and the two legal switches that stay shut.</span></span></li><li><a href=\"/admin/content\"><span data-bl-t=\"label\">Content</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Records with provenance, freshness and verification.</span></span></li><li><a href=\"/admin/events\"><span data-bl-t=\"label\">Events &amp; RSVP window</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Events, meal options, notices, and when RSVP opens.</span></span></li></ul></section><section aria-labelledby=\"nav-guests\" data-bl-k=\"section\" data-bl-label=\"Guests\"><p id=\"nav-guests\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Guests</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/guests\"><span data-bl-t=\"label\">Guests</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">People, households they belong to, identity resets.</span></span></li><li><a href=\"/admin/households\"><span data-bl-t=\"label\">Households</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Household records and mailing addresses.</span></span></li><li><a href=\"/admin/invitations\"><span data-bl-t=\"label\">Invitations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Issue, rotate and revoke invitation links.</span></span></li><li><a href=\"/admin/rsvp\"><span data-bl-t=\"label\">RSVPs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Who has replied, overrides and exports.</span></span></li><li><a href=\"/admin/seating\"><span data-bl-t=\"label\">Seating</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Tables, assignments and publishing the chart.</span></span></li></ul></section><section aria-labelledby=\"nav-weekend\" data-bl-k=\"section\" data-bl-label=\"The weekend\"><p id=\"nav-weekend\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The weekend</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/travel\"><span data-bl-t=\"label\">Travel &amp; stay</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Hotels, links and the room block.</span></span></li><li><a href=\"/admin/transport\"><span data-bl-t=\"label\">Transport</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Benefit entitlements and voucher codes.</span></span></li><li><a href=\"/admin/gifts\"><span data-bl-t=\"label\">Gifts</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Registry and gift links.</span></span></li><li><a href=\"/admin/reservations\"><span data-bl-t=\"label\">Reservations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Venues guests can book through.</span></span></li></ul></section><section aria-labelledby=\"nav-media\" data-bl-k=\"section\" data-bl-label=\"Media &amp; AI\"><p id=\"nav-media\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Media &amp; AI</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/media\"><span data-bl-t=\"label\">Media</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Moderation queue, imports and duplicates.</span></span></li><li><a href=\"/admin/ai\"><span data-bl-t=\"label\">Media AI</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Captions, indexing and what the model may touch.</span></span></li><li><a href=\"/admin/concierge\"><span data-bl-t=\"label\">Concierge</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Answer traces, grounding failures, security alerts.</span></span></li></ul></section><section aria-labelledby=\"nav-operations\" data-bl-k=\"section\" data-bl-label=\"Operations\"><p id=\"nav-operations\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Operations</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit trail</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Every action anyone took, searchable, redacted.</span></span></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Queue depth, failures and retries.</span></span></li><li><a href=\"/admin/metrics\"><span data-bl-t=\"label\">Metrics</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What this deployment recorded, and whether it is recording.</span></span></li><li><a href=\"/admin/providers\"><span data-bl-t=\"label\">Providers</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Which adapter each integration resolved to, and what it can do.</span></span></li></ul></section></div></details></nav><main id=\"main\" class=\"ops\" data-bl-k=\"main\" data-bl-label=\"Gifts\"><div class=\"con-head\"><div><h1 class=\"ops-title\"><span data-bl-t=\"heading\">Gifts</span></h1><p class=\"ops-lede\"><span data-bl-t=\"copy\">Your registry and gifts of money: what guests can give, how they send it, and what the page looks like to them.</span></p></div></div><section class=\"gs-status\" aria-labelledby=\"gs-status-title\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"section\" data-bl-label=\"Guests have nothing to give with yet.\"><p class=\"gs-status__eyebrow\"><span data-bl-t=\"copy\">Not live for guests yet</span></p><h2 id=\"gs-status-title\" class=\"gs-status__title\"><span data-bl-t=\"heading\">Guests have nothing to give with yet.</span></h2><p class=\"gs-status__line\"><span data-bl-t=\"copy\">Guests find Gifts in their account menu from RSVPs open. The site is at the teaser now; anyone with the link can still open it once signed in.</span></p><p class=\"gs-status__actions\"><a class=\"ops-button ops-button-ghost\" href=\"#gift-wishlist\" data-bl-b=\"\" target=\"_self\"><span data-bl-t=\"copy\">Next: </span><!-- --><span data-bl-t=\"copy\">Registry</span></a><a class=\"flow-link\" href=\"#gifts-preview\" target=\"_self\"><span data-bl-t=\"copy\">See what guests see</span></a><a class=\"flow-link\" href=\"/gifts\" rel=\"noopener\"><span data-bl-t=\"copy\">Open the Gifts page</span><span aria-hidden=\"true\"><span data-bl-t=\"label\"> ↗</span></span><span class=\"sr-only\"><span data-bl-t=\"copy\"> (new tab)</span></span></a></p></section><ol class=\"gs-steps\" role=\"list\"><li class=\"gs-step\" id=\"gift-wishlist\" data-current=\"\" aria-labelledby=\"gift-wishlist-title\"><span class=\"gs-step__num\" aria-hidden=\"true\" data-bl-s=\"\" data-bl-dark=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">1</span></span><div class=\"gs-step__body\"><h2 id=\"gift-wishlist-title\" class=\"gs-step__title\"><span class=\"sr-only\"><span data-bl-t=\"heading\">Step </span><!-- --><span data-bl-t=\"heading\">1</span><!-- --><span data-bl-t=\"heading\">: </span></span><span data-bl-t=\"heading\">Registry</span><span class=\"gs-step__next\"><span data-bl-t=\"heading\">Next</span></span></h2><p class=\"gs-copy\"><span data-bl-t=\"copy\">The list itself lives on your registry site: Zola, The Knot or Joy. Guests buy there, and the registry keeps track of what has been bought. This site does not copy the list; it sends guests to it, so paste the link your registry gives you.</span></p><p class=\"flow-empty\" role=\"status\" data-bl-b=\"\"><span data-bl-t=\"copy\">No registry linked. Guests read that you have not chosen where to keep a wishlist yet.</span></p><div class=\"flow-anchor\"><button type=\"button\" class=\"ops-button ops-button-primary\" aria-haspopup=\"dialog\" data-bl-s=\"\" data-bl-dark=\"\"><span data-bl-t=\"label\">Link your registry</span></button><p class=\"flow-announce\" role=\"status\"></p><dialog class=\"flow-sheet\" data-tone=\"default\" aria-labelledby=\"_R_1qamatpesnfknelb_--sheet-title\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"dialog\" data-bl-label=\"Link your registry\"><form class=\"flow-frame\" novalidate=\"\" data-bl-k=\"form\" data-bl-label=\"Paste the link\" data-bl-form=\"\"><header class=\"flow-head\" data-bl-b=\"\" data-bl-k=\"header\"><div class=\"flow-head__row\"><p id=\"_R_1qamatpesnfknelb_--sheet-title\" class=\"flow-title\"><span data-bl-t=\"copy\">Link your registry</span></p><button type=\"button\" class=\"flow-close\"><span data-bl-t=\"label\">Close</span><span class=\"sr-only\"><span data-bl-t=\"label\"> (your answers are kept)</span></span></button></div><ol class=\"flow-progress\" aria-label=\"Step 1 of 3\"><li data-state=\"current\" aria-current=\"step\"><span class=\"flow-progress__bar\" aria-hidden=\"true\" data-bl-s=\"\" data-bl-dark=\"\"></span><span class=\"flow-progress__label\"><span data-bl-t=\"copy\">Paste the link</span></span></li><li data-state=\"todo\"><span class=\"flow-progress__bar\" aria-hidden=\"true\" data-bl-s=\"\"></span><span class=\"flow-progress__label\"><span data-bl-t=\"copy\">Check it is yours</span></span></li><li data-state=\"todo\"><span class=\"flow-progress__bar\" aria-hidden=\"true\" data-bl-s=\"\"></span><span class=\"flow-progress__label\"><span data-bl-t=\"copy\">How guests see it</span></span></li></ol></header><div class=\"flow-body\"><section class=\"flow-step\" data-direction=\"forward\" aria-labelledby=\"_R_1qamatpesnfknelb_--step-title\" data-bl-k=\"section\" data-bl-label=\"Paste the link\"><p class=\"flow-step__count\"><span data-bl-t=\"copy\">Step </span><!-- --><span data-bl-t=\"copy\">1</span><!-- --><span data-bl-t=\"copy\"> of </span><!-- --><span data-bl-t=\"copy\">3</span></p><h2 id=\"_R_1qamatpesnfknelb_--step-title\" tabindex=\"-1\" class=\"flow-step__title\"><span data-bl-t=\"heading\">Paste the link</span></h2><p class=\"flow-step__lede\"><span data-bl-t=\"copy\">Open your registry on Zola, The Knot or Joy, press its Share button, and paste the link it gives you.</span></p><div class=\"flow-step__fields\"><div class=\"flow-field\"><label for=\"_R_1qamatpesnfknelb_-url\" class=\"flow-label\"><span data-bl-t=\"label\">Link to your registry</span></label><input id=\"_R_1qamatpesnfknelb_-url\" aria-describedby=\"_R_1qamatpesnfknelb_-url-hint\" class=\"ops-input flow-input\" autocomplete=\"off\" spellcheck=\"false\" type=\"url\" inputmode=\"url\" name=\"url\" value=\"\" data-bl-s=\"\" data-bl-b=\"\"><p id=\"_R_1qamatpesnfknelb_-url-hint\" class=\"flow-hint\"><span data-bl-t=\"copy\">It starts with https:// and names your registry site, for example zola.com/registry/…</span></p></div></div></section></div><footer class=\"flow-foot\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"footer\"><span></span><div class=\"flow-foot__nav\"><button type=\"submit\" class=\"ops-button ops-button-primary\" data-bl-s=\"\" data-bl-dark=\"\"><span data-bl-t=\"label\">Continue</span></button></div></footer></form></dialog></div></div></li><li class=\"gs-step\" id=\"gift-rails\" aria-labelledby=\"gift-rails-title\"><span class=\"gs-step__num\" aria-hidden=\"true\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">2</span></span><div class=\"gs-step__body\"><h2 id=\"gift-rails-title\" class=\"gs-step__title\"><span class=\"sr-only\"><span data-bl-t=\"heading\">Step </span><!-- --><span data-bl-t=\"heading\">2</span><!-- --><span data-bl-t=\"heading\">: </span></span><span data-bl-t=\"heading\">Ways to give</span></h2><p class=\"gs-copy\"><span data-bl-t=\"copy\">Your own Venmo, PayPal, Cash App, Zelle or a mailing address for checks. Money goes from a guest’s account straight to yours; this site never holds it or adds a fee.</span></p><p class=\"flow-empty\" role=\"status\" data-bl-b=\"\"><span data-bl-t=\"copy\">None yet. Until you add one, guests see no gifts of money at all.</span></p><div class=\"flow-anchor\"><button type=\"button\" class=\"ops-button ops-button-ghost\" aria-haspopup=\"dialog\" data-bl-b=\"\"><span data-bl-t=\"label\">Add a way to give</span></button><p class=\"flow-announce\" role=\"status\"></p><dialog class=\"flow-sheet\" data-tone=\"default\" aria-labelledby=\"_R_79imatpesnfknelb_--sheet-title\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"dialog\" data-bl-label=\"Add a way to give\"><form class=\"flow-frame\" novalidate=\"\" data-bl-k=\"form\" data-bl-label=\"Choose how\" data-bl-form=\"\"><header class=\"flow-head\" data-bl-b=\"\" data-bl-k=\"header\"><div class=\"flow-head__row\"><p id=\"_R_79imatpesnfknelb_--sheet-title\" class=\"flow-title\"><span data-bl-t=\"copy\">Add a way to give</span></p><button type=\"button\" class=\"flow-close\"><span data-bl-t=\"label\">Close</span><span class=\"sr-only\"><span data-bl-t=\"label\"> (your answers are kept)</span></span></button></div><ol class=\"flow-progress\" aria-label=\"Step 1 of 3\"><li data-state=\"current\" aria-current=\"step\"><span class=\"flow-progress__bar\" aria-hidden=\"true\" data-bl-s=\"\" data-bl-dark=\"\"></span><span class=\"flow-progress__label\"><span data-bl-t=\"copy\">Choose how</span></span></li><li data-state=\"todo\"><span class=\"flow-progress__bar\" aria-hidden=\"true\" data-bl-s=\"\"></span><span class=\"flow-progress__label\"><span data-bl-t=\"copy\">Your details</span></span></li><li data-state=\"todo\"><span class=\"flow-progress__bar\" aria-hidden=\"true\" data-bl-s=\"\"></span><span class=\"flow-progress__label\"><span data-bl-t=\"copy\">Try it</span></span></li></ol></header><div class=\"flow-body\"><section class=\"flow-step\" data-direction=\"forward\" aria-labelledby=\"_R_79imatpesnfknelb_--step-title\" data-bl-k=\"section\" data-bl-label=\"Choose how\"><p class=\"flow-step__count\"><span data-bl-t=\"copy\">Step </span><!-- --><span data-bl-t=\"copy\">1</span><!-- --><span data-bl-t=\"copy\"> of </span><!-- --><span data-bl-t=\"copy\">3</span></p><h2 id=\"_R_79imatpesnfknelb_--step-title\" tabindex=\"-1\" class=\"flow-step__title\"><span data-bl-t=\"heading\">Choose how</span></h2><p class=\"flow-step__lede\"><span data-bl-t=\"copy\">Guests send money from their own account straight to yours. This site never touches it and never takes a fee.</span></p><div class=\"flow-step__fields\"><fieldset class=\"flow-choices\" data-bl-k=\"fieldset\" data-bl-label=\"Way to give\"><legend class=\"flow-label\"><span data-bl-t=\"label\">Way to give</span></legend><div class=\"flow-choices__list\" data-bl-b=\"\"><label for=\"_R_79imatpesnfknelb_-rail\" class=\"flow-choice\"><input id=\"_R_79imatpesnfknelb_-rail\" type=\"radio\" name=\"rail\" value=\"zelle\"><span class=\"flow-choice__text\"><span class=\"flow-choice__label\"><span data-bl-t=\"label\">Zelle</span></span><span class=\"flow-choice__desc\"><span data-bl-t=\"label\">Guests send from their own bank. Shown only to guests who opened the site from their invitation.</span></span></span></label><label for=\"_R_79imatpesnfknelb_-rail-venmo\" class=\"flow-choice\" data-bl-b=\"\"><input id=\"_R_79imatpesnfknelb_-rail-venmo\" type=\"radio\" name=\"rail\" value=\"venmo\"><span class=\"flow-choice__text\"><span class=\"flow-choice__label\"><span data-bl-t=\"label\">Venmo</span></span><span class=\"flow-choice__desc\"><span data-bl-t=\"label\">Guests tap a button that opens your profile in the app.</span></span></span></label><label for=\"_R_79imatpesnfknelb_-rail-paypal\" class=\"flow-choice\" data-bl-b=\"\"><input id=\"_R_79imatpesnfknelb_-rail-paypal\" type=\"radio\" name=\"rail\" value=\"paypal\"><span class=\"flow-choice__text\"><span class=\"flow-choice__label\"><span data-bl-t=\"label\">PayPal</span></span><span class=\"flow-choice__desc\"><span data-bl-t=\"label\">Guests tap a button that opens your profile in the app.</span></span></span></label><label for=\"_R_79imatpesnfknelb_-rail-cashapp\" class=\"flow-choice\" data-bl-b=\"\"><input id=\"_R_79imatpesnfknelb_-rail-cashapp\" type=\"radio\" name=\"rail\" value=\"cashapp\"><span class=\"flow-choice__text\"><span class=\"flow-choice__label\"><span data-bl-t=\"label\">Cash App</span></span><span class=\"flow-choice__desc\"><span data-bl-t=\"label\">Guests tap a button that opens your profile in the app.</span></span></span></label><label for=\"_R_79imatpesnfknelb_-rail-check\" class=\"flow-choice\" data-bl-b=\"\"><input id=\"_R_79imatpesnfknelb_-rail-check\" type=\"radio\" name=\"rail\" value=\"check\"><span class=\"flow-choice__text\"><span class=\"flow-choice__label\"><span data-bl-t=\"label\">Check by mail</span></span><span class=\"flow-choice__desc\"><span data-bl-t=\"label\">Guests mail a check. Your address is shown only to guests who opened the site from their invitation.</span></span></span></label></div></fieldset></div></section></div><footer class=\"flow-foot\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"f