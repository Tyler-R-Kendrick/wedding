 "body": "<div hidden=\"\"><!--$--><!--/$--></div><p id=\"design-announcer\" class=\"sr-only\" aria-live=\"polite\" aria-atomic=\"true\"></p><div class=\"admin-root\"><a class=\"skip\" href=\"#main\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><nav aria-label=\"Admin\" class=\"con-nav\" data-bl-b=\"\" data-bl-k=\"nav\" data-bl-label=\"Admin\"><ul class=\"list list--plain con-nav__bar\"><li><a href=\"/admin\"><span data-bl-t=\"label\">Admin</span></a></li><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a></li><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit</span></a></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a></li><li><a href=\"/admin/guests#browse-as\"><span data-bl-t=\"label\">Browse as a guest</span></a></li></ul><details><summary><span data-bl-t=\"label\">All admin screens</span></summary><div class=\"con-index\"><section aria-labelledby=\"nav-site\" data-bl-k=\"section\" data-bl-label=\"The site\"><p id=\"nav-site\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The site</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What state guests see, what the calendar suggests, and previewing another state.</span></span></li><li><a href=\"/admin/flags\"><span data-bl-t=\"label\">Feature flags</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Both halves of every gate, and the two legal switches that stay shut.</span></span></li><li><a href=\"/admin/content\"><span data-bl-t=\"label\">Content</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Records with provenance, freshness and verification.</span></span></li><li><a href=\"/admin/events\"><span data-bl-t=\"label\">Events &amp; RSVP window</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Events, meal options, notices, and when RSVP opens.</span></span></li></ul></section><section aria-labelledby=\"nav-guests\" data-bl-k=\"section\" data-bl-label=\"Guests\"><p id=\"nav-guests\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Guests</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/guests\"><span data-bl-t=\"label\">Guests</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">People, households they belong to, identity resets.</span></span></li><li><a href=\"/admin/households\"><span data-bl-t=\"label\">Households</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Household records and mailing addresses.</span></span></li><li><a href=\"/admin/invitations\"><span data-bl-t=\"label\">Invitations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Issue, rotate and revoke invitation links.</span></span></li><li><a href=\"/admin/rsvp\"><span data-bl-t=\"label\">RSVPs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Who has replied, overrides and exports.</span></span></li><li><a href=\"/admin/seating\"><span data-bl-t=\"label\">Seating</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Tables, assignments and publishing the chart.</span></span></li></ul></section><section aria-labelledby=\"nav-weekend\" data-bl-k=\"section\" data-bl-label=\"The weekend\"><p id=\"nav-weekend\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The weekend</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/travel\"><span data-bl-t=\"label\">Travel &amp; stay</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Hotels, links and the room block.</span></span></li><li><a href=\"/admin/transport\"><span data-bl-t=\"label\">Transport</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Benefit entitlements and voucher codes.</span></span></li><li><a href=\"/admin/gifts\"><span data-bl-t=\"label\">Gifts</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Registry and gift links.</span></span></li><li><a href=\"/admin/reservations\"><span data-bl-t=\"label\">Reservations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Venues guests can book through.</span></span></li></ul></section><section aria-labelledby=\"nav-media\" data-bl-k=\"section\" data-bl-label=\"Media &amp; AI\"><p id=\"nav-media\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Media &amp; AI</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/media\"><span data-bl-t=\"label\">Media</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Moderation queue, imports and duplicates.</span></span></li><li><a href=\"/admin/ai\"><span data-bl-t=\"label\">Media AI</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Captions, indexing and what the model may touch.</span></span></li><li><a href=\"/admin/concierge\"><span data-bl-t=\"label\">Concierge</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Answer traces, grounding failures, security alerts.</span></span></li></ul></section><section aria-labelledby=\"nav-operations\" data-bl-k=\"section\" data-bl-label=\"Operations\"><p id=\"nav-operations\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Operations</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit trail</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Every action anyone took, searchable, redacted.</span></span></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Queue depth, failures and retries.</span></span></li><li><a href=\"/admin/metrics\"><span data-bl-t=\"label\">Metrics</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What this deployment recorded, and whether it is recording.</span></span></li><li><a href=\"/admin/providers\"><span data-bl-t=\"label\">Providers</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Which adapter each integration resolved to, and what it can do.</span></span></li></ul></section></div></details></nav><main id=\"main\" class=\"ops\" data-bl-k=\"main\" data-bl-label=\"Gifts\"><div class=\"con-head\"><div><h1 class=\"ops-title\"><span data-bl-t=\"heading\">Gifts</span></h1><p class=\"ops-lede\"><span data-bl-t=\"copy\">Your registry and gifts of money: what guests can give, how they send it, and what the page looks like to them.</span></p></div></div><section class=\"gs-status\" aria-labelledby=\"gs-status-title\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"section\" data-bl-label=\"Guests have nothing to give with yet.\"><p class=\"gs-status__eyebrow\"><span data-bl-t=\"copy\">Not live for guests yet</span></p><h2 id=\"gs-status-title\" class=\"gs-status__title\"><span data-bl-t=\"heading\">Guests have nothing to give with yet.</span></h2><p class=\"gs-status__line\"><span data-bl-t=\"copy\">Guests find Gifts in their account menu from RSVPs open. The site is at the teaser now; anyone with the link can still open it once signed in.</span></p><p class=\"gs-status__actions\"><a class=\"ops-button ops-button-ghost\" href=\"#gift-wishlist\" data-bl-b=\"\" target=\"_self\"><span data-bl-t=\"copy\">Next: </span><!-- --><span data-bl-t=\"copy\">Registry</span></a><a class=\"flow-link\" href=\"#gifts-preview\" target=\"_self\"><span data-bl-t=\"copy\">See what guests see</span></a><a class=\"flow-link\" href=\"/gifts\" rel=\"noopener\"><span data-bl-t=\"copy\">Open the Gifts page</span><span aria-hidden=\"true\"><span data-bl-t=\"label\"> ↗</span></span><span class=\"sr-only\"><span data-bl-t=\"copy\"> (new tab)</span></span></a></p></section><ol class=\"gs-steps\" role=\"list\"><li class=\"gs-step\" id=\"gift-wishlist\" data-current=\"\" aria-labelledby=\"gift-wishlist-title\"><span class=\"gs-step__num\" aria-hidden=\"true\" data-bl-s=\"\" data-bl-dark=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">1</span></span><div class=\"gs-step__body\"><h2 id=\"gift-wishlist-title\" class=\"gs-step__title\"><span class=\"sr-only\"><span data-bl-t=\"heading\">Step </span><!-- --><span data-bl-t=\"heading\">1</span><!-- --><span data-bl-t=\"heading\">: </span></span><span data-bl-t=\"heading\">Registry</span><span class=\"gs-step__next\"><span data-bl-t=\"heading\">Next</span></span></h2><p class=\"gs-copy\"><span data-bl-t=\"copy\">The list itself lives on your registry site: Zola, The Knot or Joy. Guests buy there, and the registry keeps track of what has been bought. This site does not copy the list; it sends guests to it, so paste the link your registry gives you.</span></p><p class=\"flow-empty\" role=\"status\" data-bl-b=\"\"><span data-bl-t=\"copy\">No registry linked. Guests read that you have not chosen where to keep a wishlist yet.</span></p><div class=\"flow-anchor\"><button type=\"button\" class=\"ops-button ops-button-primary\" aria-haspopup=\"dialog\" data-bl-s=\"\" data-bl-dark=\"\"><span data-bl-t=\"label\">Link your registry</span></button><p class=\"flow-announce\" role=\"status\"></p><dialog class=\"flow-sheet\" data-tone=\"default\" aria-labelledby=\"_R_1qamatpesnfknelb_--sheet-title\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"dialog\"></dialog></div></div></li><li class=\"gs-step\" id=\"gift-rails\" aria-labelledby=\"gift-rails-title\"><span class=\"gs-step__num\" aria-hidden=\"true\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">2</span></span><div class=\"gs-step__body\"><h2 id=\"gift-rails-title\" class=\"gs-step__title\"><span class=\"sr-only\"><span data-bl-t=\"heading\">Step </span><!-- --><span data-bl-t=\"heading\">2</span><!-- --><span data-bl-t=\"heading\">: </span></span><span data-bl-t=\"heading\">Ways to give</span></h2><p class=\"gs-copy\"><span data-bl-t=\"copy\">Your own Venmo, PayPal, Cash App, Zelle or a mailing address for checks. Money goes from a guest’s account straight to yours; this site never holds it or adds a fee.</span></p><p class=\"flow-empty\" role=\"status\" data-bl-b=\"\"><span data-bl-t=\"copy\">None yet. Until you add one, guests see no gifts of money at all.</span></p><div class=\"flow-anchor\"><button type=\"button\" class=\"ops-button ops-button-ghost\" aria-haspopup=\"dialog\" data-bl-b=\"\"><span data-bl-t=\"label\">Add a way to give</span></button><p class=\"flow-announce\" role=\"status\"></p><dialog class=\"flow-sheet\" data-tone=\"default\" aria-labelledby=\"_R_79imatpesnfknelb_--sheet-title\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"dialog\"></dialog></div></div></li><li class=\"gs-step\" id=\"gift-funds\" aria-labelledby=\"gift-funds-title\"><span class=\"gs-step__num\" aria-hidden=\"true\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">3</span></span><div class=\"gs-step__body\"><h2 id=\"gift-funds-title\" class=\"gs-step__title\"><span class=\"sr-only\"><span data-bl-t=\"heading\">Step </span><!-- --><span data-bl-t=\"heading\">3</span><!-- --><span data-bl-t=\"heading\">: </span></span><span data-bl-t=\"heading\">Funds</span></h2><p class=\"gs-copy\"><span data-bl-t=\"copy\">Guests pick one of these, then how to send it. Venmo’s note carries the fund’s name, so you can tell a honeymoon gift from a house gift.</span></p><p class=\"gs-blocked\" role=\"note\" data-bl-s=\"\" data-bl-b=\"\"><strong><span data-bl-t=\"copy\">Hidden from guests until you add a way to give.</span></strong><span data-bl-t=\"copy\"> A list of things to give toward, with no way to give, would be a dead end, so the Gifts page leaves these out until you add a way to give.</span></p><ul class=\"flow-rows\" role=\"list\" aria-label=\"Funds\" data-bl-b=\"\"><li class=\"flow-row\" data-gift-fund-id=\"honeymoon\" data-bl-b=\"\"><div class=\"flow-row__main\"><p class=\"flow-row__title\"><span data-bl-t=\"copy\">Our honeymoon</span><!-- --> <span class=\"con-pill con-pill--neutral\" data-bl-b=\"\"><span data-bl-t=\"copy\">Ready, waiting on a way to give</span></span></p><p class=\"flow-row__meta\"><span data-bl-t=\"copy\">Toward the first trip of our married life.</span></p></div><div class=\"flow-row__actions\"><div class=\"flow-anchor\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-haspopup=\"dialog\" aria-label=\"Edit Our honeymoon\"><span data-bl-t=\"label\">Edit</span></button><p class=\"flow-announce\" role=\"status\"></p><dialog class=\"flow-sheet\" data-tone=\"default\" aria-labelledby=\"_R_onaimatpesnfknelb_--sheet-title\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"dialog\"></dialog></div><span class=\"flow-quick\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-label=\"Hide Our honeymoon\"><span data-bl-t=\"label\">Hide</span></button><span class=\"sr-only\" role=\"status\"></span></span><span class=\"flow-quick\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-disabled=\"true\" aria-label=\"Move Our honeymoon up\"><span data-bl-t=\"label\">Up</span></button><span class=\"sr-only\" role=\"status\"></span></span><span class=\"flow-quick\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-label=\"Move Our honeymoon down\"><span data-bl-t=\"label\">Down</span></button><span class=\"sr-only\" role=\"status\"></span></span></div></li><li class=\"flow-row\" data-gift-fund-id=\"home\" data-bl-b=\"\"><div class=\"flow-row__main\"><p class=\"flow-row__title\"><span data-bl-t=\"copy\">Our home</span><!-- --> <span class=\"con-pill con-pill--neutral\" data-bl-b=\"\"><span data-bl-t=\"copy\">Ready, waiting on a way to give</span></span></p><p class=\"flow-row__meta\"><span data-bl-t=\"copy\">Toward a house of our own.</span></p></div><div class=\"flow-row__actions\"><div class=\"flow-anchor\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-haspopup=\"dialog\" aria-label=\"Edit Our home\"><span data-bl-t=\"label\">Edit</span></button><p class=\"flow-announce\" role=\"status\"></p><dialog class=\"flow-sheet\" data-tone=\"default\" aria-labelledby=\"_R_p7aimatpesnfknelb_--sheet-title\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"dialog\"></dialog></div><span class=\"flow-quick\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-label=\"Hide Our home\"><span data-bl-t=\"label\">Hide</span></button><span class=\"sr-only\" role=\"status\"></span></span><span class=\"flow-quick\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-label=\"Move Our home up\"><span data-bl-t=\"label\">Up</span></button><span class=\"sr-only\" role=\"status\"></span></span><span class=\"flow-quick\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-label=\"Move Our home down\"><span data-bl-t=\"label\">Down</span></button><span class=\"sr-only\" role=\"status\"></span></span></div></li><li class=\"flow-row\" data-gift-fund-id=\"adoption\" data-bl-b=\"\"><div class=\"flow-row__main\"><p class=\"flow-row__title\"><span data-bl-t=\"copy\">Growing our family</span><!-- --> <span class=\"con-pill con-pill--neutral\" data-bl-b=\"\"><span data-bl-t=\"copy\">Ready, waiting on a way to give</span></span></p><p class=\"flow-row__meta\"><span data-bl-t=\"copy\">Toward adoption, and the family we hope to grow.</span></p></div><div class=\"flow-row__actions\"><div class=\"flow-anchor\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-haspopup=\"dialog\" aria-label=\"Edit Growing our family\"><span data-bl-t=\"label\">Edit</span></button><p class=\"flow-announce\" role=\"status\"></p><dialog class=\"flow-sheet\" data-tone=\"default\" aria-labelledby=\"_R_pnaimatpesnfknelb_--sheet-title\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"dialog\"></dialog></div><span class=\"flow-quick\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-label=\"Hide Growing our family\"><span data-bl-t=\"label\">Hide</span></button><span class=\"sr-only\" role=\"status\"></span></span><span class=\"flow-quick\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-label=\"Move Growing our family up\"><span data-bl-t=\"label\">Up</span></button><span class=\"sr-only\" role=\"status\"></span></span><span class=\"flow-quick\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-label=\"Move Growing our family down\"><span data-bl-t=\"label\">Down</span></button><span class=\"sr-only\" role=\"status\"></span></span></div></li><li class=\"flow-row\" data-gift-fund-id=\"next-adventures\" data-bl-b=\"\"><div class=\"flow-row__main\"><p class=\"flow-row__title\"><span data-bl-t=\"copy\">Our next adventures</span><!-- --> <span class=\"con-pill con-pill--neutral\" data-bl-b=\"\"><span data-bl-t=\"copy\">Ready, waiting on a way to give</span></span></p><p class=\"flow-row__meta\"><span data-bl-t=\"copy\">Wherever it helps most: trips, date nights, and the things we have not thought of yet.</span></p></div><div class=\"flow-row__actions\"><div class=\"flow-anchor\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-haspopup=\"dialog\" aria-label=\"Edit Our next adventures\"><span data-bl-t=\"label\">Edit</span></button><p class=\"flow-announce\" role=\"status\"></p><dialog class=\"flow-sheet\" data-tone=\"default\" aria-labelledby=\"_R_q7aimatpesnfknelb_--sheet-title\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"dialog\"></dialog></div><span class=\"flow-quick\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-label=\"Hide Our next adventures\"><span data-bl-t=\"label\">Hide</span></button><span class=\"sr-only\" role=\"status\"></span></span><span class=\"flow-quick\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-label=\"Move Our next adventures up\"><span data-bl-t=\"label\">Up</span></button><span class=\"sr-only\" role=\"status\"></span></span><span class=\"flow-quick\"><button type=\"button\" class=\"flow-trigger-quiet\" aria-disabled=\"true\" aria-label=\"Move Our next adventures down\"><span data-bl-t=\"label\">Down</span></button><span class=\"sr-only\" role=\"status\"></span></span></di