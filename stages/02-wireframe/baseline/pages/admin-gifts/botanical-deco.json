 "body": "<div hidden=\"\"><!--$--><!--/$--></div><p id=\"design-announcer\" class=\"sr-only\" aria-live=\"polite\" aria-atomic=\"true\"></p><div class=\"admin-root\"><a class=\"skip\" href=\"#main\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><nav aria-label=\"Admin\" class=\"con-nav\" data-bl-b=\"\" data-bl-k=\"nav\" data-bl-label=\"Admin\"><ul class=\"list list--plain con-nav__bar\"><li><a href=\"/admin\"><span data-bl-t=\"label\">Admin</span></a></li><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a></li><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit</span></a></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a></li></ul><details><summary><span data-bl-t=\"label\">All admin screens</span></summary><div class=\"con-index\"><section aria-labelledby=\"nav-site\" data-bl-k=\"section\" data-bl-label=\"The site\"><p id=\"nav-site\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The site</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What state guests see, what the calendar suggests, and previewing another state.</span></span></li><li><a href=\"/admin/flags\"><span data-bl-t=\"label\">Feature flags</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Both halves of every gate, and the two legal switches that stay shut.</span></span></li><li><a href=\"/admin/content\"><span data-bl-t=\"label\">Content</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Records with provenance, freshness and verification.</span></span></li><li><a href=\"/admin/events\"><span data-bl-t=\"label\">Events &amp; RSVP window</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Events, meal options, notices, and when RSVP opens.</span></span></li></ul></section><section aria-labelledby=\"nav-guests\" data-bl-k=\"section\" data-bl-label=\"Guests\"><p id=\"nav-guests\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Guests</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/guests\"><span data-bl-t=\"label\">Guests</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">People, households they belong to, identity resets.</span></span></li><li><a href=\"/admin/households\"><span data-bl-t=\"label\">Households</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Household records and mailing addresses.</span></span></li><li><a href=\"/admin/invitations\"><span data-bl-t=\"label\">Invitations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Issue, rotate and revoke invitation links.</span></span></li><li><a href=\"/admin/rsvp\"><span data-bl-t=\"label\">RSVPs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Who has replied, overrides and exports.</span></span></li><li><a href=\"/admin/seating\"><span data-bl-t=\"label\">Seating</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Tables, assignments and publishing the chart.</span></span></li></ul></section><section aria-labelledby=\"nav-weekend\" data-bl-k=\"section\" data-bl-label=\"The weekend\"><p id=\"nav-weekend\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The weekend</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/travel\"><span data-bl-t=\"label\">Travel &amp; stay</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Hotels, links and the room block.</span></span></li><li><a href=\"/admin/transport\"><span data-bl-t=\"label\">Transport</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Benefit entitlements and voucher codes.</span></span></li><li><a href=\"/admin/gifts\"><span data-bl-t=\"label\">Gifts</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Registry and gift links.</span></span></li><li><a href=\"/admin/reservations\"><span data-bl-t=\"label\">Reservations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Venues guests can book through.</span></span></li></ul></section><section aria-labelledby=\"nav-media\" data-bl-k=\"section\" data-bl-label=\"Media &amp; AI\"><p id=\"nav-media\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Media &amp; AI</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/media\"><span data-bl-t=\"label\">Media</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Moderation queue, imports and duplicates.</span></span></li><li><a href=\"/admin/ai\"><span data-bl-t=\"label\">Media AI</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Captions, indexing and what the model may touch.</span></span></li><li><a href=\"/admin/concierge\"><span data-bl-t=\"label\">Concierge</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Answer traces, grounding failures, security alerts.</span></span></li></ul></section><section aria-labelledby=\"nav-operations\" data-bl-k=\"section\" data-bl-label=\"Operations\"><p id=\"nav-operations\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Operations</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit trail</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Every action anyone took, searchable, redacted.</span></span></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Queue depth, failures and retries.</span></span></li><li><a href=\"/admin/metrics\"><span data-bl-t=\"label\">Metrics</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What this deployment recorded, and whether it is recording.</span></span></li><li><a href=\"/admin/providers\"><span data-bl-t=\"label\">Providers</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Which adapter each integration resolved to, and what it can do.</span></span></li></ul></section></div></details></nav><main id=\"main\" class=\"ops\" data-bl-k=\"main\" data-bl-label=\"Gift links\"><div class=\"con-head\"><div><h1 class=\"ops-title\"><span data-bl-t=\"heading\">Gift links</span></h1></div></div><section id=\"what-guests-see-now\" class=\"ops-section\" aria-labelledby=\"what-guests-see-now-heading\" data-bl-k=\"section\" data-bl-label=\"What guests see now\"><h2 id=\"what-guests-see-now-heading\" class=\"ops-h2\"><span data-bl-t=\"heading\">What guests see now</span></h2><div class=\"ops-table-wrap con-scroll\" tabindex=\"0\" data-bl-b=\"\"><table class=\"ops-table con-table\"><thead><tr><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Kind</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Label</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Provider</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Host</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Origin</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Placeholder</span></th></tr></thead><tbody></tbody></table></div></section><section id=\"configured-rows\" class=\"ops-section\" aria-labelledby=\"configured-rows-heading\" data-bl-k=\"section\" data-bl-label=\"Configured rows\"><h2 id=\"configured-rows-heading\" class=\"ops-h2\"><span data-bl-t=\"heading\">Configured rows</span></h2><div class=\"ops-table-wrap con-scroll\" tabindex=\"0\" data-bl-b=\"\"><table class=\"ops-table con-table\"><thead><tr><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Id</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Kind</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Label</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">URL</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Active</span></th></tr></thead><tbody><tr><td colspan=\"5\"><span data-bl-t=\"copy\">None configured; guests see the built-in placeholders.</span></td></tr></tbody></table></div></section><section id=\"gift-funds\" class=\"ops-section\" aria-labelledby=\"gift-funds-heading\" data-bl-k=\"section\" data-bl-label=\"Gifts of money: what they go toward\"><h2 id=\"gift-funds-heading\" class=\"ops-h2\"><span data-bl-t=\"heading\">Gifts of money: what they go toward</span></h2><p class=\"con-note\"><span data-bl-t=\"copy\">Guests give toward a fund with their own Venmo, PayPal, Cash App, Zelle or a check. The money goes from their account straight to yours: this site never takes a payment, holds money, or adds a fee. The four built-in funds need nothing from you; save one with the same id to change its words or hide it.</span></p><div class=\"ops-table-wrap con-scroll\" tabindex=\"0\" data-bl-b=\"\"><table class=\"ops-table con-table\"><thead><tr><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Id</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Title</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Description</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Order</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Shown</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Words from</span></th></tr></thead><tbody><tr data-gift-fund-id=\"honeymoon\"><td data-bl-b=\"\"><span data-bl-t=\"copy\">honeymoon</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">Our honeymoon</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">Toward the first trip of our married life.</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">0</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">yes</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">built in</span></td></tr><tr data-gift-fund-id=\"home\"><td data-bl-b=\"\"><span data-bl-t=\"copy\">home</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">Our home</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">Toward a house of our own.</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">10</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">yes</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">built in</span></td></tr><tr data-gift-fund-id=\"adoption\"><td data-bl-b=\"\"><span data-bl-t=\"copy\">adoption</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">Growing our family</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">Toward adoption, and the family we hope to grow.</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">20</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">yes</span></td><td data-bl-b=\"\"><span data-bl-t=\"copy\">built in</span></td></tr><tr data-gift-fund-id=\"next-adventures\"><td><span data-bl-t=\"copy\">next-adventures</span></td><td><span data-bl-t=\"copy\">Our next adventures</span></td><td><span data-bl-t=\"copy\">Wherever it helps most: trips, date nights, and the things we have not thought of yet.</span></td><td><span data-bl-t=\"copy\">30</span></td><td><span data-bl-t=\"copy\">yes</span></td><td><span data-bl-t=\"copy\">built in</span></td></tr></tbody></table></div><form class=\"max-w-[40rem] border border-primary/20 p-6\" aria-labelledby=\"_R_fbiatpesnfknelb_-title\" data-bl-b=\"\" data-bl-k=\"form\" data-bl-label=\"Add or change a fund\" data-bl-form=\"\"><h3 id=\"_R_fbiatpesnfknelb_-title\" class=\"text-xl\"><span data-bl-t=\"heading\">Add or change a fund</span></h3><div class=\"mt-4 grid gap-4\"><div><label class=\"block\" for=\"_R_fbiatpesnfknelb_-id\"><span data-bl-t=\"label\">Id (slug)</span></label><input id=\"_R_fbiatpesnfknelb_-id\" type=\"text\" required=\"\" aria-describedby=\"_R_fbiatpesnfknelb_-id-help\" class=\"w-full border border-primary/40 bg-neutral px-3 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary\" autocomplete=\"off\" name=\"id\" data-bl-s=\"\" data-bl-b=\"\"><p id=\"_R_fbiatpesnfknelb_-id-help\" class=\"mt-1 hint\"><span data-bl-t=\"copy\">honeymoon, home, adoption and next-adventures are built in. A new id adds a fund.</span></p></div><div><label class=\"block\" for=\"_R_fbiatpesnfknelb_-title\"><span data-bl-t=\"label\">Title</span></label><input id=\"_R_fbiatpesnfknelb_-title\" type=\"text\" required=\"\" class=\"w-full border border-primary/40 bg-neutral px-3 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary\" autocomplete=\"off\" name=\"title\" data-bl-s=\"\" data-bl-b=\"\"></div><div><label class=\"block\" for=\"_R_fbiatpesnfknelb_-description\"><span data-bl-t=\"label\">One line about it</span></label><input id=\"_R_fbiatpesnfknelb_-description\" type=\"text\" aria-describedby=\"_R_fbiatpesnfknelb_-description-help\" class=\"w-full border border-primary/40 bg-neutral px-3 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary\" autocomplete=\"off\" name=\"description\" data-bl-s=\"\" data-bl-b=\"\"><p id=\"_R_fbiatpesnfknelb_-description-help\" class=\"mt-1 hint\"><span data-bl-t=\"copy\">Leave empty to keep what it says now.</span></p></div><div><label class=\"block\" for=\"_R_fbiatpesnfknelb_-sortOrder\"><span data-bl-t=\"label\">Order</span></label><input id=\"_R_fbiatpesnfknelb_-sortOrder\" type=\"number\" aria-describedby=\"_R_fbiatpesnfknelb_-sortOrder-help\" class=\"w-full border border-primary/40 bg-neutral px-3 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary\" autocomplete=\"off\" min=\"0\" max=\"1000\" step=\"1\" name=\"sortOrder\" data-bl-s=\"\" data-bl-b=\"\"><p id=\"_R_fbiatpesnfknelb_-sortOrder-help\" class=\"mt-1 hint\"><span data-bl-t=\"copy\">Built in: 0, 10, 20, 30. Leave empty to keep a fund where it is.</span></p></div><div><label class=\"inline-flex min-h-11 items-center gap-2\" for=\"_R_fbiatpesnfknelb_-active\"><input id=\"_R_fbiatpesnfknelb_-active\" type=\"checkbox\" class=\"size-5\" name=\"active\" checked=\"\"><span data-bl-t=\"label\">Shown to guests</span></label></div></div><div class=\"mt-5 flex flex-wrap items-center gap-4\"><button type=\"submit\" class=\"inline-flex min-h-11 items-center rounded-[var(--radius-button,2px)] bg-primary px-7 py-3 text-base text-neutral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-60\" data-bl-s=\"\" data-bl-dark=\"\"><span data-bl-t=\"label\">Save fund</span></button></div></form></section><section id=\"gift-rails\" class=\"ops-section\" aria-labelledby=\"gift-rails-heading\" data-bl-k=\"section\" data-bl-label=\"Gifts of money: ways to send one\"><h2 id=\"gift-rails-heading\" class=\"ops-h2\"><span data-bl-t=\"heading\">Gifts of money: ways to send one</span></h2><p class=\"con-note\"><span data-bl-t=\"copy\">None yet, so guests see no funds. Add at least one way to give and the funds appear on the Gifts page.</span></p><div class=\"ops-table-wrap con-scroll\" tabindex=\"0\" data-bl-b=\"\"><table class=\"ops-table con-table\"><thead><tr><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Way</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Sends to</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Name guests should see</span></th><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Shown</span></th></tr></thead><tbody></tbody></table></div><form class=\"max-w-[40rem] border border-primary/20 p-6\" aria-labelledby=\"_R_fjiatpesnfknelb_-title\" data-bl-b=\"\" data-bl-k=\"form\" data-bl-label=\"Add or change a way to give\" data-bl-form=\"\"><h3 id=\"_R_fjiatpesnfknelb_-title\" class=\"text-xl\"><span data-bl-t=\"heading\">Add or change a way to give</span></h3><div class=\"mt-4 grid gap-4\"><div><label class=\"block\" for=\"_R_fjiatpesnfknelb_-rail\"><span data-bl-t=\"label\">Way to give</sp