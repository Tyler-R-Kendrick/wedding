 "body": "<div hidden=\"\"><!--$--><!--/$--></div><p id=\"design-announcer\" class=\"sr-only\" aria-live=\"polite\" aria-atomic=\"true\"></p><div class=\"admin-root\"><a class=\"skip\" href=\"#main\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><nav aria-label=\"Admin\" class=\"con-nav\" data-bl-b=\"\" data-bl-k=\"nav\" data-bl-label=\"Admin\"><ul class=\"list list--plain con-nav__bar\"><li><a href=\"/admin\"><span data-bl-t=\"label\">Admin</span></a></li><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a></li><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit</span></a></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a></li></ul><details><summary><span data-bl-t=\"label\">All admin screens</span></summary><div class=\"con-index\"><section aria-labelledby=\"nav-site\" data-bl-k=\"section\" data-bl-label=\"The site\"><p id=\"nav-site\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The site</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What state guests see, what the calendar suggests, and previewing another state.</span></span></li><li><a href=\"/admin/flags\"><span data-bl-t=\"label\">Feature flags</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Both halves of every gate, and the two legal switches that stay shut.</span></span></li><li><a href=\"/admin/content\"><span data-bl-t=\"label\">Content</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Records with provenance, freshness and verification.</span></span></li><li><a href=\"/admin/events\"><span data-bl-t=\"label\">Events &amp; RSVP window</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Events, meal options, notices, and when RSVP opens.</span></span></li></ul></section><section aria-labelledby=\"nav-guests\" data-bl-k=\"section\" data-bl-label=\"Guests\"><p id=\"nav-guests\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Guests</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/guests\"><span data-bl-t=\"label\">Guests</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">People, households they belong to, identity resets.</span></span></li><li><a href=\"/admin/households\"><span data-bl-t=\"label\">Households</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Household records and mailing addresses.</span></span></li><li><a href=\"/admin/invitations\"><span data-bl-t=\"label\">Invitations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Issue, rotate and revoke invitation links.</span></span></li><li><a href=\"/admin/rsvp\"><span data-bl-t=\"label\">RSVPs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Who has replied, overrides and exports.</span></span></li><li><a href=\"/admin/seating\"><span data-bl-t=\"label\">Seating</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Tables, assignments and publishing the chart.</span></span></li></ul></section><section aria-labelledby=\"nav-weekend\" data-bl-k=\"section\" data-bl-label=\"The weekend\"><p id=\"nav-weekend\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The weekend</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/travel\"><span data-bl-t=\"label\">Travel &amp; stay</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Hotels, links and the room block.</span></span></li><li><a href=\"/admin/transport\"><span data-bl-t=\"label\">Transport</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Benefit entitlements and voucher codes.</span></span></li><li><a href=\"/admin/gifts\"><span data-bl-t=\"label\">Gifts</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Registry and gift links.</span></span></li><li><a href=\"/admin/reservations\"><span data-bl-t=\"label\">Reservations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Venues guests can book through.</span></span></li></ul></section><section aria-labelledby=\"nav-media\" data-bl-k=\"section\" data-bl-label=\"Media &amp; AI\"><p id=\"nav-media\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Media &amp; AI</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/media\"><span data-bl-t=\"label\">Media</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Moderation queue, imports and duplicates.</span></span></li><li><a href=\"/admin/ai\"><span data-bl-t=\"label\">Media AI</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Captions, indexing and what the model may touch.</span></span></li><li><a href=\"/admin/concierge\"><span data-bl-t=\"label\">Concierge</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Answer traces, grounding failures, security alerts.</span></span></li></ul></section><section aria-labelledby=\"nav-operations\" data-bl-k=\"section\" data-bl-label=\"Operations\"><p id=\"nav-operations\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Operations</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit trail</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Every action anyone took, searchable, redacted.</span></span></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Queue depth, failures and retries.</span></span></li><li><a href=\"/admin/metrics\"><span data-bl-t=\"label\">Metrics</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What this deployment recorded, and whether it is recording.</span></span></li><li><a href=\"/admin/providers\"><span data-bl-t=\"label\">Providers</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Which adapter each integration resolved to, and what it can do.</span></span></li></ul></section></div></details></nav><main id=\"main\" class=\"ops\" data-bl-k=\"main\" data-bl-label=\"New: Our Story\"><div class=\"con-head\"><div><h1 class=\"ops-title\"><span data-bl-t=\"heading\">New: Our Story</span></h1><p class=\"ops-lede\"><span data-bl-t=\"copy\">New records start as private drafts. Any text containing the TODO(Tyler &amp; Sara) marker must have “Placeholder” ticked.</span></p></div></div><nav aria-label=\"Breadcrumb\" class=\"con-crumbs\" data-bl-k=\"nav\" data-bl-label=\"Breadcrumb\"><ol class=\"list list--plain\"><li><a href=\"/admin/content\"><span data-bl-t=\"label\">Content</span></a></li><li><a href=\"/admin/content/example\"><span data-bl-t=\"label\">Our Story</span></a></li><li><span aria-current=\"page\"><span data-bl-t=\"label\">New</span></span></li></ol></nav><form class=\"ops-form\" enctype=\"multipart/form-data\" method=\"POST\" data-bl-k=\"form\" data-bl-form=\"\"><input type=\"hidden\" name=\"$ACTION_REF_1\"><input type=\"hidden\" name=\"$ACTION_1:0\" value=\"{&quot;id&quot;:&quot;60b61103b2addc69b359db95b24921d4f884d63d85&quot;,&quot;bound&quot;:&quot;$@1&quot;}\"><input type=\"hidden\" name=\"$ACTION_1:1\" value=\"[{}]\"><input type=\"hidden\" name=\"$ACTION_KEY\" value=\"ka1364a11dcc9101ca762c5b1ece1e171\"><input type=\"hidden\" name=\"table\" value=\"story_sections\"><input type=\"hidden\" name=\"idempotencyKey\" value=\"01M38J5YDN94K3D55PSWFQ40CZ\"><div class=\"ops-field\"><label for=\"field-slug\"><span data-bl-t=\"label\">Slug</span><!-- --><span data-bl-t=\"label\"> *</span></label><input id=\"field-slug\" class=\"ops-input\" required=\"\" type=\"text\" name=\"slug\" value=\"\" data-bl-s=\"\" data-bl-b=\"\"></div><div class=\"ops-field\"><label for=\"field-chapter\"><span data-bl-t=\"label\">Chapter</span><!-- --><span data-bl-t=\"label\"> *</span></label><select id=\"field-chapter\" name=\"chapter\" class=\"ops-input\" required=\"\" data-bl-s=\"\" data-bl-b=\"\"><option value=\"met\">met</option><option value=\"connection\">connection</option><option value=\"relationship\">relationship</option><option value=\"love\">love</option><option value=\"future\">future</option><option value=\"engagement\">engagement</option><option value=\"marriage\">marriage</option></select></div><div class=\"ops-field\"><label for=\"field-order\"><span data-bl-t=\"label\">Order</span><!-- --><span data-bl-t=\"label\"> *</span></label><input id=\"field-order\" class=\"ops-input\" required=\"\" type=\"number\" step=\"1\" inputmode=\"numeric\" name=\"order\" value=\"\" data-bl-s=\"\" data-bl-b=\"\"></div><div class=\"ops-field\"><label for=\"field-title\"><span data-bl-t=\"label\">Title</span><!-- --><span data-bl-t=\"label\"> *</span></label><input id=\"field-title\" class=\"ops-input\" required=\"\" type=\"text\" name=\"title\" value=\"\" data-bl-s=\"\" data-bl-b=\"\"></div><div class=\"ops-field\"><label for=\"field-paragraphs\"><span data-bl-t=\"label\">Paragraphs</span><!-- --><span data-bl-t=\"label\"> *</span></label><textarea id=\"field-paragraphs\" name=\"paragraphs\" class=\"ops-input\" aria-describedby=\"field-paragraphs-help\" required=\"\" rows=\"6\" data-bl-s=\"\" data-bl-b=\"\"></textarea><p id=\"field-paragraphs-help\" class=\"ops-hint\"><span data-bl-t=\"copy\">JSON array of strings, e.g. [\"one\", \"two\"]</span></p></div><div class=\"ops-field\"><label for=\"field-media\"><span data-bl-t=\"label\">Media refs</span></label><textarea id=\"field-media\" name=\"media\" class=\"ops-input\" aria-describedby=\"field-media-help\" rows=\"6\" data-bl-s=\"\" data-bl-b=\"\"></textarea><p id=\"field-media-help\" class=\"ops-hint\"><span data-bl-t=\"copy\">JSON array of { alt, caption?, src?, assetId? }</span></p></div><div class=\"ops-field\"><label for=\"field-sourceId\"><span data-bl-t=\"label\">Source (content_sources id