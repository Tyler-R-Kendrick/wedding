"><label for=\"field-validFrom\"><span data-bl-t=\"label\">Valid from</span></label><input id=\"field-validFrom\" class=\"ops-input\" type=\"text\" name=\"validFrom\" value=\"\" data-bl-s=\"\" data-bl-b=\"\"></div><div class=\"ops-field\"><label for=\"field-validUntil\"><span data-bl-t=\"label\">Valid until</span></label><input id=\"field-validUntil\" class=\"ops-input\" aria-describedby=\"field-validUntil-help\" type=\"text\" name=\"validUntil\" value=\"\" data-bl-s=\"\" data-bl-b=\"\"><p id=\"field-validUntil-help\" class=\"ops-hint\"><span data-bl-t=\"copy\">Past this instant the record is hidden from guests (e.g. a closed outlet).</span></p></div><div class=\"ops-field\"><label for=\"field-trustClass\"><span data-bl-t=\"label\">Trust class</span><!-- --><span data-bl-t=\"label\"> *</span></label><select id=\"field-trustClass\" name=\"trustClass\" class=\"ops-input\" required=\"\" data-bl-s=\"\" data-bl-b=\"\"><option value=\"TRUSTED_WEDDING\" selected=\"\">TRUSTED_WEDDING</option><option value=\"EXTERNAL_DATA\">EXTERNAL_DATA</option><option value=\"UNTRUSTED_USER_CONTENT\">UNTRUSTED_USER_CONTENT</option></select></div><div class=\"ops-field\"><label for=\"field-visibility\"><span data-bl-t=\"label\">Visibility</span><!-- --><span data-bl-t=\"label\"> *</span></label><select id=\"field-visibility\" name=\"visibility\" class=\"ops-input\" aria-describedby=\"field-visibility-help\" required=\"\" data-bl-s=\"\" data-bl-b=\"\"><option value=\"public\">public</option><option value=\"guest\">guest</option><option value=\"private-draft\" selected=\"\">private-draft</option></select><p id=\"field-visibility-help\" class=\"ops-hint\"><span data-bl-t=\"copy\">private-draft never reaches guests or the concierge.</span></p></div><div class=\"ops-field\"><div class=\"ops-check\"><input id=\"field-placeholder\" type=\"checkbox\" aria-describedby=\"field-placeholder-help\" name=\"placeholder\"><label for=\"field-placeholder\"><span data-bl-t=\"label\">Placeholder (contains TODO(Tyler &amp; Sara))</span></label></div><p id=\"field-placeholder-help\" class=\"ops-hint\"><span data-bl-t=\"copy\">Required to be on while any text contains the TODO marker.</span></p></div><div class=\"ops-form-inline\"><button class=\"ops-button ops-button-primary\" type=\"submit\" data-bl-s=\"\" data-bl-dark=\"\"><span data-bl-t=\"label\">Create Our Story</span></button><span class=\"con-index__blurb\"><span data-bl-t=\"copy\">Saving keeps the previous version and bumps the content version.</span></span></div></form></main><!--$--><!--/$--></div>"
