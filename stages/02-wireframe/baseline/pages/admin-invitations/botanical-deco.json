 "body": "<div hidden=\"\"><!--$--><!--/$--></div><p id=\"design-announcer\" class=\"sr-only\" aria-live=\"polite\" aria-atomic=\"true\"></p><div class=\"admin-root\"><a class=\"skip\" href=\"#main\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><nav aria-label=\"Admin\" class=\"con-nav\" data-bl-b=\"\" data-bl-k=\"nav\" data-bl-label=\"Admin\"><ul class=\"list list--plain con-nav__bar\"><li><a href=\"/admin\"><span data-bl-t=\"label\">Admin</span></a></li><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a></li><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit</span></a></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a></li></ul><details><summary><span data-bl-t=\"label\">All admin screens</span></summary><div class=\"con-index\"><section aria-labelledby=\"nav-site\" data-bl-k=\"section\" data-bl-label=\"The site\"><p id=\"nav-site\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The site</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What state guests see, what the calendar suggests, and previewing another state.</span></span></li><li><a href=\"/admin/flags\"><span data-bl-t=\"label\">Feature flags</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Both halves of every gate, and the two legal switches that stay shut.</span></span></li><li><a href=\"/admin/content\"><span data-bl-t=\"label\">Content</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Records with provenance, freshness and verification.</span></span></li><li><a href=\"/admin/events\"><span data-bl-t=\"label\">Events &amp; RSVP window</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Events, meal options, notices, and when RSVP opens.</span></span></li></ul></section><section aria-labelledby=\"nav-guests\" data-bl-k=\"section\" data-bl-label=\"Guests\"><p id=\"nav-guests\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Guests</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/guests\"><span data-bl-t=\"label\">Guests</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">People, households they belong to, identity resets.</span></span></li><li><a href=\"/admin/households\"><span data-bl-t=\"label\">Households</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Household records and mailing addresses.</span></span></li><li><a href=\"/admin/invitations\"><span data-bl-t=\"label\">Invitations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Issue, rotate and revoke invitation links.</span></span></li><li><a href=\"/admin/rsvp\"><span data-bl-t=\"label\">RSVPs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Who has replied, overrides and exports.</span></span></li><li><a href=\"/admin/seating\"><span data-bl-t=\"label\">Seating</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Tables, assignments and publishing the chart.</span></span></li></ul></section><section aria-labelledby=\"nav-weekend\" data-bl-k=\"section\" data-bl-label=\"The weekend\"><p id=\"nav-weekend\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The weekend</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/travel\"><span data-bl-t=\"label\">Travel &amp; stay</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Hotels, links and the room block.</span></span></li><li><a href=\"/admin/transport\"><span data-bl-t=\"label\">Transport</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Benefit entitlements and voucher codes.</span></span></li><li><a href=\"/admin/gifts\"><span data-bl-t=\"label\">Gifts</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Registry and gift links.</span></span></li><li><a href=\"/admin/reservations\"><span data-bl-t=\"label\">Reservations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Venues guests can book through.</span></span></li></ul></section><section aria-labelledby=\"nav-media\" data-bl-k=\"section\" data-bl-label=\"Media &amp; AI\"><p id=\"nav-media\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Media &amp; AI</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/media\"><span data-bl-t=\"label\">Media</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Moderation queue, imports and duplicates.</span></span></li><li><a href=\"/admin/ai\"><span data-bl-t=\"label\">Media AI</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Captions, indexing and what the model may touch.</span></span></li><li><a href=\"/admin/concierge\"><span data-bl-t=\"label\">Concierge</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Answer traces, grounding failures, security alerts.</span></span></li></ul></section><section aria-labelledby=\"nav-operations\" data-bl-k=\"section\" data-bl-label=\"Operations\"><p id=\"nav-operations\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Operations</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit trail</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Every action anyone took, searchable, redacted.</span></span></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Queue depth, failures and retries.</span></span></li><li><a href=\"/admin/metrics\"><span data-bl-t=\"label\">Metrics</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What this deployment recorded, and whether it is recording.</span></span></li><li><a href=\"/admin/providers\"><span data-bl-t=\"label\">Providers</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Which adapter each integration resolved to, and what it can do.</span></span></li></ul></section></div></details></nav><main id=\"main\" class=\"ops\" data-bl-k=\"main\" data-bl-label=\"Invitations\"><div class=\"con-head\"><div><h1 class=\"ops-title\"><span data-bl-t=\"heading\">Invitations</span></h1><p class=\"ops-lede\"><span data-bl-t=\"copy\">Links are discovery only: they show who is invited and start a claim. Tokens are never stored; rotate a link if it leaks.</span></p></div></div><section id=\"issue-a-link\" class=\"ops-section\" aria-labelledby=\"issue-a-link-heading\" data-bl-k=\"section\" data-bl-label=\"Issue a link\"><h2 id=\"issue-a-link-heading\" class=\"ops-h2\"><span data-bl-t=\"heading\">Issue a link</span></h2><form class=\"ops-form\" enctype=\"multipart/form-data\" method=\"POST\" data-bl-k=\"form\" data-bl-form=\"\"><input type=\"hidden\" name=\"$ACTION_REF_1\"><input type=\"hidden\" name=\"$ACTION_1:0\" value=\"{&quot;id&quot;:&quot;60f2604fc538a432535573a6ceb62c711ddcad18a4&quot;,&quot;bound&quot;:&quot;$@1&quot;}\"><input type=\"hidden\" name=\"$ACTION_1:1\" value=\"[{&quot;ok&quot;:false}]\"><input type=\"hidden\" name=\"$ACTION_KEY\" value=\"k8371f51690f0c70dd0e9e0b99fc82c7b\"><div class=\"ops-field\"><label for=\"issue-household\"><span data-bl-t=\"label\">Household</span></label><select id=\"issue-household\" name=\"householdId\" class=\"ops-input\" required=\"\" data-bl-s=\"\" data-bl-b=\"\"><option value=\"01E2EHHB000000000000000000\">Fixture household</option><option value=\"01E2EHHC000000000000000000\">Solo household</option><option value=\"01E2EHHA000000000000000000\">Testhouse household</option></select></div><div class=\"ops-field\"><label for=\"issue-events\"><span data-bl-t=\"label\">Event keys</span></label><span class=\"ops-hint\"><span data-bl-t=\"copy\">Semicolon-separated, e.g. ceremony; reception</span></span><input id=\"issue-events\" class=\"ops-input\" name=\"eventKeys\" value=\"ceremony; reception\" data-bl-s=\"\" data-bl-b=\"\"></div><div class=\"ops-field\"><label for=\"issue-plus\"><span data-bl-t=\"label\">Plus-ones allowed</span></label><input id=\"issue-plus\" type=\"number\" min=\"0\" max=\"10\" class=\"ops-input\" name=\"plusOneAllowance\" value=\"0\" data-bl-s=\"\" data-bl-b=\"\"></div><div class=\"ops-field\"><label for=\"issue-children\"><span data-bl-t=\"label\">Children allowed</span></label><input id=\"issue-children\" type=\"number\" min=\"0\" max=\"20\" class=\"ops-input\" name=\"childrenAllowance\" value=\"0\" data-bl-s=\"\" data-bl-b=\"\"></div><div class=\"ops-field\"><button type=\"submit\" class=\"ops-button ops-button-primary\" data-bl-s=\"\" data-bl-dark=\"\"><span data-bl-t=\"label\">Issue link</span></button></div></form></section><section id=\"all-links\" class=\"ops-section\" aria-labelledby=\"all-links-heading\" data-bl-k=\"section\" data-bl-label=\"All links\"><h2 id=\"all-links-heading\" class=\"ops-h2\"><span data-bl-t=\"heading\">All links</span></h2><p class=\"con-caption con-caption--standalone\"><span data-bl-t=\"copy\">Invitation links</span></p><p class=\"con-empty-note\" role=\"status\" data-bl-b=\"\"><span data-bl-t=\"copy\">No invitation link has been issued yet.</span></p></section></main><!--$--><!--/$--></div>"
