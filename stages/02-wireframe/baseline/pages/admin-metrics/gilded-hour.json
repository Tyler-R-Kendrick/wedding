 "body": "<div hidden=\"\"><!--$--><!--/$--></div><p id=\"design-announcer\" class=\"sr-only\" aria-live=\"polite\" aria-atomic=\"true\"></p><div class=\"admin-root\"><a class=\"skip\" href=\"#main\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><nav aria-label=\"Admin\" class=\"con-nav\" data-bl-b=\"\" data-bl-k=\"nav\" data-bl-label=\"Admin\"><ul class=\"list list--plain con-nav__bar\"><li><a href=\"/admin\"><span data-bl-t=\"label\">Admin</span></a></li><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a></li><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit</span></a></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a></li></ul><details><summary><span data-bl-t=\"label\">All admin screens</span></summary><div class=\"con-index\"><section aria-labelledby=\"nav-site\" data-bl-k=\"section\" data-bl-label=\"The site\"><p id=\"nav-site\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The site</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What state guests see, what the calendar suggests, and previewing another state.</span></span></li><li><a href=\"/admin/flags\"><span data-bl-t=\"label\">Feature flags</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Both halves of every gate, and the two legal switches that stay shut.</span></span></li><li><a href=\"/admin/content\"><span data-bl-t=\"label\">Content</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Records with provenance, freshness and verification.</span></span></li><li><a href=\"/admin/events\"><span data-bl-t=\"label\">Events &amp; RSVP window</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Events, meal options, notices, and when RSVP opens.</span></span></li></ul></section><section aria-labelledby=\"nav-guests\" data-bl-k=\"section\" data-bl-label=\"Guests\"><p id=\"nav-guests\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Guests</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/guests\"><span data-bl-t=\"label\">Guests</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">People, households they belong to, identity resets.</span></span></li><li><a href=\"/admin/households\"><span data-bl-t=\"label\">Households</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Household records and mailing addresses.</span></span></li><li><a href=\"/admin/invitations\"><span data-bl-t=\"label\">Invitations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Issue, rotate and revoke invitation links.</span></span></li><li><a href=\"/admin/rsvp\"><span data-bl-t=\"label\">RSVPs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Who has replied, overrides and exports.</span></span></li><li><a href=\"/admin/seating\"><span data-bl-t=\"label\">Seating</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Tables, assignments and publishing the chart.</span></span></li></ul></section><section aria-labelledby=\"nav-weekend\" data-bl-k=\"section\" data-bl-label=\"The weekend\"><p id=\"nav-weekend\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The weekend</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/travel\"><span data-bl-t=\"label\">Travel &amp; stay</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Hotels, links and the room block.</span></span></li><li><a href=\"/admin/transport\"><span data-bl-t=\"label\">Transport</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Benefit entitlements and voucher codes.</span></span></li><li><a href=\"/admin/gifts\"><span data-bl-t=\"label\">Gifts</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Registry and gift links.</span></span></li><li><a href=\"/admin/reservations\"><span data-bl-t=\"label\">Reservations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Venues guests can book through.</span></span></li></ul></section><section aria-labelledby=\"nav-media\" data-bl-k=\"section\" data-bl-label=\"Media &amp; AI\"><p id=\"nav-media\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Media &amp; AI</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/media\"><span data-bl-t=\"label\">Media</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Moderation queue, imports and duplicates.</span></span></li><li><a href=\"/admin/ai\"><span data-bl-t=\"label\">Media AI</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Captions, indexing and what the model may touch.</span></span></li><li><a href=\"/admin/concierge\"><span data-bl-t=\"label\">Concierge</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Answer traces, grounding failures, security alerts.</span></span></li></ul></section><section aria-labelledby=\"nav-operations\" data-bl-k=\"section\" data-bl-label=\"Operations\"><p id=\"nav-operations\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Operations</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit trail</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Every action anyone took, searchable, redacted.</span></span></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Queue depth, failures and retries.</span></span></li><li><a href=\"/admin/metrics\"><span data-bl-t=\"label\">Metrics</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What this deployment recorded, and whether it is recording.</span></span></li><li><a href=\"/admin/providers\"><span data-bl-t=\"label\">Providers</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Which adapter each integration resolved to, and what it can do.</span></span></li></ul></section></div></details></nav><main id=\"main\" class=\"ops\" data-bl-k=\"main\" data-bl-label=\"Metrics\"><div class=\"con-head\"><div><h1 class=\"ops-title\"><span data-bl-t=\"heading\">Metrics</span></h1><p class=\"ops-lede\"><span data-bl-t=\"copy\">What this deployment recorded about itself. No third-party telemetry is sent anywhere.</span></p></div><div class=\"con-head__actions\"><nav aria-label=\"Time window\" class=\"con-window\" data-bl-k=\"nav\" data-bl-label=\"Time window\"><ul><li><a aria-label=\"Show the last 1 hours\" href=\"/admin/metrics\" data-bl-b=\"\"><span data-bl-t=\"label\">1h</span></a></li><li><a aria-current=\"page\" aria-label=\"Show the last 1 days\" href=\"/admin/metrics\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">1d</span></a></li><li><a aria-label=\"Show the last 7 days\" href=\"/admin/metrics\" data-bl-b=\"\"><span data-bl-t=\"label\">7d</span></a></li><li><a aria-label=\"Show the last 30 days\" href=\"/admin/metrics\" data-bl-b=\"\"><span data-bl-t=\"label\">30d</span></a></li></ul></nav></div></div><p class=\"ops-notice\" role=\"status\" data-bl-s=\"\" data-bl-b=\"\"><span class=\"con-pill con-pill--warn\" data-bl-b=\"\"><span data-bl-t=\"copy\">Not recording</span></span><span data-bl-t=\"copy\"> This deployment has </span><code class=\"ops-code\"><span data-bl-t=\"copy\">METRICS_SINK=</span><!-- --><span data-bl-t=\"copy\">none</span></code><span data-bl-t=\"copy\">, so nothing is written to the table. An empty list below means nothing is being recorded, not that nothing happened.</span></p><div class=\"con-stats\" data-bl-b=\"\"><div class=\"con-stat\"><span class=\"con-stat__value\"><span data-bl-t=\"copy\">1d</span></span><span class=\"con-stat__label\"><span data-bl-t=\"copy\">Window</span></span><span class=\"con-stat__hint\"><span data-bl-t=\"copy\">since Sep 22, 2026, 20:41:04 CDT</span></span></div><div class=\"con-stat\"><span class=\"con-stat__value\"><span data-bl-t=\"copy\">0</span></span><span class=\"con-stat__label\"><span data-bl-t=\"copy\">Points</span></span><span class=\"con-stat__hint\"><span data-bl-t=\"copy\">0 series</span></span></div><div class=\"con-stat\"><span class=\"con-stat__value\"><span data-bl-t=\"copy\">100</span></span><span class=\"con-stat__label\"><span data-bl-t=\"copy\">Audit rows</span></span><span class=\"con-stat__hint\"><span data-bl-t=\"copy\">same window</span></span></div><div class=\"con-stat\"><span class=\"con-stat__value\"><span data-bl-t=\"copy\">0</span></span><span class=\"con-stat__label\"><span data-bl-t=\"copy\">Denied</span></span><span class=\"con-stat__hint\"><span data-bl-t=\"copy\">authorization refusals</span></span></div><div class=\"con-stat\"><span class=\"con-stat__value\"><span data-bl-t=\"copy\">30d</span></span><span class=\"con-stat__label\"><span data-bl-t=\"copy\">Retention</span></span><span class=\"con-stat__hint\"><span data-bl-t=\"copy\">housekeeping deletes older points</span></span></div></div><section id=\"series\" class=\"ops-section\" aria-labelledby=\"series-heading\" data-bl-k=\"section\" data-bl-label=\"Series\"><h2 id=\"series-heading\" class=\"ops-h2\"><span data-bl-t=\"heading\">Series</span></h2><p class=\"con-note\"><span data-bl-t=\"copy\">Counters report a total; histograms report the distribution. Percentiles are computed in the database over the window, not sampled.</span></p><p class=\"con-caption con-caption--standalone\"><span data-bl-t=\"copy\">Metric series over the last 24 hours</span></p><p class=\"con-empty-note\" role=\"status\" data-bl-b=\"\"><span data-bl-t=\"copy\">Metrics are switched off in this deployment.</span></p></section><section id=\"audit\" class=\"ops-section\" aria-labelledby=\"audit-heading\" data-bl-k=\"section\" data-bl-label=\"Audit volume\"><h2 id=\"audit-heading\" class=\"ops-h2\"><span data-bl-t=\"heading\">Audit volume</span></h2><p class=\"con-note\"><span data-bl-t=\"copy\">Counted over the same window. The rows themselves are on </span><a href=\"/admin/audit\"><span data-bl-t=\"copy\">the audit trail</span></a><span data-bl-t=\"copy\">.</span></p><div class=\"ops-table-wrap con-scroll\" tabindex=\"0\" data-bl-b=\"\"><table class=\"ops-table con-table\"><caption class=\"con-caption\" data-bl-b=\"\"><span data-bl-t=\"copy\">Audit rows by action in this window</span></caption><thead><tr><th scope=\"col\" data-bl-b=\"\"><span data-bl-t=\"label\">Action</span></th><th scope=\"col\" class=\"con-num\" data-bl-b=\"\"><span data-bl-t=\"label\">Rows</span></th></tr></thead><tbody><tr><th scope=\"row\" data-bl-b=\"\"><a href=\"/admin/audit\"><span data-bl-t=\"label\">capability.invoked</span></a></th><td class=\"con-num\"><span data-bl-t=\"copy\">100</span></td></tr></tbody></table></div></section><section id=\"elsewhere\" class=\"ops-section\" aria-labelledby=\"elsewhere-heading\" data-bl-k=\"section\" data-bl-label=\"What is not here\"><h2 id=\"elsewhere-heading\" class=\"ops-h2\"><span data-bl-t=\"heading\">What is not here</span></h2><p class=\"con-note\"><span data-bl-t=\"copy\">Storage bytes and the labelled cost estimate are on </span><a href=\"/admin/media/metrics\"><span data-bl-t=\"copy\">Media → Storage</span></a><span data-bl-t=\"copy\">. Provider modes and health are on</span><!-- --> <a href=\"/admin/providers\"><span data-bl-t=\"copy\">Providers</span></a><span data-bl-t=\"copy\">. Queue depth is on </span><a href=\"/admin/jobs\"><span data-bl-t=\"copy\">Jobs</span></a><span data-bl-t=\"copy\">. Nothing here invents a price.</span></p></section></main><!--$--><!--/$--></div>"
