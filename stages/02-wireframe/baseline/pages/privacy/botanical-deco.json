 "body": "<div hidden=\"\"><!--$--><!--/$--></div><div class=\"site bd\" data-theme=\"botanical-deco\" data-bottom-bar=\"\" data-lifecycle=\"TEASER\" data-bl-s=\"\"><a class=\"skip-link\" href=\"#main\" data-bl-s=\"\" data-bl-dark=\"\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><header class=\"bd-masthead\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"header\" data-bl-label=\"Menu\"><div class=\"bd-masthead__inner\"><a class=\"bd-masthead__home\" href=\"/\"><span class=\"bd-monogram\" aria-hidden=\"true\"><span class=\"bd-monogram__s\"><span data-bl-t=\"label\">S</span></span><span class=\"bd-monogram__stem\" data-bl-s=\"\"></span><span class=\"bd-monogram__t\"><span data-bl-t=\"label\">T</span></span></span><span class=\"sr-only\"><span data-bl-t=\"label\">Sara + Tyler</span><!-- --><span data-bl-t=\"label\">: </span><!-- --><span data-bl-t=\"label\">Home</span></span></a><nav class=\"bd-nav\" aria-label=\"Site\" data-bl-k=\"nav\" data-bl-label=\"Site\"><ul class=\"bd-nav__list\" data-fit-list=\"\"><li><a class=\"bd-nav__link\" href=\"/\"><span><span data-bl-t=\"label\">Home</span></span></a></li><li><a class=\"bd-nav__link\" href=\"/our-story\"><span><span data-bl-t=\"label\">Our Story</span></span></a></li><li><a class=\"bd-nav__link\" href=\"/our-adventures\"><span><span data-bl-t=\"label\">Our Adventures</span></span></a></li><li><a class=\"bd-nav__link\" href=\"/sign-in\"><span data-bl-t=\"label\">Sign in</span></a></li></ul><div class=\"bd-masthead__menu\" data-fit-menu=\"\"><button type=\"button\" class=\"bd-menu-trigger\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-controls=\"site-menu\" data-bl-s=\"\" data-bl-b=\"\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg><span><span data-bl-t=\"label\">Menu</span></span></button><dialog id=\"site-menu\" class=\"bd-sheet\" aria-labelledby=\"_R_ib5esnekndlb_\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"dialog\" data-bl-label=\"Menu\"><div class=\"bd-sheet__panel\"><img class=\"bd-bloom bd-bloom--sheet\" src=\"/media/botanical-deco/botanical/sprig-right-128.webp\" width=\"128\" height=\"146\" alt=\"\" aria-hidden=\"true\" loading=\"lazy\" decoding=\"async\" data-media=\"botanical.sprig-right\" data-bl-m=\"art\"><div class=\"bd-sheet__header\" data-bl-b=\"\"><h2 id=\"_R_ib5esnekndlb_\" class=\"bd-sheet__title\"><span data-bl-t=\"heading\">Menu</span></h2><button type=\"button\" class=\"bd-btn bd-btn--secondary bd-sheet__close\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">Close</span></button></div><div class=\"bd-sheet__body\"><ul class=\"bd-menu\"><li><a class=\"bd-menu__link\" href=\"/\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Home</span></span></a></li><li><a class=\"bd-menu__link\" href=\"/our-story\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Our Story</span></span></a></li><li><a class=\"bd-menu__link\" href=\"/our-adventures\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Our Adventures</span></span></a></li><li><a class=\"bd-menu__link\" href=\"/sign-in\" data-bl-b=\"\"><span data-bl-t=\"label\">Sign in</span></a></li></ul></div></div></dialog></div></nav><p class=\"bd-masthead__motto\" aria-hidden=\"true\" data-fit-extra=\"\"><span class=\"bd-masthead__rule\" data-bl-s=\"\"></span><span class=\"bd-script\"><span data-bl-t=\"label\">Love, peace &amp; happiness</span></span></p><span hidden=\"\" data-nav-fit=\"priority\"></span></div></header><main id=\"main\" class=\"bd-main\" tabindex=\"-1\" data-bl-k=\"main\" data-bl-label=\"Privacy\"><article class=\"credits legal\" aria-labelledby=\"page-title\" data-bl-k=\"article\" data-bl-label=\"Privacy\"><header class=\"credits__head\" data-bl-k=\"header\" data-bl-label=\"Privacy\"><p class=\"credits__eyebrow\"><span data-bl-t=\"copy\">For our guests</span></p><h1 id=\"page-title\" class=\"credits__title\"><span data-bl-t=\"heading\">Privacy</span></h1><p class=\"credits__lede\"><span data-bl-t=\"copy\">This is a private wedding website for Sara and Tyler’s invited guests. This page explains, in plain language, what we collect and how we use it.</span></p><p class=\"credits__lede\"><small><span data-bl-t=\"copy\">Last updated </span><!-- --><span data-bl-t=\"copy\">November 1, 2026</span><!-- --><span data-bl-t=\"copy\">.</span></small></p></header><section id=\"who\" class=\"credits__section\" aria-labelledby=\"who-title\" data-bl-k=\"section\" data-bl-label=\"Who this site is for\"><h2 id=\"who-title\" class=\"credits__h2\" data-bl-b=\"\"><span data-bl-t=\"heading\">Who this site is for</span></h2><p><span data-bl-t=\"copy\">The site at kendrick.wedding is not a public social network. It is meant for people Sara and Tyler invited to their wedding and the couple who run it.</span></p></section><section id=\"collect\" class=\"credits__section\" aria-labelledby=\"collect-title\" data-bl-k=\"section\" data-bl-label=\"What we collect\"><h2 id=\"collect-title\" class=\"credits__h2\" data-bl-b=\"\"><span data-bl-t=\"heading\">What we collect</span></h2><ul class=\"credits__list\"><li class=\"credits__item\"><p class=\"credits__name\"><span data-bl-t=\"copy\">Guest and household information</span></p><p><span data-bl-t=\"copy\">Names, email addresses, optional phone numbers, RSVP answers, meal and dietary choices, plus-one details, and other weekend details you or the couple enter for your household.</span></p></li><li class=\"credits__item\"><p class=\"credits__name\"><span data-bl-t=\"copy\">Sign-in</span></p><p><span data-bl-t=\"copy\">Email addresses for one-time codes; phone numbers when you choose text sign-in (handled by Twilio Verify); and, if you use it, basic profile name and email from Google or Facebook so we can match you to the guest list by name. We do not receive your social passwords.</span></p></li><li class=\"credits__item\"><p class=\"credits__name\"><span data-bl-t=\"copy\">Technical logs</span></p><p><span data-bl-t=\"copy\">Standard hosting logs (for example request timing and errors) to keep the site running. We do not use them for advertising.</span></p></li></ul></section><section id=\"use\" class=\"credits__section\" aria-labelledby=\"use-title\" data-bl-k=\"section\" data-bl-label=\"How we use it\"><h2 id=\"use-title\" class=\"credits__h2\" data-bl-b=\"\"><span data-bl-t=\"heading\">How we use it</span></h2><p><span data-bl-t=\"copy\">We use this information to run the wedding website: invitations, RSVP, travel tips for guests, photos, gifts, and messages between you and the couple. We do not sell your data or share it for marketing.</span></p></section><section id=\"processors\" class=\"credits__section\" aria-labelledby=\"processors-title\" data-bl-k=\"section\" data-bl-label=\"Services that help us run the site\"><h2 id=\"processors-title\" class=\"credits__h2\" data-bl-b=\"\"><span data-bl-t=\"heading\">Services that help us run the site</span></h2><ul class=\"credits__list\"><li class=\"credits__item\"><p><strong><span data-bl-t=\"copy\">Vercel</span></strong><span data-bl-t=\"copy\"> hosts the site.</span></p></li><li class=\"credits__item\"><p><strong><span data-bl-t=\"copy\">Neon</span></strong><span data-bl-t=\"copy\"> stores the database.</span></p></li><li class=\"credits__item\"><p><strong><span data-bl-t=\"copy\">Resend</span></strong><span data-bl-t=\"copy\"> sends sign-in codes and other email from the site.</span></p></li><li class=\"credits__item\"><p><strong><span data-bl-t=\"copy\">Twilio Verify</span></strong><span data-bl-t=\"copy\"> sends text sign-in codes when you choose that option.</span></p></li><li class=\"credits__item\"><p><strong><span data-bl-t=\"copy\">Google</span></strong><span data-bl-t=\"copy\"> and </span><strong><span data-bl-t=\"copy\">Facebook</span></strong><span data-bl-t=\"copy\"> only when you choose “Continue with Google” or Facebook sign-in; they provide basic profile fields for matching, not posts or friends lists.</span></p></li></ul><p><span data-bl-t=\"copy\">These companies process data on our behalf under their own terms and privacy policies.</span></p></section><section id=\"choices\" class=\"credits__section\" aria-labelledby=\"choices-title\" data-bl-k=\"section\" data-bl-label=\"Your choices\"><h2 id=\"choices-title\" class=\"credits__h2\" data-bl-b=\"\"><span data-bl-t=\"heading\">Your choices</span></h2><p><span data-bl-t=\"copy\">You can ask Sara and Tyler to update or delete information we hold about you. Use</span><!-- --> <a href=\"/guests/ask-us\"><span data-bl-t=\"copy\">Ask Us</span></a><span data-bl-t=\"copy\"> once you are signed in, or contact them the way you already do for wedding questions.</span></p></section><section id=\"more\" class=\"credits__section\" aria-labelledby=\"more-title\" data-bl-k=\"section\" data-bl-label=\"Terms\"><h2 id=\"more-title\" class=\"credits__h2\" data-bl-b=\"\"><span data-bl-t=\"heading\">Terms</span></h2><p><span data-bl-t=\"copy\">See also our </span><a href=\"/terms\"><span data-bl-t=\"copy\">Terms of use</span></a><span data-bl-t=\"copy\">.</span></p></section></article></main><nav class=\"bd-bar\" aria-label=\"Quick actions\" style=\"--cells:2\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"nav\" data-bl-label=\"Quick actions\"><a class=\"bd-bar__cell\" href=\"/our-story\" data-bl-b=\"\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M4 5h7a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2H4zM20 5h-7a2 2 0 0 0-2 2v13a2 2 0 0 1 2-2h7z\"></path></svg><span><span data-bl-t=\"label\">Story</span></span></a><a class=\"bd-bar__cell\" href=\"/our-adventures\" data-bl-b=\"\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM15 9l-2 6-4 2 2-6z\"></path></svg><span><span data-bl-t=\"label\">Adventures</span></span></a></nav><footer class=\"bd-footer\" data-bl-s=\"\" data-bl-b=\"\" data-bl-k=\"footer\"><div class=\"bd-footer__inner\"><span class=\"bd-footer__skyline\" aria-hidden=\"true\" data-bl-s=\"\"></span><p class=\"bd-footer__motto\"><span data-bl-t=\"copy\">Love </span><span aria-hidden=\"true\"><span data-bl-t=\"label\">+</span></span><span data-bl-t=\"copy\"> peace </span><span aria-hidden=\"true\"><span data-bl-t=\"label\">+</span></span><span data-bl-t=\"copy\"> happiness</span></p><p class=\"bd-footer__mark\" aria-hidden=\"true\"><span class=\"bd-footer__rule\" data-bl-s=\"\"></span><span class=\"bd-monogram\" aria-hidden=\"true\"><span class=\"bd-monogram__s\"><span data-bl-t=\"label\">S</span></span><span class=\"bd-monogram__stem\" data-bl-s=\"\"></span><span class=\"bd-monogram__t\"><span data-bl-t=\"label\">T</span></span></span></p><p class=\"bd-footer__facts\" data-bl-b=\"\"><span><span data-bl-t=\"copy\">Sara + Tyler</span></span></p><p class=\"bd-footer__credits\"><a class=\"bd-link bd-link--standalone\" href=\"/credits\"><span data-bl-t=\"copy\">Photo credits</span></a></p><p class=\"bd-footer__credits\"><a class=\"bd-link bd-link--standalone\" href=\"/privacy\"><span data-bl-t=\"copy\">Privacy</span></a><span data-bl-t=\"copy\"> · </span><a class=\"bd-link bd-link--standalone\" href=\"/terms\"><span data-bl-t=\"copy\">Terms</span></a></p><p class=\"bd-footer__credits\"><a class=\"bd-link bd-link--standalone\" href=\"/sign-in\"><span data-bl-t=\"copy\">Sign in</span></a></p><ul class=\"bd-footer__print\"></ul></div></footer></div><!--$--><!--/$-->"
