 "body": "<div hidden=\"\"><!--$--><!--/$--></div><p id=\"design-announcer\" class=\"sr-only\" aria-live=\"polite\" aria-atomic=\"true\"></p><div class=\"site gh\" data-theme=\"gilded-hour\" data-bottom-bar=\"\" data-lifecycle=\"TEASER\" data-bl-s=\"\" data-bl-b=\"\"><a class=\"skip-link\" href=\"#main\" data-bl-s=\"\" data-bl-dark=\"\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><header class=\"gh-header\" data-bl-b=\"\" data-bl-k=\"header\" data-bl-label=\"Menu\"><nav class=\"gh-frieze\" aria-label=\"Site\" data-bl-k=\"nav\" data-bl-label=\"Site\"><ul class=\"gh-frieze__side gh-frieze__side--left\"><li><a class=\"gh-nav__link\" href=\"/our-story\"><span><span data-bl-t=\"label\">Our Story</span></span></a></li><li><a class=\"gh-nav__link\" href=\"/our-adventures\"><span><span data-bl-t=\"label\">Our Adventures</span></span></a></li><li><a class=\"gh-nav__link\" href=\"/explore-caa\"><span><span data-bl-t=\"label\">Explore CAA</span></span></a></li></ul><a class=\"gh-plaque-link\" href=\"/\"><span class=\"gh-plaque gh-plaque--mono\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">S+T</span></span><span class=\"sr-only\"><span data-bl-t=\"label\">Sara + Tyler</span><!-- --><span data-bl-t=\"label\">: </span><!-- --><span data-bl-t=\"label\">Home</span></span></a><ul class=\"gh-frieze__side gh-frieze__side--right\"><li><a class=\"gh-nav__link\" href=\"/ask-us\"><span><span data-bl-t=\"label\">Ask Us</span></span></a></li><li><a class=\"gh-nav__link\" href=\"/photos\"><span><span data-bl-t=\"label\">Photos &amp; Video</span></span></a></li><li><a class=\"gh-nav__link\" href=\"/sign-out\"><span><span data-bl-t=\"label\">Sign out</span></span></a></li></ul><div class=\"gh-frieze__menu\"><button type=\"button\" class=\"gh-nav__menu\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-controls=\"site-menu\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg><span><span data-bl-t=\"label\">Menu</span></span></button><dialog id=\"site-menu\" class=\"gh-dialog\" aria-labelledby=\"_R_25knelb_\" data-bl-k=\"dialog\" data-bl-label=\"Menu\"><div class=\"gh-dialog__panel\" data-bl-s=\"\"><div class=\"gh-dialog__header\" data-bl-b=\"\"><h2 id=\"_R_25knelb_\" class=\"gh-dialog__title\"><span data-bl-t=\"heading\">Menu</span></h2><button type=\"button\" class=\"gh-btn gh-btn--ghost gh-dialog__close\" data-bl-s=\"\"><span data-bl-t=\"label\">Close</span></button></div><div class=\"gh-dialog__body\"><ul class=\"gh-menu\"><li><a class=\"gh-menu__link\" href=\"/\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Home</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/our-story\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Our Story</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/our-adventures\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Our Adventures</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/explore-caa\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Explore CAA</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/ask-us\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Ask Us</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/photos\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Photos &amp; Video</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/sign-out\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Sign out</span></span></a></li></ul></div></div></dialog></div></nav></header><main id=\"main\" class=\"gh-main\" tabindex=\"-1\" data-bl-k=\"main\" data-bl-label=\"Getting here, getting around, getting home.\"><div class=\"page\"><header data-bl-k=\"header\" data-bl-label=\"Getting here, getting around, getting home.\"><h1 class=\"page__title\"><span data-bl-t=\"heading\">Getting here, getting around, getting home.</span></h1><p class=\"page__lede\"><span data-bl-t=\"copy\">The wedding is at the Chicago Athletic Association Hotel, 12 S Michigan Ave. Everything below is meant to take the guesswork out of the day so you can relax and dance.</span></p></header><section id=\"ride-benefit\" class=\"gh-gsec\" aria-labelledby=\"ride-benefit-title\" data-bl-k=\"section\" data-bl-label=\"Your ride home\"><h2 id=\"ride-benefit-title\" class=\"gh-h gh-h--2 gh-gsec__title\"><span data-bl-t=\"heading\">Your ride home</span></h2><div class=\"gh-gsec__body\"><p class=\"mt-3 measure\"><span data-bl-t=\"copy\">There is no ride benefit on your invitation yet. If you were expecting one, ask us and we will sort it out.</span></p></div></section><section id=\"topic-arriving\" class=\"gh-gsec\" aria-labelledby=\"topic-arriving-title\" data-bl-k=\"section\" data-bl-label=\"Arriving in Chicago\"><hr class=\"gh-divider gh-gsec__rule\" data-bl-s=\"\"><h2 id=\"topic-arriving-title\" class=\"gh-h gh-h--2 gh-gsec__title\"><span data-bl-t=\"heading\">Arriving in Chicago</span></h2><div class=\"gh-gsec__body\"><div class=\"mt-3 space-y-3\"><p class=\"measure\"><span data-bl-t=\"copy\">Chicago has two airports, O’Hare (ORD) and Midway (MDW). Both connect to downtown by train, taxi and rideshare.</span></p><div class=\"placeholder\" data-placeholder=\"true\" role=\"note\" data-bl-s=\"\" data-bl-b=\"\"><span class=\"placeholder__label\"><span data-bl-t=\"copy\">Sara + Tyler are still writing this:</span></span> <p class=\"placeholder__hint\"><span data-bl-t=\"copy\">which airport we recommend, and whether there will be a shuttle.</span></p></div></div><p class=\"mt-4 flex flex-wrap gap-x-6 gap-y-2\"><a class=\"inline-flex min-h-11 items-center underline underline-offset-4\" href=\"https://www.google.com/maps/dir/?api=1&amp;destination=Chicago+Athletic+Association+Hotel%2C+12+S+Michigan+Ave%2C+Chicago%2C+IL+60603&amp;travelmode=transit\" target=\"_blank\" rel=\"noopener noreferrer\"><span data-bl-t=\"copy\">Directions to the hotel (transit) in Google Maps</span><span class=\"sr-only\"><span data-bl-t=\"copy\"> (opens in a new tab)</span></span></a><a class=\"inline-flex min-h-11 items-center underline underline-offset-4\" href=\"https://maps.apple.com/?daddr=Chicago+Athletic+Association+Hotel%2C+12+S+Michigan+Ave%2C+Chicago%2C+IL+60603&amp;dirflg=r\" target=\"_blank\" rel=\"noopener noreferrer\"><span data-bl-t=\"copy\">Directions to the hotel (transit) in Apple Maps</span><span class=\"sr-only\"><span data-bl-t=\"copy\"> (opens in a new tab)</span></span></a></p></div></section><section id=\"topic-do-i-need-a-car\" class=\"gh-gsec\" aria-labelledby=\"topic-do-i-need-a-car-title\" data-bl-k=\"section\" data-bl-label=\"Do I need a car?\"><hr class=\"gh-divider gh-gsec__rule\" data-bl-s=\"\"><h2 id=\"topic-do-i-need-a-car-title\" class=\"gh-h gh-h--2 gh-gsec__title\"><span data-bl-t=\"heading\">Do I need a car?</span></h2><div class=\"gh-gsec__body\"><div class=\"mt-3 space-y-3\"><p class=\"measure\"><span data-bl-t=\"copy\">The hotel is on Michigan Avenue across from Millennium Park; the wedding happens inside the building, so a car is not needed for the day itself.</span></p><p class=\"measure\"><span data-bl-t=\"copy\">If you drive in, the hotel’s valet entrance is at 71 E Madison.</span></p><div class=\"placeholder\" data-placeholder=\"true\" role=\"note\" data-bl-s=\"\" data-bl-b=\"\"><span class=\"placeholder__label\"><span data-bl-t=\"copy\">Sara + Tyler are still writing this:</span></span> <p class=\"placeholder__hint\"><span data-bl-t=\"copy\">the special event valet rate from the venue kit, once verified.</span></p></div></div><p class=\"mt-4 flex flex-wrap gap-x-6 gap-y-2\"><a class=\"inline-flex min-h-11 items-center underline underline-offset-4\" href=\"https://www.google.com/maps/dir/?api=1&amp;destination=Chicago+Athletic+Association+valet+entrance%2C+71+E+Madison+St%2C+Chicago%2C+IL+60602&amp;travelmode=driving\" target=\"_blank\" rel=\"noopener noreferrer\"><span data-bl-t=\"copy\">Directions to the valet entrance (driving) in Google Maps</span><span class=\"sr-only\"><span data-bl-t=\"copy\"> (opens in a new tab)</span></span></a><a class=\"inline-flex min-h-11 items-center underline underline-offset-4\" href=\"https://maps.apple.com/?daddr=Chicago+Athletic+Association+valet+entrance%2C+71+E+Madison+St%2C+Chicago%2C+IL+60602&amp;dirflg=d\" target=\"_blank\" rel=\"noopener noreferrer\"><span data-bl-t=\"copy\">Directions to the valet entrance (driving) in Apple Maps</span><span class=\"sr-only\"><span data-bl-t=\"copy\"> (opens in a new tab)</span></span></a></p></div></section><section id=\"topic-getting-around\" class=\"gh-gsec\" aria-labelledby=\"topic-getting-around-title\" data-bl-k=\"section\" data-bl-label=\"Getting around: trains, buses, taxis\"><hr class=\"gh-divider gh-gsec__rule\" data-bl-s=\"\"><h2 id=\"topic-getting-around-title\" class=\"gh-h gh-h--2 gh-gsec__title\"><span data-bl-t=\"heading\">Getting around: trains, buses, taxis</span></h2><div class=\"gh-gsec__body\"><div class=\"mt-3 space-y-3\"><p class=\"measure\"><span data-bl-t=\"copy\">The CTA runs Chicago’s trains and buses. Taxis and rideshares drop off at the valet entrance on Madison.</span></p><p class=\"measure\"><span data-bl-t=\"copy\">The hotel publishes transit and accessibility directions on its FAQ page, including step-free routes into the building.</span></p></div><article class=\"border-t border-primary/20 py-6\" data-handoff-provider=\"chicagoathletichotel\" data-handoff-host=\"www.chicagoathletichotel.com\" data-bl-b=\"\" data-bl-k=\"article\" data-bl-label=\"On the hotel’s site\"><div class=\"flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1\"><h3 class=\"text-xl\"><span data-bl-t=\"heading\">On the hotel’s site</span></h3><p class=\"hint\"><span data-bl-t=\"copy\">via </span><!-- --><span data-bl-t=\"copy\">the Chicago Athletic Association</span></p></div><div class=\"mt-2 hint\"><span><span data-bl-t=\"copy\">Checked </span><time datetime=\"2026-09-04T00:00:00.000Z\"><span data-bl-t=\"copy\">September 4, 2026</span></time></span></div><p class=\"mt-4\"><a class=\"btn btn--primary\" href=\"https://www.chicagoathletichotel.com/about/faq/\" target=\"_blank\" rel=\"noopener noreferrer\" data-bl-s=\"\" data-bl-dark=\"\" data-bl-b=\"\"><span data-bl-t=\"copy\">Transit and accessibility directions (hotel FAQ)</span><span aria-hidden=\"true\"><span data-bl-t=\"copy\">↗</span></span><span class=\"sr-only\"><span data-bl-t=\"copy\">(opens </span><!-- --><span data-bl-t=\"copy\">the Chicago Athletic Association</span><!-- --><span data-bl-t=\"copy\"> in a new tab)</span></span></a></p><p class=\"mt-3 measure hint\"><span data-bl-t=\"copy\">Opens the hotel’s official website.</span></p><p class=\"hidden print:block\"><span data-bl-t=\"copy\">https://www.chicagoathletichotel.com/about/faq/</span></p></article></div></section><section id=\"topic-getting-home\" class=\"gh-gsec\" aria-labelledby=\"topic-getting-home-title\" data-bl-k=\"section\" data-bl-label=\"Getting home after the reception\"><hr class=\"gh-divider gh-gsec__rule\" data-bl-s=\"\"><h2 id=\"topic-getting-home-title\" class=\"gh-h gh-h--2 gh-gsec__title\"><span data-bl-t=\"heading\">Getting home after the reception</span></h2><div class=\"gh-gsec__body\"><div class=\"mt-3 space-y-3\"><p class=\"measure\"><span data-bl-t=\"copy\">We want everyone home safely and without fuss. Eligible adult guests will find a ride benefit on this page once it is ready; the code or link is personal to you.</span></p><div class=\"placeholder\" data-placeholder=\"true\" role=\"note\" data-bl-s=\"\" data-bl-b=\"\"><span class=\"placeholder__label\"><span data-bl-t=\"copy\">Sara + Tyler are still writing this:</span></span> <p class=\"placeholder__hint\"><span data-bl-t=\"copy\">ride benefit amount, area and validity.</span></p></div></div></div></section><footer class=\"wp-guest-foot\" data-bl-k=\"footer\"><p class=\"hint\"><span data-bl-t=\"copy\">Questions? </span><a class=\"underline underline-offset-4\" href=\"/ask-us\"><span data-bl-t=\"copy\">Ask us</span></a><span data-bl-t=\"copy\">.</span></p></footer></div><!--$--><!--/$--></main><nav class=\"gh-panel\" aria-label=\"Quick actions\" style=\"--cells:4\"><a class=\"gh-panel__cell\" href=\"/our-story\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M4 5h7a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2H4zM20 5h-7a2 2 0 0 0-2 2v13a2 2 0 0 1 2-2h7z\"></path></svg><span><span data-bl-t=\"label\">Story</span></span></a><a class=\"gh-panel__cell\" href=\"/our-adventures\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM15 9l-2 6-4 2 2-6z\"></path></svg><span><span data-bl-t=\"label\">Adventures</span></span></a><a class=\"gh-panel__cell\" href=\"/explore-caa\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M5 21V5l7-3 7 3v16M9 9h2M13 9h2M9 13h2M13 13h2M11 21v-4h2v4\"></path></svg><span><span data-bl-t=\"label\">Explore CAA</span></span></a><a class=\"gh-panel__cell\" href=\"/ask-us\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M4 5h16v11H9l-5 4z\"></path></svg><span><span data-bl-t=\"label\">Ask us</span></span></a></nav><footer class=\"gh-footer\" data-bl-b=\"\" data-bl-k=\"footer\"><div clas