 "body": "<div hidden=\"\"><!--$--><!--/$--></div><p id=\"design-announcer\" class=\"sr-only\" aria-live=\"polite\" aria-atomic=\"true\"></p><div class=\"admin-root\"><a class=\"skip\" href=\"#main\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><nav aria-label=\"Admin\" class=\"con-nav\" data-bl-b=\"\" data-bl-k=\"nav\" data-bl-label=\"Admin\"><ul class=\"list list--plain con-nav__bar\"><li><a href=\"/admin\"><span data-bl-t=\"label\">Admin</span></a></li><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a></li><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit</span></a></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a></li></ul><details><summary><span data-bl-t=\"label\">All admin screens</span></summary><div class=\"con-index\"><section aria-labelledby=\"nav-site\" data-bl-k=\"section\" data-bl-label=\"The site\"><p id=\"nav-site\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The site</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/lifecycle\"><span data-bl-t=\"label\">Lifecycle</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What state guests see, what the calendar suggests, and previewing another state.</span></span></li><li><a href=\"/admin/flags\"><span data-bl-t=\"label\">Feature flags</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Both halves of every gate, and the two legal switches that stay shut.</span></span></li><li><a href=\"/admin/content\"><span data-bl-t=\"label\">Content</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Records with provenance, freshness and verification.</span></span></li><li><a href=\"/admin/events\"><span data-bl-t=\"label\">Events &amp; RSVP window</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Events, meal options, notices, and when RSVP opens.</span></span></li></ul></section><section aria-labelledby=\"nav-guests\" data-bl-k=\"section\" data-bl-label=\"Guests\"><p id=\"nav-guests\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Guests</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/guests\"><span data-bl-t=\"label\">Guests</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">People, households they belong to, identity resets.</span></span></li><li><a href=\"/admin/households\"><span data-bl-t=\"label\">Households</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Household records and mailing addresses.</span></span></li><li><a href=\"/admin/invitations\"><span data-bl-t=\"label\">Invitations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Issue, rotate and revoke invitation links.</span></span></li><li><a href=\"/admin/rsvp\"><span data-bl-t=\"label\">RSVPs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Who has replied, overrides and exports.</span></span></li><li><a href=\"/admin/seating\"><span data-bl-t=\"label\">Seating</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Tables, assignments and publishing the chart.</span></span></li></ul></section><section aria-labelledby=\"nav-weekend\" data-bl-k=\"section\" data-bl-label=\"The weekend\"><p id=\"nav-weekend\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">The weekend</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/travel\"><span data-bl-t=\"label\">Travel &amp; stay</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Hotels, links and the room block.</span></span></li><li><a href=\"/admin/transport\"><span data-bl-t=\"label\">Transport</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Benefit entitlements and voucher codes.</span></span></li><li><a href=\"/admin/gifts\"><span data-bl-t=\"label\">Gifts</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Registry and gift links.</span></span></li><li><a href=\"/admin/reservations\"><span data-bl-t=\"label\">Reservations</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Venues guests can book through.</span></span></li></ul></section><section aria-labelledby=\"nav-media\" data-bl-k=\"section\" data-bl-label=\"Media &amp; AI\"><p id=\"nav-media\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Media &amp; AI</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/media\"><span data-bl-t=\"label\">Media</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Moderation queue, imports and duplicates.</span></span></li><li><a href=\"/admin/ai\"><span data-bl-t=\"label\">Media AI</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Captions, indexing and what the model may touch.</span></span></li><li><a href=\"/admin/concierge\"><span data-bl-t=\"label\">Concierge</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Answer traces, grounding failures, security alerts.</span></span></li></ul></section><section aria-labelledby=\"nav-operations\" data-bl-k=\"section\" data-bl-label=\"Operations\"><p id=\"nav-operations\" class=\"con-index__label\" data-bl-b=\"\"><span data-bl-t=\"label\">Operations</span></p><ul class=\"list list--plain con-index__list\"><li><a href=\"/admin/audit\"><span data-bl-t=\"label\">Audit trail</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Every action anyone took, searchable, redacted.</span></span></li><li><a href=\"/admin/jobs\"><span data-bl-t=\"label\">Jobs</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Queue depth, failures and retries.</span></span></li><li><a href=\"/admin/metrics\"><span data-bl-t=\"label\">Metrics</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">What this deployment recorded, and whether it is recording.</span></span></li><li><a href=\"/admin/providers\"><span data-bl-t=\"label\">Providers</span></a><span class=\"con-index__blurb\"><span data-bl-t=\"label\">Which adapter each integration resolved to, and what it can do.</span></span></li></ul></section></div></details></nav><main id=\"main\" class=\"ops\" data-bl-k=\"main\" data-bl-label=\"Media queue\"><div class=\"con-head\"><div><h1 class=\"ops-title\"><span data-bl-t=\"heading\">Media queue</span></h1><p class=\"ops-lede\"><span data-bl-t=\"copy\">Everything guests and vendors have added, in the state it is in. Approve to publish; nothing reaches the gallery without a decision here.</span></p></div><div class=\"con-head__actions\"><nav aria-label=\"Media\" class=\"con-subnav\" data-bl-k=\"nav\" data-bl-label=\"Media\"><ul class=\"list list--plain\"><li><a aria-current=\"page\" href=\"/admin/media\"><span data-bl-t=\"label\">Queue</span></a></li><li><a href=\"/admin/media/duplicates\"><span data-bl-t=\"label\">Duplicates</span></a></li><li><a href=\"/admin/media/import\"><span data-bl-t=\"label\">Import professional media</span></a></li><li><a href=\"/admin/media/metrics\"><span data-bl-t=\"label\">Storage and cost</span></a></li></ul></nav></div></div><section id=\"queue\" class=\"ops-section\" data-bl-k=\"section\"><div><div class=\"media-filters\"><label class=\"media-field\"><span><span data-bl-t=\"label\">State</span></span><select data-bl-s=\"\" data-bl-b=\"\"><option value=\"quarantined\">quarantined</option><option value=\"validating\">validating</option><option value=\"processing\">processing</option><option value=\"private\" selected=\"\">private</option><option value=\"published\">published</option><option value=\"hidden\">hidden</option><option value=\"rejected\">rejected</option><option value=\"failed\">failed</option><option value=\"deleted\">deleted</option></select></label><label class=\"media-field\"><span><span data-bl-t=\"label\">Album</span></span><select data-bl-s=\"\" data-bl-b=\"\"><option value=\"\" selected=\"\">All albums</option><option value=\"engagement\">Engagement</option><option value=\"guest-uploads\">From our guests</option><option value=\"full-ceremony\">Full Ceremony</option><option value=\"toasts\">Toasts</option><option value=\"first-dances\">First Dances</option><option value=\"guest-videos\">Guest Videos</option><option value=\"professional-films\">Professional Films</option><option value=\"raw-archive\">Raw / Archive</option></select></label><label class=\"media-field\"><span><span data-bl-t=\"label\">Kind</span></span><select data-bl-s=\"\" data-bl-b=\"\"><option value=\"\" selected=\"\">Photos and videos</option><option value=\"image\">Photos</option><option value=\"video\">Videos</option></select></label><label class=\"media-field\"><span><span data-bl-t=\"label\">Reason (optional, logged)</span></span><input maxlength=\"500\" value=\"\" data-bl-s=\"\" data-bl-b=\"\"></label></div><div class=\"media-bulk\" role=\"toolbar\" aria-label=\"Bulk actions\" data-bl-s=\"\" data-bl-b=\"\"><label class=\"media-actions\"><input type=\"checkbox\" aria-label=\"Select all\"><span><span data-bl-t=\"label\">0</span><!-- --><span data-bl-t=\"label\"> selected</span></span></label><button type=\"button\" class=\"media-button \" disabled=\"\" data-action=\"approve\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">Approve and publish</span></button><button type=\"button\" class=\"media-button media-button--danger\" disabled=\"\" data-action=\"reject\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">Reject</span></button><button type=\"button\" class=\"media-button media-button--secondary\" disabled=\"\" data-action=\"hide\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">Hide</span></button><button type=\"button\" class=\"media-button media-button--secondary\" disabled=\"\" data-action=\"unhide\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">Unhide</span></button><button type=\"button\" class=\"media-button media-button--secondary\" disabled=\"\" data-action=\"report\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">Flag for follow-up</span></button><button type=\"button\" class=\"media-button media-button--secondary\" disabled=\"\" data-action=\"reprocess\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">Reprocess</span></button><button type=\"button\" class=\"media-button media-button--danger\" disabled=\"\" data-action=\"delete\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">Delete</span></button></div><div class=\"media-empty\" role=\"status\"><p><span data-bl-t=\"copy\">Nothing </span><!-- --><span data-bl-t=\"copy\">awaiting review</span><!-- --><span data-bl-t=\"copy\"> right now.</span></p></div></div></section></main><!--$--><!--/$--></div>"
