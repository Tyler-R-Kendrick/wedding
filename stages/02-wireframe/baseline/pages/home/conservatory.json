 "body": "<div hidden=\"\"><!--$--><!--/$--></div><p id=\"design-announcer\" class=\"sr-only\" aria-live=\"polite\" aria-atomic=\"true\"></p><div class=\"site cv\" data-theme=\"conservatory\" data-floating-menu=\"\" data-lifecycle=\"TEASER\" data-bl-s=\"\"><a class=\"skip-link\" href=\"#main\" data-bl-s=\"\" data-bl-dark=\"\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><div class=\"cv-sheet\"><header class=\"cv-header\" data-bl-k=\"header\" data-bl-label=\"Menu\"><nav class=\"cv-rail\" aria-label=\"Site\" data-bl-k=\"nav\" data-bl-label=\"Site\"><a class=\"cv-rail__home\" href=\"/\" aria-current=\"page\"><span class=\"cv-rail__names\"><span data-bl-t=\"label\">Sara + Tyler</span></span><span class=\"sr-only\"><span data-bl-t=\"label\">: </span><!-- --><span data-bl-t=\"label\">Home</span></span></a><ul class=\"cv-rail__list\" data-bl-b=\"\"><li><a class=\"cv-tag\" href=\"/our-story\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Our Story</span></span></a></li><li><a class=\"cv-tag\" href=\"/our-adventures\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Our Adventures</span></span></a></li><li><a class=\"cv-tag\" href=\"/sign-in\" data-bl-s=\"\"><span data-bl-t=\"label\">Sign in</span></a></li></ul></nav><div class=\"cv-menu\" data-bl-s=\"\"><button type=\"button\" class=\"cv-tag cv-tag--button\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-controls=\"site-menu\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Menu</span></span></button><dialog id=\"site-menu\" class=\"cv-dialog\" aria-labelledby=\"_R_4r5et9esnelb_\" data-bl-k=\"dialog\" data-bl-label=\"Menu\"><div class=\"cv-dialog__panel\" data-bl-s=\"\"><div class=\"cv-dialog__header\"><h2 id=\"_R_4r5et9esnelb_\" class=\"cv-dialog__title\"><span data-bl-t=\"heading\">Menu</span></h2><button type=\"button\" class=\"cv-btn cv-btn--ghost cv-dialog__close\" data-bl-s=\"\" data-bl-b=\"\"><span data-bl-t=\"label\">Close</span></button></div><div class=\"cv-dialog__body\"><ul class=\"cv-menu__list\"><li><a class=\"cv-menu__link is-current\" href=\"/\" aria-current=\"page\" data-bl-s=\"\" data-bl-dark=\"\"><span><span data-bl-t=\"label\">Home</span></span></a></li><li><a class=\"cv-menu__link\" href=\"/our-story\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Our Story</span></span></a></li><li><a class=\"cv-menu__link\" href=\"/our-adventures\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Our Adventures</span></span></a></li><li><a class=\"cv-menu__link\" href=\"/sign-in\" data-bl-s=\"\"><span data-bl-t=\"label\">Sign in</span></a></li></ul></div></div></dialog></div></header><main id=\"main\" class=\"cv-main\" tabindex=\"-1\" data-bl-k=\"main\" data-bl-label=\"Sara + Tyler\"><section class=\"cv-hero\" aria-labelledby=\"hero-title\" data-bl-k=\"section\" data-bl-label=\"Sara + Tyler\"><div class=\"cv-hero__names\"><h1 id=\"hero-title\" class=\"cv-hero__title\"><span data-bl-t=\"heading\">Sara</span><span class=\"sr-only\"><span data-bl-t=\"heading\"> + </span></span><svg class=\"cv-plus\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M12 4v16M4 12h16\" fill=\"none\" stroke=\"var(--color-tertiary)\" stroke-width=\"3\" stroke-linecap=\"round\"></path></svg><span data-bl-t=\"heading\">Tyler</span></h1><p class=\"cv-hero__status\"><span data-bl-t=\"copy\">We are getting married</span><!-- --><span data-bl-t=\"copy\">.</span></p></div><div class=\"cv-hero__rest\"><p class=\"cv-hero__lede\"><span><span data-bl-t=\"copy\">Welcome to our wedding website. If you are one of our guests, sign in to reserve your room and start planning your trip.</span></span></p><div class=\"cv-hero__actions\"><a class=\"cv-btn cv-btn--primary\" href=\"/sign-in\" data-bl-s=\"\" data-bl-dark=\"\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Book your hotel room</span></span></a><a class=\"cv-btn cv-btn--ghost\" href=\"/our-story\" data-bl-s=\"\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Our Story</span></span></a></div></div></section><section id=\"welcome\" class=\"cv-section cv-section--default\" aria-labelledby=\"welcome-title\" data-bl-k=\"section\" data-bl-label=\"Rooted in love. Surrounded by peace. Filled with\"><hr class=\"cv-fern\" data-bl-s=\"\"><div class=\"cv-section__grid\"><div class=\"cv-section__head\"><h2 id=\"welcome-title\" class=\"cv-h cv-h--2\"><span data-bl-t=\"heading\">Rooted in love. Surrounded by peace. Filled with happiness.</span></h2></div><div class=\"cv-prose\"><p><span data-bl-t=\"copy\">We’re so happy you’re here! We believe life’s greatest joys are found in the people we love, the moments we share, and the memories we make along the way.</span></p><p><span data-bl-t=\"copy\">We hope our wedding is a reflection of these things and a chance to slow down, be present, and celebrate the happiness that comes from being together. We’re so grateful to have you in our lives.</span></p><p><span data-bl-t=\"copy\">With love,</span><br><span data-bl-t=\"copy\">Sara &amp; Tyler</span></p><p><a class=\"cv-btn cv-btn--secondary\" href=\"/sign-in\" data-bl-s=\"\" data-bl-b=\"\"><span><span data-bl-t=\"copy\">Sign in for your guest experience</span></span></a></p></div></div></section><section id=\"our-story\" class=\"cv-section cv-section--default\" aria-labelledby=\"our-story-title\" data-bl-k=\"section\" data-bl-label=\"How we met\"><hr class=\"cv-fern\" data-bl-s=\"\"><div class=\"cv-section__grid\"><div class=\"cv-section__text\"><div class=\"cv-section__head\"><h2 id=\"our-story-title\" class=\"cv-h cv-h--2\"><span data-bl-t=\"heading\">How we met</span></h2></div><div class=\"cv-prose cv-prose--lead\"><p><span><span data-bl-t=\"copy\">We met at a friend’s wedding, where an evening of talking and playing games led to Tyler asking Sara out. A new chapter began.</span></span></p></div></div><p class=\"cv-section__hang\"><a class=\"cv-tag cv-tag--hang\" href=\"/our-story\" data-bl-s=\"\"><span><span data-bl-t=\"copy\">Our Story</span></span></a></p></div></section><section id=\"adventures\" class=\"cv-section cv-section--alt\" aria-labelledby=\"adventures-title\" data-bl-s=\"\" data-bl-k=\"section\" data-bl-label=\"Our adventures\"><hr class=\"cv-fern\" data-bl-s=\"\"><div class=\"cv-section__grid\"><div class=\"cv-section__text\"><div class=\"cv-section__head\"><h2 id=\"adventures-title\" class=\"cv-h cv-h--2\"><span data-bl-t=\"heading\">Our adventures</span></h2></div><div class=\"cv-prose\"><p><span><span data-bl-t=\"copy\">The places we have been together, each with what Sara remembers and what Tyler remembers.</span></span></p></div></div><p class=\"cv-section__hang\"><a class=\"cv-tag cv-tag--hang\" href=\"/our-adventures\" data-bl-s=\"\"><span><span data-bl-t=\"copy\">Our Adventures</span></span></a></p></div></section><section id=\"guests\" class=\"cv-section cv-section--default\" aria-labelledby=\"guests-title\" data-bl-k=\"section\" data-bl-label=\"Everything for the weekend is inside\"><hr class=\"cv-fern\" data-bl-s=\"\"><div class=\"cv-section__grid\"><div class=\"cv-section__text\"><div class=\"cv-section__head\"><h2 id=\"guests-title\" class=\"cv-h cv-h--2\"><span data-bl-t=\"heading\">Everything for the weekend is inside</span></h2></div><div class=\"cv-prose\"><p><span><span data-bl-t=\"copy\">Sign in with the email or mobile number we have for you. No password: we send a six-digit code. Inside is the date, the place, and what to do next.</span></span></p></div></div><p class=\"cv-section__hang\"><a class=\"cv-tag cv-tag--hang\" href=\"/sign-in\" data-bl-s=\"\"><span><span data-bl-t=\"copy\">Book your hotel room</span></span></a></p></div></section></main></div><footer class=\"cv-footer\" data-bl-s=\"\" data-bl-k=\"footer\"><div class=\"cv-footer__inner\"><p class=\"cv-footer__names\"><span data-bl-t=\"copy\">Sara + Tyler</span></p><p class=\"cv-footer__signin\"><a class=\"cv-link cv-link--standalone\" href=\"/sign-in\"><span data-bl-t=\"copy\">Sign in</span></a></p><p class=\"c