 "body": "<div hidden=\"\"><!--$--><!--/$--></div><p id=\"design-announcer\" class=\"sr-only\" aria-live=\"polite\" aria-atomic=\"true\"></p><div class=\"site gh\" data-theme=\"gilded-hour\" data-bottom-bar=\"\" data-lifecycle=\"TEASER\" data-bl-s=\"\" data-bl-b=\"\"><a class=\"skip-link\" href=\"#main\" data-bl-s=\"\" data-bl-dark=\"\" target=\"_self\"><span data-bl-t=\"label\">Skip to content</span></a><header class=\"gh-header\" data-bl-b=\"\" data-bl-k=\"header\" data-bl-label=\"Menu\"><nav class=\"gh-frieze\" aria-label=\"Site\" data-bl-k=\"nav\" data-bl-label=\"Site\"><ul class=\"gh-frieze__side gh-frieze__side--left\" data-fit-row=\"\"><li><a class=\"gh-nav__link\" href=\"/our-story\"><span><span data-bl-t=\"label\">Our Story</span></span></a></li><li><a class=\"gh-nav__link\" href=\"/our-adventures\"><span><span data-bl-t=\"label\">Our Adventures</span></span></a></li></ul><a class=\"gh-plaque-link\" href=\"/\" aria-current=\"page\"><span class=\"gh-plaque gh-plaque--mono\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">S+T</span></span><span class=\"sr-only\"><span data-bl-t=\"label\">Sara + Tyler</span><!-- --><span data-bl-t=\"label\">: </span><!-- --><span data-bl-t=\"label\">Home</span></span></a><ul class=\"gh-frieze__side gh-frieze__side--right\" data-fit-row=\"\"><li><a class=\"gh-nav__link\" href=\"/sign-in\"><span data-bl-t=\"label\">Sign in</span></a></li></ul><div class=\"gh-frieze__menu\"><button type=\"button\" class=\"gh-nav__menu\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-controls=\"site-menu\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg><span><span data-bl-t=\"label\">Menu</span></span></button><dialog id=\"site-menu\" class=\"gh-dialog\" aria-labelledby=\"_R_4d5et9esnelb_\" data-bl-k=\"dialog\" data-bl-label=\"Menu\"><div class=\"gh-dialog__panel\" data-bl-s=\"\"><div class=\"gh-dialog__header\" data-bl-b=\"\"><h2 id=\"_R_4d5et9esnelb_\" class=\"gh-dialog__title\"><span data-bl-t=\"heading\">Menu</span></h2><button type=\"button\" class=\"gh-btn gh-btn--ghost gh-dialog__close\" data-bl-s=\"\"><span data-bl-t=\"label\">Close</span></button></div><div class=\"gh-dialog__body\"><ul class=\"gh-menu\"><li><a class=\"gh-menu__link\" href=\"/\" aria-current=\"page\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Home</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/our-story\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Our Story</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/our-adventures\" data-bl-b=\"\"><span><span data-bl-t=\"label\">Our Adventures</span></span></a></li><li><a class=\"gh-menu__link\" href=\"/sign-in\" data-bl-b=\"\"><span data-bl-t=\"label\">Sign in</span></a></li></ul></div></div></dialog></div><span hidden=\"\" data-nav-fit=\"whole\"></span></nav></header><main id=\"main\" class=\"gh-main\" tabindex=\"-1\" data-bl-k=\"main\" data-bl-label=\"Sara + Tyler\"><section class=\"gh-hero\" aria-labelledby=\"hero-title\" data-bl-k=\"section\" data-bl-label=\"Sara + Tyler\"><div class=\"gh-hero__curtain\" aria-hidden=\"true\" data-bl-s=\"\"></div><div class=\"gh-hero__sunburst\" aria-hidden=\"true\" data-bl-s=\"\"></div><div class=\"gh-hero__inner\"><h1 id=\"hero-title\" class=\"gh-hero__title\"><span data-bl-t=\"heading\">Sara + Tyler</span></h1><p class=\"gh-hero__status\"><span data-bl-t=\"copy\">We are getting married</span><!-- --><span data-bl-t=\"copy\">.</span></p><p class=\"gh-hero__lede\"><span><span data-bl-t=\"copy\">Welcome to our wedding website. If you are one of our guests, sign in to reserve your room and start planning your trip.</span></span></p><div class=\"gh-hero__actions\"><a class=\"gh-btn gh-btn--primary\" href=\"/sign-in\" data-bl-s=\"\" data-bl-dark=\"\"><span><span data-bl-t=\"label\">Book your hotel room</span></span></a><a class=\"gh-btn gh-btn--ghost\" href=\"/our-story\" data-bl-s=\"\"><span><span data-bl-t=\"label\">Our Story</span></span></a></div></div></section><section id=\"welcome\" class=\"gh-section gh-section--default\" aria-labelledby=\"welcome-title\" data-bl-k=\"section\" data-bl-label=\"Rooted in love. Surrounded by peace. Filled with\"><div class=\"gh-section__inner\"><div class=\"gh-section__head\"><hr class=\"gh-divider\" data-bl-s=\"\"><h2 id=\"welcome-title\" class=\"gh-h gh-h--2\"><span data-bl-t=\"heading\">Rooted in love. Surrounded by peace. Filled with happiness.</span></h2></div><div class=\"gh-prose\"><p><span data-bl-t=\"copy\">We’re so happy you’re here! We believe life’s greatest joys are found in the people we love, the moments we share, and the memories we make along the way.</span></p><p><span data-bl-t=\"copy\">We hope our wedding is a reflection of these things and a chance to slow down, be present, and celebrate the happiness that comes from being together. We’re so grateful to have you in our lives.</span></p><p><span data-bl-t=\"copy\">With love,</span><br><span data-bl-t=\"copy\">Sara &amp; Tyler</span></p><p><a class=\"gh-btn gh-btn--secondary\" href=\"/sign-in\" data-bl-s=\"\"><span><span data-bl-t=\"copy\">Sign in for your guest experience</span></span></a></p></div></div></section><section id=\"our-story\" class=\"gh-section gh-section--default\" aria-labelledby=\"our-story-title\" data-number=\"1\" data-bl-k=\"section\" data-bl-label=\"How we met\"><div class=\"gh-section__inner\"><span class=\"gh-plaque gh-plaque--act\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">01</span></span><span class=\"sr-only\"><span data-bl-t=\"copy\">Part </span><!-- --><span data-bl-t=\"copy\">1</span><!-- --><span data-bl-t=\"copy\">.</span></span><div class=\"gh-section__head\"><p class=\"gh-eyebrow\"><span data-bl-t=\"copy\">Memory</span></p><hr class=\"gh-divider\" data-bl-s=\"\"><h2 id=\"our-story-title\" class=\"gh-h gh-h--2\"><span data-bl-t=\"heading\">How we met</span></h2></div><div class=\"gh-prose\"><p><span><span data-bl-t=\"copy\">We met at a friend’s wedding, where an evening of talking and playing games led to Tyler asking Sara out. A new chapter began.</span></span></p></div><p class=\"gh-section__action\"><a class=\"gh-btn gh-btn--secondary\" href=\"/our-story\" data-bl-s=\"\"><span><span data-bl-t=\"copy\">Our Story</span></span></a></p></div></section><section id=\"adventures\" class=\"gh-section gh-section--alt\" aria-labelledby=\"adventures-title\" data-number=\"2\" data-bl-s=\"\" data-bl-k=\"section\" data-bl-label=\"Our adventures\"><div class=\"gh-section__inner\"><span class=\"gh-plaque gh-plaque--act\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">02</span></span><span class=\"sr-only\"><span data-bl-t=\"copy\">Part </span><!-- --><span data-bl-t=\"copy\">2</span><!-- --><span data-bl-t=\"copy\">.</span></span><div class=\"gh-section__head\"><p class=\"gh-eyebrow\"><span data-bl-t=\"copy\">Adventure</span></p><hr class=\"gh-divider\" data-bl-s=\"\"><h2 id=\"adventures-title\" class=\"gh-h gh-h--2\"><span data-bl-t=\"heading\">Our adventures</span></h2></div><div class=\"gh-prose\"><p><span><span data-bl-t=\"copy\">The places we have been together, each with what Sara remembers and what Tyler remembers.</span></span></p></div><p class=\"gh-section__action\"><a class=\"gh-btn gh-btn--secondary\" href=\"/our-adventures\" data-bl-s=\"\"><span><span data-bl-t=\"copy\">Our Adventures</span></span></a></p></div></section><section id=\"guests\" class=\"gh-section gh-section--default\" aria-labelledby=\"guests-title\" data-number=\"3\" data-bl-k=\"section\" data-bl-label=\"Everything for the weekend is inside\"><div class=\"gh-section__inner\"><span class=\"gh-plaque gh-plaque--act\" aria-hidden=\"true\" data-bl-s=\"\"><span data-bl-t=\"label\">03</span></span><span class=\"sr-only\"><span data-bl-t=\"copy\">Part </span><!-- --><span data-bl-t=\"copy\">3</span><!-- --><span data-bl-t=\"copy\">.</span></span><div class=\"gh-section__head\"><p class=\"gh-eyebrow\"><span data-bl-t=\"copy\">Invited guests</span></p><hr class=\"gh-divider\" data-bl-s=\"\"><h2 id=\"guests-title\" class=\"gh-h gh-h--2\"><span data-bl-t=\"heading\">Everything for the weekend is inside</span></h2></div><div class=\"gh-prose\"><p><span><span data-bl-t=\"copy\">Sign in with the email or mobile number we have for you. No password: we send a six-digit code. Inside is the date, the place, and what to do next.</span></span></p></div><p class=\"gh-section__action\"><a class=\"gh-btn gh-btn--primary\" href=\"/sign-in\" data-bl-s=\"\" data-bl-dark=\"\"><span><span data-bl-t=\"copy\">Book your hotel room</span></span></a></p></div></section></main><nav class=\"gh-panel\" aria-label=\"Quick actions\" style=\"--cells:2\" data-bl-s=\"\" data-bl-k=\"nav\" data-bl-label=\"Quick actions\"><a class=\"gh-panel__cell\" href=\"/our-story\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M4 5h7a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2H4zM20 5h-7a2 2 0 0 0-2 2v13a2 2 0 0 1 2-2h7z\"></path></svg><span><span data-bl-t=\"label\">Story</span></span></a><a class=\"gh-panel__cell\" href=\"/our-adventures\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" data-bl-m=\"icon\"><path d=\"M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM15 9l-2 6-4 2 2-6z\"></path></svg><span><span data-bl-t=\"label\">Adventures</span></span></a></nav><footer class=\"gh-footer\" data-bl-b=\"\" data-bl-k=\"footer\"><div class=\"gh-footer__inner\"><p class=\"gh-footer__names\"><span data-bl-t=\"copy\">Sara + Tyler</span></p><p class=\"gh-footer__signin\"><a