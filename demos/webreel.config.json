{
  "$schema": "https://webreel.dev/schema/v1.json",
  "outDir": ".out",
  "baseUrl": "http://localhost:3330",
  "defaultDelay": 700,
  "videos": {
    "home": {
      "url": "/",
      "viewport": { "width": 1440, "height": 900 },
      "waitFor": ".bd-hero",
      "output": "home.mp4",
      "thumbnail": { "time": 1 },
      "steps": [
        { "action": "pause", "ms": 1800, "description": "the hero: portrait, date, place" },
        { "action": "moveTo", "selector": "a.bd-nav__link[href=\"/our-story\"]", "delay": 900 },
        { "action": "scroll", "y": 470, "delay": 1800, "description": "the welcome strip" },
        { "action": "scroll", "y": 360, "delay": 2000, "description": "the band, the day's schedule, the footer" },
        { "action": "moveTo", "text": "Photo credits", "delay": 900 },
        { "action": "scroll", "y": -830, "delay": 1200 },
        { "action": "click", "selector": "a.bd-nav__link[href=\"/our-story\"]", "delay": 1800, "description": "on to Our Story" }
      ]
    },
    "our-story": {
      "url": "/our-story",
      "viewport": { "width": 1440, "height": 900 },
      "waitFor": ".bd-ride[data-mode=\"ride\"]",
      "output": "our-story.mp4",
      "thumbnail": { "time": 6 },
      "steps": [
        { "action": "pause", "ms": 1500 },
        { "action": "scroll", "y": 700, "delay": 1800, "description": "all aboard the Sara + Tyler Line" },
        { "action": "scroll", "y": 330, "delay": 1600, "description": "scroll rides the train to the next memory" },
        { "action": "scroll", "y": 330, "delay": 1600 },
        { "action": "scroll", "y": 330, "delay": 1600, "description": "a transfer changes line with the chapter" },
        { "action": "scroll", "y": 330, "delay": 1600 },
        { "action": "click", "selector": ".bd-ride-map__stop a[href=\"#starved-rock\"]", "delay": 3200, "description": "tap a station on the car card to ride there" },
        { "action": "click", "selector": ".bd-ride__btn--next", "delay": 2600, "description": "or step one stop at a time" },
        { "action": "click", "selector": ".bd-ride-map__stop a[href=\"#the-loop\"]", "delay": 3600, "description": "end of the line: the Loop, 07 · 17 · 27" }
      ]
    },
    "explore-caa": {
      "url": "/explore-caa",
      "viewport": { "width": 1440, "height": 900 },
      "waitFor": ".bd-cityguide",
      "output": "explore-caa.mp4",
      "thumbnail": { "time": 1 },
      "steps": [
        { "action": "pause", "ms": 1500 },
        { "action": "scroll", "y": 500, "delay": 1500, "description": "the venue" },
        { "action": "scroll", "y": 500, "delay": 1200, "description": "our Chicago" },
        { "action": "moveTo", "selector": "[data-place=\"riverwalk\"]", "delay": 1400, "description": "each place lights its pin" },
        { "action": "moveTo", "selector": "[data-place=\"north-pond\"]", "delay": 1400 },
        { "action": "moveTo", "selector": "[data-place=\"lakefront-adler\"]", "delay": 1400 },
        { "action": "click", "selector": ".bd-citymap__choose[data-pin=\"north-pond\"]", "delay": 2000, "description": "and each pin picks its place" },
        { "action": "scroll", "y": 620, "delay": 1600, "description": "the ribbon" },
        { "action": "scroll", "y": 900, "delay": 1600, "description": "the building's history" },
        { "action": "scroll", "y": 1400, "delay": 1800, "description": "what to look for" }
      ]
    },
    "phone": {
      "url": "/",
      "viewport": { "width": 390, "height": 844 },
      "waitFor": ".bd-hero",
      "output": "phone.mp4",
      "thumbnail": { "time": 1 },
      "steps": [
        { "action": "pause", "ms": 1800, "description": "the first screen on a phone" },
        { "action": "scroll", "y": 700, "delay": 1300 },
        { "action": "scroll", "y": 700, "delay": 1300 },
        { "action": "scroll", "y": 700, "delay": 1300 },
        { "action": "scroll", "y": 700, "delay": 1300 },
        { "action": "scroll", "y": 700, "delay": 1300 },
        { "action": "scroll", "y": 700, "delay": 1800, "description": "the footer, above the RSVP bar" }
      ]
    }
  }
}
