# Copy to .env (gitignored) and fill in. Claude Code expands ${VAR} in .mcp.json
# from the shell environment, so export these (or use `direnv` / `dotenv`) before
# launching `claude`.

# fal.ai — generative media API (FLUX, Kling, upscalers, etc.)
# Get a key: https://fal.ai/dashboard/keys
# Used by: .mcp.json "fal-ai" server and @fal-ai/client scripts
FAL_KEY=

# Google Stitch — AI UI generation + DESIGN.md skills (design-md, taste-design, enhance-prompt, site-md)
# Get a key: https://stitch.withgoogle.com → sign in with Google → account settings → API key
# Used by: .mcp.json "stitch" server
STITCH_API_KEY=

# Higgsfield needs NO key. Authenticate once with the CLI (opens a browser):
#   npx higgsfield auth login
# and authorize the MCP server once inside Claude Code with `/mcp` → higgsfield.

# Playwright accessibility tests (tests/a11y.spec.ts) run against this URL and
# skip when it is unset. Set it once the site has a dev server, e.g. http://localhost:4321
BASE_URL=

# Placeholder-asset tooling (optional). Openverse anonymous access works but is
# rate-limited; register at https://api.openverse.org/v1/#tag/auth for higher limits.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Identifies our scripts to Wikimedia/Openverse (no personal data; a project URL is enough)
ASSETS_USER_AGENT=sara-tyler-wedding-site/0.1 (+https://github.com/Tyler-R-Kendrick/wedding)
