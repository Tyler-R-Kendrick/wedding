# Copy to .env (gitignored) and fill in what you need. Every variable below is OPTIONAL
# for local development: with nothing set the app runs on PGlite (./.data/pglite) with
# every provider in mock mode. Malformed values fail fast at boot; names are never
# echoed with their values. Full reference: docs/ops/environment.md
#
# Public (browser-visible) variables are prefixed NEXT_PUBLIC_. Nothing else reaches the client.

# ---------------------------------------------------------------- app / public
# Canonical origin, used to build absolute links (signed dev URLs, share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Default theme id when no preference is stored (design swarm owns the themes).
NEXT_PUBLIC_DEFAULT_THEME=botanical-deco
# Feature flags: FLAG_<NAME>=on|off (server) / NEXT_PUBLIC_FLAG_<NAME> (browser mirror).
# Defaults live in src/contracts/flags.ts. Readiness-gated flags also need the admin readiness switch.
# FLAG_PRO_MEDIA_AI_PROCESSING=off
# FLAG_DESIGN_SWITCHER=off
# FLAG_AI_CONCIERGE=on

# ---------------------------------------------------------------- database
# Postgres connection string. Unset -> PGlite (embedded Postgres) in ./.data/pglite.
DATABASE_URL=
# PGLITE_MEMORY=1 uses an in-memory PGlite (tests do this automatically).
PGLITE_MEMORY=
PGLITE_DATA_DIR=./.data/pglite
# Apply migrations / brief-derived seed on first connection. Default: on outside production.
DB_AUTO_MIGRATE=
DB_AUTO_SEED=

# ---------------------------------------------------------------- security (REQUIRED in production)
# HMAC secret for confirmation tokens (draft -> confirm). >= 16 chars; dev falls back to a default with a warning.
CONFIRMATION_SECRET=
# Bearer token for POST /api/jobs/run (cron). >= 32 chars.
CRON_SECRET=
# HMAC secret for local-fs signed storage URLs (S3 presigns its own). Production requires this or the S3_* set.
STORAGE_SIGNING_SECRET=
# Older name for STORAGE_SIGNING_SECRET, still honoured (STORAGE_SIGNING_SECRET wins when both are set).
DEV_STORAGE_SECRET=
# Reverse proxies to trust for x-forwarded-for (0 = ignore forwarding headers). Default: 1 on Vercel, else 0.
TRUSTED_PROXY_HOPS=
# HMAC key for audit input fingerprints. Unset -> derived from CONFIRMATION_SECRET. >= 16 chars.
AUDIT_HASH_KEY=
# Bearer that unlocks GET/DELETE /api/dev/inbox outside a local dev server (previews). >= 16 chars.
DEV_INBOX_TOKEN=
# Bearer that unlocks the provider inventory on /api/health (admins see it without one). >= 16 chars.
HEALTH_TOKEN=
# Test-only principal injection (x-test-principal + x-test-auth headers). Honoured only when
# NODE_ENV=test, the secret matches in constant time, and neither VERCEL nor CI is set. Never set
# this in a deployment: it is the one variable that can hand a caller somebody else's session.
TEST_AUTH_SECRET=
# Better Auth (auth swarm). >= 16 chars; URL is the public origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Comma-separated administrator emails (role: owner). Additional roles live in the admin_roles table.
ADMIN_EMAILS=

# ---------------------------------------------------------------- observability
# fatal|error|warn|info|debug|trace|silent (default: debug in dev, info in prod, silent in test)
LOG_LEVEL=
# json to disable pretty logs in development
LOG_FORMAT=
# console|db|none (default: console in dev, db in prod, none in test)
METRICS_SINK=

# ---------------------------------------------------------------- providers (all optional; mock when unset)
# Force every provider to its mock even when keys are present.
FORCE_MOCK_PROVIDERS=
# The concierge is written on the guest's own device (Chrome's Prompt API): no key, nothing
# billed, nothing leaves their phone. A browser without it gets an answer quoted from the site's
# own pages. Set to off to quote for everyone. No hosted AI model is ever called — not Anthropic,
# OpenAI or Vercel's AI Gateway — whatever keys are set; embeddings and captions run in-process.
NEXT_PUBLIC_AI_BROWSER_MODEL=
# auth-email: Resend through the attached resend/wedding Vercel Connect connector.
# Authorize this user ID in Connect and verify EMAIL_FROM in Resend. Both required for live mode.
RESEND_CONNECT_USER_ID=
EMAIL_FROM=
# Temporary operator token for completing Connect authorization from a Vercel deployment.
CONNECT_SETUP_TOKEN=
# storage: S3-compatible (R2, Backblaze B2, Supabase Storage, MinIO; an AWS endpoint is refused). S3_ENDPOINT, S3_BUCKET
# and both keys are required for live mode; otherwise local-fs under STORAGE_DATA_DIR.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
STORAGE_DATA_DIR=./.data/storage
# media pipeline: per-file caps and multipart sizing (MiB). S3/R2 need parts >= 5.
MEDIA_MAX_IMAGE_MB=40
MEDIA_MAX_VIDEO_MB=512
MEDIA_PART_SIZE_MB=8
MEDIA_MULTIPART_THRESHOLD_MB=8
# video: ffmpeg binary for posters/probing (unset -> `ffmpeg` on PATH, else mock; `off` -> mock without looking). Cloudflare Stream delivery needs all three.
FFMPEG_PATH=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# flights: mock (default, fixtures) | deep-link (honest unavailable + Skyscanner links) | skyscanner (Live Prices) | duffel-links (hosted checkout)
FLIGHTS_PROVIDER=
# hotels: mock (default) | deep-link (Booking.com + Hyatt links) | booking (Demand API) | duffel-stays
HOTELS_PROVIDER=
# Skyscanner Live Prices partner key (flights=skyscanner). Without it the mode is honest-unavailable with links.
SKYSCANNER_API_KEY=
# Duffel access token (flights=duffel-links, hotels=duffel-stays) and the webhook signing secret (>= 16 chars) for POST /travel/webhooks/duffel.
DUFFEL_API_KEY=
DUFFEL_WEBHOOK_SECRET=
# Booking.com Demand API (hotels=booking): both required.
BOOKING_DEMAND_API_KEY=
BOOKING_AFFILIATE_ID=
# transport-benefit: mock (default) | manual-code | uber (uber adapter belongs to the transport swarm)
TRANSPORT_BENEFIT_MODE=
# Comma-separated codes for manual-code mode in development (production codes live in the database).
TRANSPORT_MANUAL_CODES=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# Uber for Business organisation id and voucher programme id (mode=uber). Base URL only for sandboxes.
UBER_ORG_ID=
UBER_VOUCHER_PROGRAM_ID=
UBER_API_BASE_URL=
# Key material (>= 32 chars) sealing unclaimed ride codes / redemption links at rest. Unset -> derived from CONFIRMATION_SECRET.
TRANSPORT_SECRETS_KEY=
# rate-limit backend: memory | db (default: db in production, memory elsewhere)
RATE_LIMIT_BACKEND=

# ---------------------------------------------------------------- jobs
# How many due jobs one run takes. Runs come from the cron routes on a deployed host
# (vercel.json schedules all three) and from `npm run jobs:run` locally. There is no
# in-process poller: nothing enqueued is processed until one of those two runs.
JOBS_BATCH_SIZE=10
# housekeeping.purge (enqueued by the cron route) keeps metrics rows this many days.
METRICS_RETENTION_DAYS=30

# ---------------------------------------------------------------- design toolchain (unchanged)
# fal.ai generative media (mood boards, textures). https://fal.ai/dashboard/keys
FAL_KEY=
# Google Stitch (design-md, taste-design, enhance-prompt, site-md skills)
STITCH_API_KEY=
# Higgsfield (required, alongside FAL_KEY — Soul keeps one identity across shots, and the video
# models animate them). Deliberately no variable here: the CLI runs its own OAuth and writes a
# credentials file (HIGGSFIELD_CREDENTIALS_PATH), and the skills call `higgsfield account status`.
# Authorize with `npx higgsfield auth login` (check with `npx higgsfield account status`).

# ---------------------------------------------------------------- tests
# Playwright: when set, tests run against this deployed URL instead of starting the local app.
BASE_URL=
# Path to a system Chromium for sandboxes where `playwright install` is unavailable.
PW_CHROMIUM_PATH=
# Command Playwright uses to start the app locally (default: npm run dev; CI uses npm run start).
PW_WEB_SERVER_COMMAND=
# Dev/e2e only: cookie-driven test principals (guest/admin) until the identity swarm's resolver is wired. Refused in production.
# Placeholder-asset tooling (optional). Openverse anonymous access works but is
# rate-limited; register at https://api.openverse.org/v1/#tag/auth for higher limits.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Identifies our scripts to Wikimedia/Openverse (no personal data; a project URL is enough)
ASSETS_USER_AGENT=sara-tyler-wedding-site/0.1 (+https://github.com/Tyler-R-Kendrick/wedding)
