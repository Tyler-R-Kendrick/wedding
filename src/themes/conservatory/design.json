      "description": "17px so iOS never zooms; label above, error in words.",
      "html": "<label class=\"ds-label\" for=\"n\">Your name</label><input class=\"ds-input\" id=\"n\" type=\"text\" autocomplete=\"name\"><p class=\"ds-error\">Enter the name on your invitation.</p>",
      "css": ".ds-label{display:block;font:500 1rem/1 Spectral,Georgia,serif;color:var(--color-primary,#2A4430);margin-bottom:8px}.ds-input{display:block;width:100%;max-width:24rem;background:var(--color-surface,#FBF8F1);color:var(--color-on-surface,#2A4430);font:400 1.0625rem/1.4 Spectral,Georgia,serif;padding:12px 14px;border:1px solid var(--color-outline,#C8C1AC);border-radius:2px;min-height:44px}.ds-input:hover{border-color:var(--color-secondary,#4F6338)}.ds-input:focus-visible{outline:2px solid var(--color-secondary,#4F6338);outline-offset:2px}.ds-input[aria-invalid=true]{border-color:var(--color-error,#8B3A2B)}.ds-input:disabled{background:var(--color-neutral-variant,#EAE2CE);color:var(--color-on-surface-muted,#4F5A48)}.ds-error{font:400 .9375rem/1.55 Spectral,Georgia,serif;color:var(--color-error,#8B3A2B);margin:8px 0 0}"
