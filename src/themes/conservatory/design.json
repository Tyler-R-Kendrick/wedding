      "css": ".ds-pressed{position:relative;background:var(--color-surface,#FBF8F1);color:var(--color-on-surface,#2A4430);padding:24px;box-shadow:0 1px 0 rgba(42,68,48,.06),0 12px 32px -20px rgba(42,68,48,.35);transform:rotate(-1.2deg);max-width:22rem}.ds-pressed__title{font:400 1.625rem/1.2 Gloock,Georgia,serif;margin:12px 0 8px}.ds-pressed__body{font:400 1.0625rem/1.65 Spectral,Georgia,serif;margin:0}.ds-specimen{position:absolute;top:-10px;right:12px;background:var(--color-kraft,#E4D6BA);color:var(--color-soil,#6E5637);font:italic 400 1rem/1.4 Cardo,\"Times New Roman\",serif;padding:6px 10px;border-bottom:2px solid var(--color-kraft-deep,#C9B48C);transform:rotate(4deg)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
