  "narrative": {
    "northStar": "The Herbarium Sheet",
    "overview": "A glasshouse in July: creme paper, a light-blue wash where the sky shows through the glazing, moss and leaf greens doing the work of ink, and one thread of pollen gold. Every page is laid out like a pressed specimen: the sheet is the page, the plant sits off-centre with room to breathe, a kraft label in italic names it, and a second sheet may overlap the first. Nothing is centred by default; things are placed.\n\nIt is Sara's taste (flowers, plants, foliage) with Tyler's moss, and the deliberate opposite of Gilded Hour: left-weighted, hand-set, layered and green where that one is symmetrical, monumental, stepped and gold.",
    "keyCharacteristics": [
      "Paper ground; sky, moss and parchment washes mark section changes; no gradients",
      "Moss ink for all text; pale greens and blues are fills only",
      "Gloock display, Spectral text with real small caps, Cardo italic only on specimen labels",
      "Overlapping, slightly rotated pressed cards with kraft tags",
      "In-repo botanical line art: leaf border, fern divider, moss cluster, tendril corner, pressed flowers"
    ],
    "rules": [
      {
        "name": "The Wash Rule",
        "body": "Light blue and pale green are washes, never inks. Text on a wash is primary or sky-ink.",
        "section": "colors"
      },
      {
        "name": "The Pollen Rule",
        "body": "Pollen appears at most twice per viewport: the RSVP action and one thread or knot. More than that is gilding, which is the other theme.",
        "section": "colors"
      },
      {
        "name": "The Placement Rule",
        "body": "Nothing is centred by default. Names, titles and prose are left-weighted; cards and tags hang in the right-hand mounting area; at most two elements on any screen share a centred axis.",
        "section": "layout"
      },
      {
        "name": "The Two-Slot Rule",
        "body": "Cardo italic lives in two slots only: specimen labels and tag place/date lines. Headings are always roman.",
        "section": "typography"
      },
      {
        "name": "The Settle Rule",
        "body": "Motion is a leaf settling: ease-out, 700ms or less, one orchestrated arrival per page, nothing that loops. Reduced motion renders everything at rest.",
        "section": "motion"
      }
    ],
    "dos": [
      "Place things; let sheets overlap and tags hang",
      "Keep pale green and light blue as washes",
      "Generate ornament from scripts/art/conservatory.mjs",
      "Keep every label visible and every error in words",
      "Use TODO(Tyler & Sara) placeholders, never plausible fiction"
    ],
    "donts": [
      "No centred script on blush, watercolor corners, pastel-pink gradients",
      "No gold leaf, sunbursts, chevrons or stepped frames (Gilded Hour vocabulary)",
      "No italic headings, no all-caps chrome, no eyebrow on every section",
      "No bounce, no scroll-jacking, no leaves that never stop falling",
      "No text on leaf, sky, kraft or moss-wash except primary, sky-ink or soil"
    ]
  }
