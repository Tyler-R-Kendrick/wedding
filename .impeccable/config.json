{
  "hook": {
    "enabled": true,
    "limits": {
      "maxFindings": 5,
      "maxChars": 8000
    }
  },
  "buildPath": "comp",
  "detector": {
    "ignoreRules": [],
    "ignoreFiles": [
      "node_modules/**",
      "dist/**",
      ".impeccable/**",
      "docs/**",
      ".claude/**",
      "scripts/**",
      "tests/**",
      ".next/**",
      "src/db/migrations/**",
      ".data/**",
      "coverage/**"
    ],
    "ignoreValues": []
  }
}
