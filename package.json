{
  "name": "wedding",
  "version": "0.1.0",
  "private": true,
  "description": "Tyler & Sara's wedding website \u2014 design tooling, skills, and quality gates",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit --project ui",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test tests/e2e",
    "evals": "vitest run --project evals",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import tsx src/db/migrate.ts",
    "db:seed": "node --conditions=react-server --import tsx src/db/seed/seed.ts",
    "jobs:run": "node --conditions=react-server --import tsx src/lib/jobs/cli.ts",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "verify": "npm run check && npm run lint:css && npm run design:lint && npm run slop:detect && npm run test:integration && npm run build",
    "design:lint": "for f in DESIGN.md $(ls src/themes/*/DESIGN.md 2>/dev/null); do echo \"== $f\"; design.md lint \"$f\" || exit 1; done",
    "design:lint:json": "design.md lint --format json DESIGN.md",
    "design:spec": "design.md spec --rules",
    "design:export:tailwind": "design.md export --format css-tailwind DESIGN.md",
    "design:export:dtcg": "design.md export --format dtcg DESIGN.md",
    "design:export:css": "design.md export --format css-vars DESIGN.md",
    "design:diff": "design.md diff",
    "slop:detect": "impeccable detect .",
    "slop:detect:json": "impeccable detect --json .",
    "slop:ignores": "impeccable ignores list",
    "skills:list": "skills list -a claude-code",
    "skills:update": "skills update -p -y",
    "impeccable:update": "impeccable update --project --providers=claude -y",
    "lint:css": "stylelint \"src/**/*.{css,scss}\" --allow-empty-input",
    "quality": "npm run design:lint && npm run slop:detect && npm run lint:css && npm run -s assets:check",
    "assets:fal": "node scripts/fal-generate.mjs",
    "assets:check": "NODE_USE_ENV_PROXY=1 node scripts/fetch-commons.mjs --check",
    "assets:fetch": "NODE_USE_ENV_PROXY=1 node scripts/fetch-commons.mjs",
    "art:generate": "node scripts/generate-art.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fal-ai/client": "^1.10.1",
    "@google/design.md": "^0.4.0",
    "@higgsfield/cli": "^1.1.24",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "impeccable": "^4.0.0",
    "jsdom": "^30.0.1",
    "pino-pretty": "^13.1.3",
    "skills": "^1.5.23",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/openai": "^4.0.59",
    "@ai-sdk/voyage": "^2.0.36",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@better-auth/passkey": "^1.7.2",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@tailwindcss/postcss": "^4.3.3",
    "ai": "^7.0.93",
    "better-auth": "^1.7.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "file-type": "^22.0.2",
    "heic-convert": "^2.1.0",
    "next": "^16.3.4",
    "pino": "^10.3.1",
    "postcss": "^8.5.28",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  }
}
