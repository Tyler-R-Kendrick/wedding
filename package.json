{
  "name": "wedding",
  "version": "0.1.0",
  "private": true,
  "description": "Tyler & Sara's wedding website \u2014 design tooling, skills, and quality gates",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "stages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "node scripts/install-git-hooks.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit --project ui --project \"stage:*\"",
    "test:integration": "vitest run --project integration",
    "test:evals": "vitest run --project evals",
    "test:e2e": "playwright test tests/e2e",
    "test:security": "playwright test tests/security",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import tsx src/db/migrate.ts",
    "db:seed": "node --conditions=react-server --import tsx src/db/seed/seed.ts",
    "jobs:run": "node --conditions=react-server --import tsx src/lib/jobs/cli.ts",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "verify": "npm run check && npm run lint:css && npm run -s targets:check && npm run design:lint && npm run design:sync:check && npm run docs:check && npm run -s design:drift && npm run test:integration && npm run test:evals && npm run build",
    "design:lint": "for f in DESIGN.md $(ls src/themes/*/DESIGN.md 2>/dev/null); do echo \"== $f\"; design.md lint \"$f\" || exit 1; done",
    "design:lint:json": "design.md lint --format json DESIGN.md",
    "design:spec": "design.md spec --rules",
    "design:export:tailwind": "design.md export --format css-tailwind DESIGN.md",
    "design:export:dtcg": "design.md export --format dtcg DESIGN.md",
    "design:export:css": "design.md export --format css-vars DESIGN.md",
    "demos:record": "node scripts/demos/record.mjs",
    "design:diff": "design.md diff",
    "slop:detect": "impeccable detect .",
    "slop:detect:json": "impeccable detect --json .",
    "slop:detect:rendered": "node --import tsx scripts/detect-rendered.mjs",
    "design:drift": "node scripts/check-design-drift.mjs",
    "slop:ignores": "impeccable ignores list",
    "skills:list": "skills list -a claude-code",
    "skills:update": "skills update -p -y",
    "impeccable:update": "impeccable update --project --providers=claude -y",
    "targets:check": "node scripts/check-standalone-links.mjs",
    "lint:css": "stylelint \"src/**/*.{css,scss}\" \"stages/*/{app,lib}/**/*.css\" --ignore-pattern \"stages/04-placeholder/app/themes/**\" --allow-empty-input",
    "quality": "npm run design:lint && npm run -s design:drift && npm run lint:css && npm run -s targets:check && npm run docs:check && npm run -s assets:check && npm run -s secrets:coverage",
    "precommit": "node scripts/precommit.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "deploy:vercel": "node scripts/deploy/vercel.mjs",
    "deploy:vercel:plan": "node scripts/deploy/vercel.mjs --plan",
    "secrets:autofill": "node scripts/secrets/autofill.mjs",
    "secrets:plan": "node scripts/secrets/acquire.mjs plan",
    "secrets:acquire": "NODE_USE_ENV_PROXY=1 node scripts/secrets/acquire.mjs run",
    "secrets:resume": "NODE_USE_ENV_PROXY=1 node scripts/secrets/acquire.mjs resume",
    "secrets:report": "node scripts/secrets/acquire.mjs report",
    "secrets:verify": "NODE_USE_ENV_PROXY=1 node scripts/secrets/verify.mjs",
    "secrets:authmd": "NODE_USE_ENV_PROXY=1 node scripts/secrets/authmd.mjs discover",
    "secrets:page": "node scripts/secrets/build-page.mjs",
    "secrets:probe": "NODE_USE_ENV_PROXY=1 node scripts/secrets/probe-agent-auth.mjs",
    "secrets:harness": "node scripts/secrets/detect-harness.mjs",
    "secrets:serve": "node scripts/secrets/serve.mjs",
    "secrets:verify:page": "node scripts/secrets/page/verify-page.mjs",
    "secrets:coverage": "node --test --experimental-test-coverage --test-coverage-include=scripts/secrets/page/logic.mjs --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 scripts/secrets/page/logic.test.mjs",
    "assets:fal": "node scripts/fal-generate.mjs",
    "assets:check": "NODE_USE_ENV_PROXY=1 node scripts/fetch-commons.mjs --check && node scripts/timeline-media.mjs --check",
    "timeline:import": "node scripts/import-paired.mjs",
    "timeline:media": "node scripts/timeline-media.mjs",
    "assets:fetch": "NODE_USE_ENV_PROXY=1 node scripts/fetch-commons.mjs",
    "art:generate": "node scripts/generate-art.mjs",
    "docs:links": "node scripts/check-doc-links.mjs",
    "docs:env": "node scripts/check-env-example.mjs",
    "docs:activation": "node --conditions=react-server --import tsx scripts/activation-matrix.ts",
    "docs:activation:check": "node --conditions=react-server --import tsx scripts/activation-matrix.ts --check",
    "docs:check": "npm run docs:links && npm run docs:env && npm run docs:activation:check",
    "design:sync": "node scripts/design-sync.mjs",
    "design:sync:check": "node scripts/design-sync.mjs --check",
    "secrets:verify:lifecycle": "node scripts/secrets/page/verify-lifecycle.mjs",
    "secrets:verify:artifact": "node scripts/secrets/page/verify-artifact.mjs",
    "stages:dev": "node scripts/stages/run.mjs dev",
    "stages:build": "node scripts/stages/run.mjs build",
    "stages:test": "vitest run --project \"stage:*\"",
    "stages:typecheck": "node scripts/stages/run.mjs typecheck && tsc -p scripts/stages/tsconfig.json",
    "stages:serve": "node scripts/stages/run.mjs start",
    "dev:sitemap": "npm run dev -w @wedding/sitemap",
    "dev:wireframe": "npm run dev -w @wedding/wireframe",
    "dev:skeleton": "npm run dev -w @wedding/skeleton",
    "dev:placeholder": "npm run dev -w @wedding/placeholder",
    "stages:assemble": "node scripts/stages/assemble.mjs",
    "stages:signoff": "node --import tsx scripts/stages/signoff.ts",
    "stages:probe": "node scripts/stages/probe.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fal-ai/client": "^1.10.1",
    "@google/design.md": "^0.4.0",
    "@higgsfield/cli": "^1.1.24",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "impeccable": "^4.1.0",
    "jsdom": "^30.0.1",
    "pino-pretty": "^13.1.3",
    "skills": "^1.5.23",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vercel": "^59.23.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/openai": "^4.0.59",
    "@ai-sdk/voyage": "^2.0.36",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@better-auth/passkey": "^1.7.2",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@wedding/sitemap": "*",
    "ai": "^7.0.93",
    "better-auth": "^1.7.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "file-type": "^22.0.2",
    "heic-convert": "^2.1.0",
    "next": "^16.3.4",
    "pino": "^10.3.1",
    "postcss": "^8.5.28",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  }
}
